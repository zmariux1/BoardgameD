<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#111718">
  <title>Revizuiește personajul | Dungeons &amp; Dragons</title>
  <link rel="stylesheet" href="/css/dnd/char/builder/piese/asideBar.css">
  <link rel="stylesheet" href="/css/dnd/char/builder/review-character.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">DUNGEONS &amp; DRAGONS</div>
    <div class="account" aria-label="Cont utilizator">
      <span class="account-mark">A</span>
      <span>Adventurer</span>
    </div>
  </header>

  <div class="app-shell">
    <%- include('piese/asideBar') %>

    <main class="main" id="review">
      <div class="page-heading">
        <h1>Revizuiește Detaliile</h1>
        <p>Verifică informațiile alese pentru personajul tău înainte de a finaliza.</p>
      </div>
      <div class="ornament" aria-hidden="true"><span></span></div>

      <section class="review-layout" aria-label="Rezumatul personajului">
        <figure class="portrait-frame">
          <% if (selectedClass) { %>
            <img
              class="class-card__image"
              src="/img/dnd/classes/<%= selectedClass.index %>.png"
              alt="<%= selectedClass.name %>"
            >
          <% } %>
        </figure>

        <div class="details-column">
          <div class="summary-grid">
            <a class="summary-card <%= hasSelectedClass ? '' : 'is-missing' %>" id="class" href="/<%= userId %>/dnd/builder/<%= characterId %>/class/choose">
              <div class="summary-icon" aria-hidden="true">
                <svg viewBox="0 0 80 80" fill="none">
                  <path d="M12 9h56v31c0 17-11 27-28 35C23 67 12 57 12 40V9Z" fill="#98251B" stroke="#742016" stroke-width="2"/>
                  <path d="M40 20c-5 5-7 10-7 17l-7-5-4 9 8 8 3 13h14l3-13 8-8-4-9-7 5c0-7-2-12-7-17Z" fill="#F5E2C1"/>
                  <path d="M40 23v29M33 34l-7 7m21-7 7 7" stroke="#98251B" stroke-width="2.6" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="summary-copy"><h2>Class</h2><p class="summary-value is-underlined"><%= selectedClass ? selectedClass.name : '' %></p></div>
              <span class="status" role="img" aria-label="<%= hasSelectedClass ? 'Completat' : 'Lipsește selecția' %>"><%= hasSelectedClass ? '✓' : '?' %></span>
            </a>

            <a class="summary-card <%= hasSelectedRace ? '' : 'is-missing' %>" id="race" href="/<%= userId %>/dnd/builder/<%= characterId %>/species/choose">
              <div class="summary-icon" aria-hidden="true">
                <svg viewBox="0 0 80 80" fill="#18344A">
                  <path d="M7 10c17 4 27 12 31 27-13-3-23-10-31-27Z"/>
                  <path d="M73 10C56 14 46 22 42 37c13-3 23-10 31-27Z"/>
                  <path d="M15 23c4 21 14 38 25 46 11-8 21-25 25-46-10 8-17 11-25 11S25 31 15 23Z"/>
                  <path d="M28 44c4-4 8-4 12 0-4 5-8 5-12 0Zm24 0c-4-4-8-4-12 0 4 5 8 5 12 0Z" fill="#E9D4AE"/>
                  <path d="M34 60h12l-6 7-6-7Z" fill="#D3B783"/>
                </svg>
              </div>
              <div class="summary-copy"><h2>Race</h2><p class="summary-value is-underlined"><%= selectedSubrace ? selectedSubrace.name : (selectedRace ? selectedRace.name : '') %></p></div>
              <span class="status" role="img" aria-label="<%= hasSelectedRace ? 'Completat' : 'Lipsește selecția' %>"><%= hasSelectedRace ? '✓' : '?' %></span>
            </a>

            <a class="summary-card <%= hasSelectedBackground ? '' : 'is-missing' %>" href="/<%= userId %>/dnd/builder/<%= characterId %>/background">
              <div class="summary-icon" aria-hidden="true">
                <svg viewBox="0 0 80 80" fill="#68752B">
                  <path d="M37 70h7V40h-7z"/>
                  <path d="M39 47 19 31l3-4 20 16 17-17 4 4-18 19v9h-6z"/>
                  <g fill="#68752B">
                    <circle cx="24" cy="22" r="13"/><circle cx="42" cy="17" r="15"/><circle cx="57" cy="25" r="12"/>
                    <circle cx="17" cy="36" r="10"/><circle cx="43" cy="34" r="15"/><circle cx="62" cy="38" r="10"/>
                  </g>
                  <path d="M25 69h31" stroke="#68752B" stroke-width="4" stroke-linecap="round"/>
                </svg>
              </div>
              <div class="summary-copy"><h2>Background</h2><p class="summary-value"><%= selectedBackground ? selectedBackground.name : '' %></p></div>
              <span class="status" role="img" aria-label="<%= hasSelectedBackground ? 'Completat' : 'Lipsește selecția' %>"><%= hasSelectedBackground ? '✓' : '?' %></span>
            </a>

            <a class="summary-card <%= hasSelectedAllStats ? '' : 'is-missing' %>" id="stats" href="/<%= userId %>/dnd/builder/<%= characterId %>/stats">
              <div class="summary-icon" aria-hidden="true">
                <svg viewBox="0 0 80 80" fill="#63304D">
                  <rect x="8" y="45" width="13" height="27" rx="2"/>
                  <rect x="26" y="27" width="13" height="45" rx="2"/>
                  <rect x="44" y="8" width="13" height="64" rx="2"/>
                  <rect x="62" y="37" width="10" height="35" rx="2"/>
                </svg>
              </div>
              <div class="summary-copy"><h2>Stats</h2><p class="summary-value stats"><%= ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'].map((ability) => `${ability} ${abilityStats.AllStats[ability]}`).join(', ') %></p></div>
              <span class="status" role="img" aria-label="<%= hasSelectedAllStats ? 'Completat' : 'Lipsește selecția' %>"><%= hasSelectedAllStats ? '✓' : '?' %></span>
            </a>
          </div>

          <div class="ornament section-rule" aria-hidden="true"><span></span></div>
          <section class="extra-details" aria-label="Alte detalii">
            <article class="detail-row" id="description">
              <div class="detail-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.7" stroke-linejoin="round">
                  <path d="M5 10c7-3 13-1 19 3v29C18 38 12 36 5 39V10Z" fill="#754B35"/>
                  <path d="M43 10c-7-3-13-1-19 3v29c6-4 12-6 19-3V10Z" fill="#754B35"/>
                  <path d="M24 13v29" stroke="#EAD3AE" stroke-width="1.5"/>
                </svg>
              </div>
              <div><h3>Description</h3><p><%= selectedClassDescription %></p></div>
            </article>
            <article class="detail-row" id="class-management">
              <div class="detail-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="#63304D">
                  <path d="m8 7 4-3 29 29-4 4L8 7Zm30-3 4 4-29 29-4-4L38 4Z"/>
                  <path d="m4 5 5-2 5 5-4 4L4 5Zm35 31 4-4 3 5-4 4-3-5Z"/>
                  <path d="m18 15 4-4 4 4-4 4-4-4Zm8 8 4-4 4 4-4 4-4-4Z" fill="#EBD7B9"/>
                </svg>
              </div>
              <div><h3>Proficiencies</h3><p><%= selectedClassProficiencies.join(', ') %></p></div>
            </article>
            <article class="detail-row">
              <div class="detail-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" fill="#63304D">
                  <path d="M24 3 30 8l8 1 1 8 6 7-6 7-1 8-8 1-6 5-6-5-8-1-1-8-6-7 6-7 1-8 8-1 6-5Z"/>
                  <path d="m24 12 3.5 7.2 8 .9-5.8 5.6 1.4 7.9-7.1-3.8-7.1 3.8 1.4-7.9-5.8-5.6 8-.9L24 12Z" fill="#EBD7B9"/>
                </svg>
              </div>
              <div><h3>Class Features</h3><p>Rage, Unarmored Defense, Reckless Attack, Danger Sense.</p></div>
            </article>
          </section>
        </div>
      </section>

      <div class="ornament bottom-ornament" aria-hidden="true"><span></span></div>
      <nav class="actions" aria-label="Acțiuni">
        <!-- <a class="button button-back" href="#stats">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m14.5 5-7 7 7 7M8 12h12"/></svg>
          Înapoi
        </a> -->
        <% if (canViewCharSheet) { %>
          <a class="button button-finish" href="/<%= userId %>/dnd/char/<%= characterId %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m4 12 5 5L20 6"/></svg>
            View Char Sheet
          </a>
        <% } else { %>
          <button class="button button-finish button-finish--disabled" type="button" disabled aria-describedby="missing-choices">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 8v5m0 4h.01M10.3 3.9 1.8 18.6A2 2 0 0 0 3.5 21h17a2 2 0 0 0 1.7-2.4L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
            Alege toate trăsăturile pentru a continua
          </button>
          <p class="missing-choices" id="missing-choices" role="status">Lipsesc una sau mai multe categorii: clasă, rasă, background sau stats.</p>
        <% } %>
      </nav>
    </main>
  </div>
</body>
</html>
