            <!-- searchbar ends  -->
  
  
  
  
  
  
  
  
  
            <!-- the location xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx -->
            <!-- <div class="location-div">
              <div class="location-title-div">
                <h5 class="location-titles">Location: </h5>
              </div> -->
  
              <!-- dropdown start  -->
              <!-- <div id="expend-who2" class="dropdown-who">
                <div id="drop-text2" class="dropdown-text">
                  <span id="span2">Select location..</span>
