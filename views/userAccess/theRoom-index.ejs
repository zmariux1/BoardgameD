                                  <%let truncatedPercentage = Math.floor(percentage / 10); // Remove the last digit%>
                                  
          
                                  <%let majorityThreshold = Math.ceil(totalParticipants / 2); // Calculate majority threshold%>
          
                                  <%let successfulResult = count >= majorityThreshold; // Check if count meets or exceeds the majority threshold%>
          
          
                                  <div class="item_name">
                                    <%
                                      // Define uniqueNames array at the beginning of the template
                                      const uniqueNames = [];
                                    %>
                                    <% if (joinedGuestUsers && joinedGuestUsers.length > 0) { %>
                                      <% joinedGuestUsers.forEach(guestUser => { %>
                                    
                                        <!-- guestUser will access each user -->
                                        <% userPlus_owned_BG.forEach(userPlus => { %>
                                          <!-- guestUser._id will specify for which user the data will be accessed -->
                                          <% if (userPlus.userLink.equals(guestUser._id)) { %>
                                            <!-- this will run through each of the existing bg -->
                                            <% InternalBgData.forEach(boardgame => { %>
                                              <!-- Check for matching InternalBgData.objectid -->
                                              <% InternalBgData.forEach(internalBg => { %>
                                                <% if (boardgame.objectid == internalBg.objectid) { %>
                                                  <!-- Display a list of InternalBgData.name when there's a match -->
                                                  <% if (!uniqueNames.includes(internalBg.name)) { %>
                                                    <!-- find the vote.newValue ojbectID into the current existing list of owned game  -->
                                                    <% if (vote.newValue.toString() == internalBg.objectid.toString()) { %>
                                                      <span class="title"><%= internalBg.name %> (<%= internalBg.yearPublished %>)</span>
                                                    <% } %>
                                                    <% uniqueNames.push(internalBg.name); %>
                                                  <% } %>
                                                <% } %>
                                              <% }) %>
                                    
                                            <% }) %>
                                            
                                            
                                          <% } %>
                                        <% }) %>
                                    
                                      <% }); %>
                                    <% } else { %>
                                      <!-- <p>The platicipants haven't added any owned games in ther lists</p> -->
                                    <% } %>
                                    
                                  </div>
          
          
          
                                </div>
                                <div class="item_voters">
                                  <% if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) { %>
                                    <% joinedGuestUsers.forEach(guestUser => { %>
                                      <% if (Array.isArray(vote.votedBy_ID) && vote.votedBy_ID.includes(guestUser._id.toString())) { %>
                                        <%if (guestUser._id.toString() == user._id.toString()) {%>
                                          <img class="votingImg" title="<%= guestUser.yourName %>" src="/userImages/<%= guestUser.images %>" style="border: 2px solid rgb(84, 84, 134);">
                                        <% } else { %>
                                          <img class="votingImg" title="<%= guestUser.yourName %>" src="/userImages/<%= guestUser.images %>">
                                        <% } %>
                                      <% } %>
                                    <% }) %>
                                  <% } %>
                                </div>
                              </div>
                  
                              <div class="skill-bar">
                                  <span class="skill-per percentage<%=truncatedPercentage%> <%= successfulResult %>">
                                      <span class="tooltip pop<%= successfulResult %>"><%= percentage %>% </span>
                                  </span>
                              </div>
          
                            </button>
                          </form>
                        <% } %>
                      <% }); %>
                    </div>

                  </div>
                  
                </div>
      
                <div class="location_poll aPoll">
                  <% if ( user._id.toString() == room.user._id.toString() && isIdentical) { %>
                    <form action="/inviteVotes" method="post" class="finVote">
                      <input type="hidden" name="votingCategory" value="location">
                      <input type="hidden" name="roomID" value="<%= room._id %>">
                      <button type="submit" name="updateInvite" value="updateInvite" class="date_category category_button"><i class="fa-solid fa-arrow-up-right-dots"></i> Update the invite with the most voted location &nbsp;<i class="fa-solid fa-list-check fa-lg"></i></button>
                    </form>
                  <% } %>
                  <div class="scrollableList leftSideScroll_Design">
                    <div class="correctReversion">
                      <form action="/inviteVotes" method="post" class="addAVote fullW100">
                        <label for="location">Select a new Location to propose:</label>
                        <div>
                          <select name="newValue" id="location" class="location">
                            <option value="" disabled>Add/Select a Location</option>
                            <optgroup label="Inside">
                              <option value="Home" selected>Home</option>
                            </optgroup>
                            <optgroup label="Pubs">
                              <option value="1UP Gamers Pub">1UP Gamers Pub</option>
                              <option value="Aria Cafe">Aria Cafe</option>
                              <option value="Arcade Cafe">Arcade Cafe</option>
                              <option value="Ceainăria Cinci">Ceainăria Cinci</option>
                              <option value="Lente Lupu">Lente Lupu</option>
                              <option value="Modelier">Modelier</option>
                              <option value="Snakes & Wizards">Snakes & Wizards</option>
                              <option value="Snatch Pub">Snatch Pub</option>
                              <option value="Time Out Cafe">Time Out Cafe</option>
                            </optgroup>
            
                            <optgroup label="Other">
                              <option value="other1">Other Options</option>
                            </optgroup>
                          </select>
                          
                          <input type="hidden" name="roomID" value="<%= room._id %>">
                          <input type="hidden" name="userSessionID" value="<%= user._id %>">
                          <input type="hidden" name="votingCategory" value="location">
                          <button class="poll_td_btn" name="newVote" value="newVote">Add <i class="fa-solid fa-arrow-turn-down fa-lg"></i></button>
                        </div>
                      </form>
                      <!-- template  -->
                      <% room.votes.forEach(function(vote) { %>
                        <% if (vote.votingCategory === "location") { %>
                          <form action="/inviteVotes" method="post" class="addAVote fullW100">
                            <button type="submit" class="skill-box" name="plusOneVote" value="plusOneVote">
                              <div class="pull_item">
                                <div class="leftSide_item">
                                  <input type="hidden" name="roomID" value="<%= room._id %>">
                                  <input type="hidden" name="userSessionID" value="<%= user._id %>">
                                  <input type="hidden" name="item_ID" value="<%= vote._id %>">
          
          
                                  <%var matchFound = false; // Flag variable to track if match is found %>
                                  <%var count = 0; // Initialize counter variable %>
                              
                                  <%if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) {%>
                                    <%joinedGuestUsers.forEach(guestUser => {%>
                                      <%if (Array.isArray(vote.votedBy_ID) && vote.votedBy_ID.includes(guestUser._id.toString())) {%>
                                        <% count++; // Increment counter %>
                                        <%if (guestUser._id.toString() == user._id.toString()) {%>
                                          <%matchFound = true; // Set flag if match is found%>
                                          
                                        <%}%>
                                      <%}%>
                                    <%});%>
                                  <%}%>
          
                                  <!-- Check the flag variable and display appropriate icon -->
                                  <%if (matchFound) { %>
                                      <i class="fa-regular fa-circle-check"></i>
                                  <% } else { %>
                                      <i class="fa-regular fa-circle"></i>
                                  <% } %>
                                  
                                  <!-- generate a procentage of how many of the participants have agreed in the poll -->
                                  <%let totalParticipants = room.joined_guest.length; // Total number of participants%>
                                  <%let percentage = parseInt((count / totalParticipants * 100).toFixed(2));%>
                                  <%let truncatedPercentage = Math.floor(percentage / 10); // Remove the last digit%>
                                  
          
                                  <%let majorityThreshold = Math.ceil(totalParticipants / 2); // Calculate majority threshold%>
          
                                  <%let successfulResult = count >= majorityThreshold; // Check if count meets or exceeds the majority threshold%>
          
          
                                  <div class="item_name">
                                    <span class="title"><%= vote.newValue %></span>
                                  </div>
                                </div>
                                <div class="item_voters">
                                  <% if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) { %>
                                    <% joinedGuestUsers.forEach(guestUser => { %>
                                      <% if (Array.isArray(vote.votedBy_ID) && vote.votedBy_ID.includes(guestUser._id.toString())) { %>
                                        <%if (guestUser._id.toString() == user._id.toString()) {%>
                                          <img class="votingImg" title="<%= guestUser.yourName %>" src="/userImages/<%= guestUser.images %>" style="border: 2px solid rgb(84, 84, 134);">
                                        <% } else { %>
                                          <img class="votingImg" title="<%= guestUser.yourName %>" src="/userImages/<%= guestUser.images %>">
                                        <% } %>
                                      <% } %>
                                    <% }) %>
                                  <% } %>
                                </div>
                              </div>
                  
                              <div class="skill-bar">
                                  <span class="skill-per percentage<%=truncatedPercentage%> <%= successfulResult %>">
                                      <span class="tooltip pop<%= successfulResult %>"><%= percentage %>% </span>
                                  </span>
                              </div>
          
                            </button>
                          </form>
                        <% } %>
                      <% }); %>
                    </div>

                  </div>

                </div>
              </div>
            </div>
          </section>


          <section class="comment_section">
            <div class="comment_container">
              <div class="spinerPositioning">
                <img class="sizeCap" src="/img/delayBG/spinner (2).gif" alt="">
              </div>
              <ul class="com_ul" id="commentList">
                <% room.chat.forEach(message => { %>
                  <% if (message.userID && message.userID.toString() === userSession._id.toString()) { %>
                      <li class="com_li_session">
                        <div class="com_li_session_sub">
                          <div class="com_li_session_div_msg">
                            <p> <%= message.message %>  </p>
                          </div>
                          <div class="com_li_session_div_time">
                            <p> <%= message.date %> - <%= message.time %> </p>
                          </div>
                        </div>

                        <% if (joinedGuestUsers && joinedGuestUsers.length > 0) { %>
                          <% joinedGuestUsers.forEach(guestUser => { %>
                            <% if (guestUser._id.toString() === message.userID.toString()) { %>

                              <div class="chat_userID open-add-popup">
                                <div class="chat_avatarImg">
                                  <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                                </div>
                                <div class="chat_nameDisplay">
                                  
                                  <div class="com_li_session_div_name">
                                    <p><i><%= message.name %> </i> </b> </p>
                                  </div>
                                </div>
                              </div>
                            <% } %>
                          <% }); %>
          
                        <% } else { %>
                          <p>No joined guests found</p>
                        <% } %>

                      </li>
                  <% } else { %>
                    <li class="com_li_others">
                      <% if (joinedGuestUsers && joinedGuestUsers.length > 0) { %>
                        <% joinedGuestUsers.forEach(guestUser => { %>
                          <% if (guestUser._id && message.userID && guestUser._id.toString() === message.userID.toString()) { %>

                            <div class="chat_userID open-add-popup">
                              <div class="chat_avatarImg">
                                <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                              </div>
                              <div class="chat_nameDisplay">
                                
                                <div class="com_li_others_div_name">
                                  <p><i><%= message.name %> </i> </b> </p>
                                </div>
                              </div>
                            </div>
                          <% } %>
                        <% }); %>
        
                      <% } else { %>
                        <p>No joined guests found</p>
                      <% } %>

                      <div class="com_li_others_sub">
                        <div class="com_li_others_div_msg">
                          <p> <%= message.message %>  </p>
                        </div>
                        <div class="com_li_others_div_time">
                          <p> <%= message.date %> - <%= message.time %> </p>
                        </div>
                      </div>

                    </li>
                  <% } %>
              <% }); %>
              </ul>

              
            </div>
            <form action="/comment" id="commentForm" method="POST" class="comm_form">
              <input type="hidden" name="roomID" value="<%= roomID %>">
              <input type="hidden" name="userID" value="<%= userSession._id%>">
              <input type="hidden" name="yourName" id="nameInput" value="<%= userSession.yourName%>">
              <textarea name="msg" class="comm_input" id="msg" placeholder="Message"></textarea>
              <div class="spinerPositioning">
                <img class="sizeCap" src="/img/delayBG/spinner (2).gif" alt="">
              </div>
              <button type="submit" class="comm_btn" id="sendButton">Send <i class="fa-solid fa-paper-plane"></i></button>

            </form>

            <form action="/seenNotification" method="post" class="triggerSeenChatNotif">
              <input type="hidden" name="roomID" value="<%= room._id %>">
                <input type="hidden" name="notifType" value="chat">
                <input type="hidden" name="reason" value="new_msg">
                <input type="hidden" name="participantID" value="<%= user._id %>">
                <input type="hidden" name="theActualNotifItem" value="seen">
                <input type="hidden" name="bell" value="seen">
                <input type="hidden" name="navBar" value="seen">
                <input type="hidden" name="indexInviteBox" value="seen">
                <input type="hidden" name="clearNotifification" value="new_msg" class="css_votes_display_organizer_btn time_btn active_btn_tab">
            </form>
          </section>


        </div>
      <% } else { %>
        <div class="roomBox">
          <div class="mainBox">
            <div class="mainBox-owner">
              
              <div class="mainBox-owner-top">
                <div class="userID">
                  <div class="avatarImg">
                    <img class="profileGuest" src="/userImages/<%= room.user.images %>">
                  </div>

                  <div name="dosarRep">
                    <% let groupedData_honer2 = []; %>
                    <% let groupedData_stain2 = []; %>
                  
                    <% if (userPlus && userPlus.length > 0) { %>
                      <% userPlus.forEach(data => { %>
                        <% if (data.userLink.toString() == room.user._id.toString()) { %>
                          
                          <% data.allReputation.forEach(reputation => { %>
                  
                            <!-- match with honor  -->
                            <% if (importHonorDetail && importHonorDetail.length > 0) { %>
                              <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
                  
                                <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                  <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                    <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                      <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                          <% groupedData_honer2.push(subCategory); %>
                                        <% }; %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                  
                              <% }); %>
                            <% } %>
                  
                            <!-- match with stain  -->
                            <% if (importStainDetail && importStainDetail.length > 0) { %>
                              <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
                  
                                <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                  <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                    <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                      <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                          <% groupedData_stain2.push(subCategory); %>
                                        <% }; %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                  
                              <% }); %>
                            <% } %>
                  
                  
                          <% }); %>
                        <% } %>
                      <% }); %>
                      
                    <% } %>
                  </div>
                  <div class="reputationBox">
                    <div class="honors">
                      <% if (groupedData_honer2 && groupedData_honer2.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_honer2 = groupedData_honer2.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_honer2.slice(0, 2).forEach(item => { %>
                          <div class="honor" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                    </div>
                    <div class="redFlags">
                      <% if (groupedData_stain2 && groupedData_stain2.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_stain2 = groupedData_stain2.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_stain2.slice(0, 1).forEach(item => { %>
                          <div class="flag" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                    </div>
                  </div>
                </div>
                <div class="inviteDetails">
                  <p class="topSpaceText"><%= room.selectedDate %></p>
                  <p class="zeroSpaceText"><%= room.selectedTime %></p>
                  <p class="zeroSpaceText">Location: My home</p>
                  <p class="zeroSpaceText"><br> No. of players: <%= room.joined_guest.length %> / <%= room.numberOfInvites %></p>
                </div>
              </div>
              <div class="proposedGames">
                <ul class="SpaceRoomBoardgames">
                  <% room.theBoardgames_name.forEach(boardgame => { %>
                    <li class="SpaceRoomBoardgamesLi"><%= boardgame %></li>
                  <% }) %>
                </ul>
              </div>
            </div>
            <div class="join-div">
              <%
                let hasBennBanned = false;
                room.banned_players.forEach(banned_player => {
                    if (banned_player.toString() === user._id.toString()) {
                        hasBennBanned = true;
                    }
                });
              %>
              <form action="/index_append_joined_guest" method="post">
                <input type="hidden" name="userRoomId" value="<%= room._id %>">
                <input type="hidden" name="joined_guest" value="<%= user._id %>">
                <input type="hidden" name="selectedTime" value="<%= room.selectedTime %>">
                <input type="hidden" name="selectedDate" value="<%= room.selectedDate %>">
                <input type="hidden" name="theBoardgames_id" value="<%= room.theBoardgames_id %>">
                <input type="hidden" name="location" value="<%= room.location %>">
                <input type="hidden" name="numberOfInvites" value="<%= room.numberOfInvites %>">
                <input type="hidden" name="joined_guest_length" value="<%= room.joined_guest.length %>">
                <!-- Check if any ban has been given to the player  -->
                <% if (joinedGuestUsers) { %>
                  <!-- Display user details -->
                  <% let foundMatchingUser = false; %>




                    <!-- Display other user details as needed -->
                    <% if ( !hasBennBanned && user._id.toString() == userSession._id.toString() ) { %>
                      <% foundMatchingUser = true; %>
                      <!-- Check if the user has already joined  -->

                        <button type="submit" id="buttonX" value="add an user" class="joinRoomButton"> Enter the invite</button>

                    <% } else if ( !hasBennBanned && !foundMatchingUser &&  room.joined_guest.length  < room.numberOfInvites) { %>
                      <!-- Check if the user did not join previously and if there is still space to join -->
                      
                      <button type="submit" id="buttonX" value="add an user" class="joinRoomButton"> Join the invite</button>
                    <% } else if ( hasBennBanned ) { %>
                      <!-- Check if any ban has been given to the player  -->
                      <div class="restrictedAccess">
                        <p>Restricted access</p>
                      </div>
                      
                    <% } else { %>

                    <% } %>
              
                <% } else { %>
                  <p>Server is down for the moment</p>
                <% } %>
              </form>
            </div>
            
            <div id="resizableDiv" class="mainBox-participants">
              

            <!-- Check if joinedGuestUsers contains data for the current room ID -->
            <% if (joinedGuestUsers ) { %>
              <!-- Display user details -->
              <% joinedGuestUsers.forEach(user => { %>

                <!-- Display other user details as needed -->
                <a href="/userProfile/<%= user._id %>" class="userID">
                  <div class="avatarImg">
                    <img class="profileGuest" src="/userImages/<%= user.images %>">
                  </div>

                </a>
                
              <% }) %>
            <% } else { %>
              <p>No user data found for this room</p>
            <% } %>





<!-- sa-io scriu sa mi faca userID pe baza la ce am facut in the room -->







            </div>
            <button id="buttonX" class="turnPageButton"> <i class="fa-solid fa-angle-down fa-xl"></i></button>
          </div>
          <div class="sideBoxPics">
            
          </div>
        </div>
      <% } %>

    <% }); %>
  <% } else { %>
    <p>No room data found</p>
  <% } %>














  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon positionRelative" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon" 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
    <div class="titleNav_div">
    </div>
  </div>





  <script src="/js/theRoom-script.js"></script>
  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  
</body>
</html>