<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
    

  <link rel="icon" href="img/title/">


  <link rel="stylesheet" href="/css/dnd/char/myCharList.css">


  <script
    type="module"
    src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
  ></script>
  <!-- Include jQuery library -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>
<body>
    

<!-- =========================================================
     MY CHARACTERS PAGE
========================================================= -->

<div class="characters-page">


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <header class="characters-navbar">

        <div class="characters-navbar__inner">


            <!-- Logo -->
            <a href="/<%= userId %>/dnd" class="characters-navbar__logo" aria-label="Home" >
                <span class="characters-navbar__logo-symbol">
                    ◈
                </span>
            </a>


            <!-- Desktop navigation -->
            <nav class="characters-navbar__nav">

                <a
                    href="/index"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ⌂
                    </span>

                    <span>
                        Exist D&D
                    </span>
                </a>

                <a
                    href="/<%= userId %>/dnd"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ⌂
                    </span>

                    <span>
                        D&D Home
                    </span>
                </a>


                <a
                    href="/editProfile"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ♙
                    </span>

                    <span>
                        User Profile
                    </span>
                </a>


                <a
                    href="/<%= userId %>/dnd/myChars"
                    class="characters-navbar__link characters-navbar__link--active"
                >
                    <span class="characters-navbar__link-icon">
                        ◈
                    </span>

                    <span>
                        My Chars
                    </span>
                </a>


                <a
                    href="/<%= userId %>/dnd/myCampaigns"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ⚑
                    </span>

                    <span>
                        My Campaigns
                    </span>
                </a>


                <a
                    href="/feedback"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ◌
                    </span>

                    <span>
                        Feedback
                    </span>
                </a>

            </nav>


            <!-- User -->
            <a
                href="/editProfile"
                class="characters-navbar__user"
            >

                <div class="characters-navbar__avatar">
                    <img
                        src="/images/user-avatar.jpg"
                        alt="User profile"
                    >
                </div>

                <span class="characters-navbar__user-arrow">
                    ⌄
                </span>

            </a>


            <!-- Mobile menu button -->
            <button
                type="button"
                class="characters-navbar__mobile-toggle"
                id="charactersMobileToggle"
                aria-label="Open navigation"
                aria-expanded="false"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

        </div>


        <!-- Mobile navigation -->
        <nav
            class="characters-navbar__mobile"
            id="charactersMobileNav"
        >

            <a href="/index">
                Exist D&D
            </a>
            <a href="/<%= userId %>/dnd">
                D&D Home
            </a>

            <a href="/editProfile">
                User Profile
            </a>

            <a
                href="/<%= userId %>/dnd/myChars"
                class="characters-navbar__mobile-link--active"
            >
                My Chars
            </a>

            <a href="/<%= userId %>/dnd/myCampaigns">
                My Campaigns
            </a>

            <a href="/feedback">
                Feedback
            </a>

        </nav>

    </header>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="characters-main">


        <!-- =================================================
             PAGE HEADER
        ================================================== -->

        <section class="characters-heading">

            <div class="characters-heading__title-area">
                <h1 class="characters-heading__title">
                    My Characters
                </h1>

                <div class="characters-heading__ornament">

                    <span class="characters-heading__ornament-line"></span>

                    <span class="characters-heading__ornament-diamond">
                        ◆
                    </span>

                    <span class="characters-heading__ornament-line"></span>

                </div>
            </div>

            <form
                action="/<%= userId %>/dnd/myChars"
                method="POST"
                class="characters-create-form"
            >
                <input
                    type="hidden"
                    name="userID"
                    value="<%= userId %>"
                >

                <input
                    type="hidden"
                    name="action"
                    value="create-character"
                >

                <button
                    type="submit"
                    class="characters-create-button characters-create-button--top"
                >

                    <span class="characters-create-button__icon">
                        +
                    </span>

                    <span>
                        Create New Character
                    </span>

                </button>
            </form>

        </section>



        <!-- =================================================
             SEARCH / SORT TOOLBAR
        ================================================== -->

        <section class="characters-toolbar">


            <!-- Search -->
            <div class="characters-search">

                <span class="characters-search__icon">
                    ⌕
                </span>

                <input
                    type="search"
                    id="characterSearch"
                    class="characters-search__input"
                    placeholder="Search characters..."
                    autocomplete="off"
                >

                <button
                    type="button"
                    class="characters-search__clear"
                    id="characterSearchClear"
                    aria-label="Clear search"
                >
                    ×
                </button>

            </div>


            <!-- Sort -->
            <div class="characters-sort">

                <span class="characters-sort__icon">
                    ☷
                </span>

                <label
                    for="characterSort"
                    class="characters-sort__label"
                >
                    Sort by
                </label>

                <select
                    id="characterSort"
                    class="characters-sort__select"
                >

                    <option value="name-asc">
                        Name (A-Z)
                    </option>

                    <option value="name-desc">
                        Name (Z-A)
                    </option>

                    <option value="level-desc">
                        Level (High-Low)
                    </option>

                    <option value="level-asc">
                        Level (Low-High)
                    </option>

                    <option value="newest" selected>
                        Recently Created
                    </option>

                    <option value="oldest">
                        Oldest First
                    </option>

                </select>

                <span class="characters-sort__arrow">
                    ⌄
                </span>

            </div>

        </section>



        <!-- =================================================
             RESULTS INFORMATION
        ================================================== -->

        <div class="characters-results-bar">

            <span
                class="characters-results-count"
                id="charactersResultsCount"
            >
                Characters
            </span>

            <button
                type="button"
                class="characters-reset"
                id="charactersReset"
            >
                Reset filters
            </button>

        </div>



        <!-- =================================================
             !!! CHARACTER CARDS GO HERE !!!
        ================================================== -->

        <section
            class="characters-grid"
            id="charactersGrid"
        >

            <!-- ============================= -->
            <!-- ITERATE THROUGH CHARACTER LIST -->
            <!-- ============================= -->
            <% if (characters && Array.isArray(characters) && characters.length > 0) { %>
                <% characters.forEach(function(character) { %>
                    <article class="character-card">

                        <!-- ============================= -->
                        <!-- CHARACTER INFORMATION -->
                        <!-- ============================= -->

                        <a class="character-card__info" href="/<%= userId %>/dnd/char/<%= character._id %>">
                            
                            <!-- Background artwork -->
                            <div
                                class="character-card__background"
                                <% if (!character.selectedBackground) { %>
                                    style="background-image: url('<%= character.charAvatar || "/images/characters/default-bg.jpg" %>');"
                                <% } %>
                            >
                                <% if (character.selectedBackground) { %>
                                    <img
                                        src="/img/dnd/backgrounds/<%= character.selectedBackground.index %>.png"
                                        alt="<%= character.selectedBackground.name %> background"
                                    >
                                <% } %>
                            </div>

                            <!-- Smoke / dark overlay -->
                            <div class="character-card__overlay"></div>


                            <div class="character-card__content">

                                <div class="character-card_divider_top">
                                    
                                    <!-- Avatar -->
                                    <div class="character-card__avatar">
                                        <img
                                            src="<%= character.charAvatar || "/images/characters/default-avatar.jpg" %>"
                                            alt="<%= character.charName %> avatar"
                                        >

                                    </div>

                                    <div class="cardIdentity">

                                        <!-- Character name -->
                                        <h2 class="character-card__name">
                                            <%= character.charName %>
                                        </h2>


                                        <!-- Level -->
                                        <div class="character-card__level">
                                            Level <%= character.totalLevel || 0 %>
                                        </div>

                                    </div>
                                </div>    

                                <div class="character-card__divider"></div>

                                <div class="character-card_divider_bot">
                                    <!-- Race -->
                                    <div class="character-card__attribute">
        
                                        <span class="character-card__attribute-icon">
                                            ◈
                                        </span>
        
                                        <span class="character-card__attribute-text">
                                            <%= character.race && character.race.index ? character.race.index : "No Race" %>
                                        </span>
        
                                    </div>
        
        
                                    <!-- Class / subclass -->
                                    <div class="character-card__attribute">
        
                                        <span class="character-card__attribute-icon">
                                            ⚔
                                        </span>
        
                                        <span class="character-card__attribute-text">
                                            <% if (character.primaryClass && character.primaryClass.index) { %>
                                                <%= character.primaryClass.index %>
                                                <% if (character.classes.length > 1) { %>
                                                    <span class="character-card__subclass">
                                                        / <%= character.classes.length %> classes
                                                    </span>
                                                <% } %>
                                            <% } else { %>
                                                No Class
                                            <% } %>
                                        </span>
        
                                    </div>

                                </div>                            



                            </div>

                        </a>



                        <!-- ============================= -->
                        <!-- ACTIONS -->
                        <!-- ============================= -->

                        <div class="character-card__actions">


                            <!-- VIEW -->
                            <a
                                href="/<%= userId %>/dnd/char/<%= character._id %>"
                                class="character-action character-action--view"
                            >
                                <span class="character-action__icon">
                                    ◉
                                </span>

                                <span class="character-action__label">
                                    View
                                </span>
                            </a>


                            <!-- EDIT -->
                            <form
                                action="/<%= userId %>/dnd/builder/<%= character._id %>/class/management"
                                method="GET"
                                class="character-action-form"
                            >

                                <button
                                    type="submit"
                                    class="character-action character-action--edit"
                                >
                                    <span class="character-action__icon">
                                        ✎
                                    </span>

                                    <span class="character-action__label">
                                        Edit
                                    </span>
                                </button>

                            </form>


                            <!-- DUPLICATE -->
                            <form
                                action="/<%= userId %>/dnd/builder/<%= character._id %>/duplicate"
                                method="POST"
                                class="character-action-form"
                            >

                                <button
                                    type="submit"
                                    class="character-action character-action--duplicate"
                                >
                                    <span class="character-action__icon">
                                        ◫
                                    </span>

                                    <span class="character-action__label">
                                        Copy
                                    </span>
                                </button>

                            </form>


                            <!-- DELETE -->
                            <form
                                action="/<%= userId %>/dnd/builder/<%= character._id %>/delete"
                                method="POST"
                                class="character-action-form"
                            >

                                <button
                                    type="submit"
                                    class="character-action character-action--delete"
                                >
                                    <span class="character-action__icon">
                                        ♲
                                    </span>

                                    <span class="character-action__label">
                                        Delete
                                    </span>
                                </button>

                            </form>

                        </div>

                    </article>
                <% }); %>
            <% } %>

            <section
                class="characters-empty"
                id="charactersEmpty"
                <%= characters && Array.isArray(characters) && characters.length > 0 ? 'hidden' : '' %>
            >

                <div class="characters-empty__icon">
                    ⌕
                </div>

                <h2>
                    No characters found
                </h2>

                <p>
                    No character matches your current search.
                </p>

                <button
                    type="button"
                    class="characters-empty__button"
                    id="charactersEmptyReset"
                >
                    Clear Search
                </button>

            </section>

        </section>


        <!-- =================================================
             BOTTOM CREATE BUTTON
        ================================================== -->

        <form 
        class="characters-create-area"
        action="/<%= userId %>/dnd/myChars"
        method="POST"
        >
            <input
                type="hidden"
                name="userID"
                value="<%= userId %>"
            >

            <input
                type="hidden"
                name="action"
                value="create-character"
            >
            <span class="characters-create-area__line"></span>

            <button
                type="submit"
                class="characters-create-button"
            >

                <span class="characters-create-button__icon">
                    +
                </span>

                <span>
                    Create New Character
                </span>

            </button>

            <span class="characters-create-area__line"></span>

        </form>


    </main>

</div>





    
  <script src="/js/dnd/char/myChars_script.js"></script>
  <script src="/js/dnd/charactersToolbar.js"></script>
  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  
</body>
</html>
