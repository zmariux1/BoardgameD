<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alege-ți Specia</title>

    
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/root.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/comunBuilder.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/formDeAcceptare.css">
    
    <link rel="stylesheet" href="/css/dnd/char/builder/class_selection.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/species_selection.css">
    
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/asideBar.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/header.css">

</head>

<body>

    <div class="character-page">

        <!-- =========================================================
             TOP BAR
        ========================================================== -->
        <%- include('piese/header') %>


        <!-- =========================================================
             MAIN LAYOUT
        ========================================================== -->

        <div class="character-layout">


            <!-- =====================================================
                 LEFT SIDEBAR
            ====================================================== -->
            <%- include('piese/asideBar') %>
            


            <!-- =====================================================
                 MAIN CONTENT
            ====================================================== -->

            <main class="character-content">
                <div class="pozitionare_content">

                    
                    <!-- =================================================
                            PAGE HEADER
                    ================================================== -->
    
                    <section class="class-selection-header">
    
                        <h1 class="class-selection-header__title">
                            Alege-ți Specia
                        </h1>
    
                        <p class="class-selection-header__description">
                            Specia ta îți oferă trăsături înnăscute și bonusuri
                            care te vor însoți în aventură.
                        </p>
    
                        <p class="class-selection-header__subtitle">
                            Alege cu înțelepciune, erou!
                        </p>
    
                    </section>
    
    
    
                    <!-- =================================================
                            SPECIES LIST
                    ================================================== -->
                    <% if (Array.isArray(species) && species.length) { %>
    
                        <section class="sub_container" aria-label="Specii disponibile">
                            
                            <% species.forEach(function(item) { %>

                                <!-- ============================= -->
                                <!-- SPECIES CARD -->
                                <!-- ============================= -->

                                <article
                                    class="species-card"
                                    id="rasa<%= item.index %>"
                                    data-species-id="<%= item.index %>"
                                >

                                    <!-- IMAGINE -->
                                    <div class="species-card__image-wrapper">

                                        <img
                                            src="/img/dnd/races/<%= item.index %>.png"
                                            alt="<%= item.name %>"
                                            class="species-card__image"
                                            onerror="this.onerror=null;this.src='/img/dnd/species/default.png';"
                                        >

                                    </div>


                                    <!-- CONTINUT -->
                                    <div class="species-card__content">

                                        <!-- TITLU -->
                                        <div class="species-card__title-row">

                                            <h2 class="species-card__title">
                                                <%= item.name %>
                                            </h2>

                                            <span class="species-card__icon">
                                                ☼
                                            </span>

                                        </div>


                                        <!-- ABILITY SCORES -->
                                        <% if (
                                            (Array.isArray(item.ability_bonuses) && item.ability_bonuses.length) ||
                                            (
                                                item.ability_bonus_options &&
                                                item.ability_bonus_options.from &&
                                                Array.isArray(item.ability_bonus_options.from.options) &&
                                                item.ability_bonus_options.from.options.length
                                            )
                                        ) { %>

                                            <div class="species-card__stat">

                                                <% if (
                                                    Array.isArray(item.ability_bonuses) &&
                                                    item.ability_bonuses.length
                                                ) { %>

                                                    <div class="species-card__stat-fixed">

                                                        <% item.ability_bonuses.forEach(function(bonus, index) { %>

                                                            <span>
                                                                <%= bonus.ability_score.name %> +<%= bonus.bonus %>
                                                            </span>

                                                            <% if (index < item.ability_bonuses.length - 1) { %>
                                                                <span>&amp;</span>
                                                            <% } %>

                                                        <% }); %>

                                                    </div>

                                                <% } %>


                                                <% if (
                                                    item.ability_bonus_options &&
                                                    item.ability_bonus_options.from &&
                                                    Array.isArray(item.ability_bonus_options.from.options) &&
                                                    item.ability_bonus_options.from.options.length
                                                ) { %>

                                                    <div class="species-card__stat-options">

                                                        <div class="species-card__stat-options-label">

                                                            <% if (
                                                                item.ability_bonuses &&
                                                                item.ability_bonuses.length
                                                            ) { %>

                                                                <%= item.ability_bonus_options.choose %> alegeri de +1:

                                                            <% } else { %>

                                                                Alege <%= item.ability_bonus_options.choose %>:

                                                            <% } %>

                                                        </div>


                                                        <div class="species-card__stat-options-list">

                                                            <% item.ability_bonus_options.from.options.forEach(function(option, index) { %>

                                                                <span>
                                                                    <%= option.ability_score.name %> +<%= option.bonus %>
                                                                </span>

                                                                <% if (
                                                                    index <
                                                                    item.ability_bonus_options.from.options.length - 1
                                                                ) { %>

                                                                    <span>&amp;</span>

                                                                <% } %>

                                                            <% }); %>

                                                        </div>

                                                    </div>

                                                <% } %>

                                            </div>

                                        <% } %>


                                        <!-- ALIGNMENT -->
                                        <% if (item.alignment_simplified) { %>

                                            <div class="species-card__alignment">

                                                <strong>Aliniament:</strong>

                                                <span>
                                                    <%= item.alignment_simplified %>
                                                </span>

                                            </div>

                                        <% } %>

                                    </div>

                                </article>


                                <!-- ============================= -->
                                <!-- SPECIES MODAL -->
                                <!-- ============================= -->

                                <div
                                    class="species-modal"
                                    id="species-modal-<%= item.index %>"
                                    data-species-modal="<%= item.index %>"
                                    aria-hidden="true"
                                >

                                <form
                                    action="/<%= userId %>/dnd/builder/<%= characterId %>/species/choose"
                                    method="POST"
                                    class="species-modal__form"
                                    data-form-species
                                >

                                    <!-- RACE -->
                                    <input
                                        type="hidden"
                                        name="raceIndex"
                                        value="<%= item.index %>"
                                    >


                                    <!-- HEADER -->

                                    <div class="species-modal__header">

                                        <div class="species-modal__heading">

                                            <span class="species-modal__eyebrow">
                                                ALEGERI PERSONAJ
                                            </span>

                                            <h2>
                                                Alegerea rasei
                                            </h2>

                                        </div>


                                        <button
                                            type="button"
                                            class="species-modal__close"
                                            aria-label="Închide"
                                            data-close-species-modal
                                        >
                                            ×
                                        </button>

                                    </div>


                                    <!-- CONTENT -->

                                    <div class="species-modal__content">

                                        <div class="species-modal__species">

                                            <div class="species-modal__image">

                                                <img
                                                    src="/img/dnd/races/<%= item.index %>.png"
                                                    alt="<%= item.name %>"
                                                    onerror="this.onerror=null;this.src='/img/dnd/species/default.png';"
                                                >
                                            </div>

                                            <div class="species-modal__selection">

                                                <span class="species-modal__label">
                                                    Ai selectat rasa
                                                </span>

                                                <h3>
                                                    <%= item.name %>
                                                </h3>

                                            </div>

                                            <div class="species-modal__subrace">

                                                <label
                                                    class="species-modal__label"
                                                    for="subrace-<%= item.index %>"
                                                >
                                                    Subrasă
                                                </label>

                                                <select
                                                    class="species-modal__subrace-select"
                                                    id="subrace-<%= item.index %>"
                                                    name="subRace"
                                                >
                                                    <option
                                                        value=""
                                                        disabled
                                                        <%= !subraces.some(function(subrace) {
                                                            return subrace.race &&
                                                                subrace.race.index === item.index &&
                                                                subrace.index === character.race.subRace;
                                                        }) ? "selected" : "" %>
                                                    >
                                                        Alege o subrasă
                                                    </option>

                                                    <% subraces
                                                        .filter(function(subrace) {
                                                            return subrace.race && subrace.race.index === item.index;
                                                        })
                                                        .forEach(function(subrace) { %>
                                                            <option
                                                                value="<%= subrace.index %>"
                                                                <%= character.race.index === item.index &&
                                                                    character.race.subRace === subrace.index
                                                                    ? "selected"
                                                                    : "" %>
                                                            >
                                                                <%= subrace.name %>
                                                            </option>
                                                    <% }); %>
                                                </select>

                                            </div>

                                        </div>


                                        <p class="species-modal__question">
                                            Vrei să continui cu această alegere sau să explorezi
                                            alte opțiuni?
                                        </p>

                                    </div>


                                    <!-- ACTIONS -->

                                    <div class="species-modal__actions">

                                        <button
                                            type="submit"
                                            class="species-modal__button species-modal__button--primary"
                                        >
                                            <span>✓</span>
                                            Alege această rasă
                                        </button>


                                        <a
                                            href="https://dnd5e.wikidot.com/lineage:<%= item.index %>"
                                            target="_blank"
                                            class="species-modal__button species-modal__button--secondary"
                                        >
                                            Detalii rasă
                                        </a>


                                        <button
                                            type="button"
                                            class="species-modal__button species-modal__button--text"
                                            data-close-species-modal
                                        >
                                            Vreau altă rasă
                                        </button>

                                    </div>

                                </form>

                                </div>

                            <% }); %>
                        </section>
    
    
    
                    <% } else { %>
                        <p>Nu s-au primit date din Classes.json.</p>
                    <% } %>
    
    
                    <!-- =================================================
                            BOTTOM NAVIGATION
                    ================================================== -->
    
                    <footer class="class-selection-footer">
    
                        <div class="class-selection-footer__decoration">
                            <span></span>
    
                            <div class="class-selection-footer__dice">
                                ◆
                            </div>
    
                            <span></span>
                        </div>
    
    
                        <button
                            type="button"
                            class="class-selection-footer__back"
                        >
                            Înapoi
                        </button>
    
                    </footer>

                </div>
            </main>





            <!-- =========================================================
                CLASS DETAILS MODAL
                Poate fi folosit pentru orice clasă D&D.
                Datele Barbarian sunt doar exemplu.
            ========================================================= -->














            

        </div>

    </div>











  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>

<script>
    document.addEventListener("DOMContentLoaded", () => {

    const speciesCards = document.querySelectorAll(".species-card");
    const speciesModals = document.querySelectorAll(".species-modal");


    /* =====================================================
       OPEN MODAL
       ===================================================== */

    speciesCards.forEach(card => {

        card.addEventListener("click", () => {

            const speciesId = card.dataset.speciesId;

            const modal = document.querySelector(
                `[data-species-modal="${speciesId}"]`
            );

            if (!modal) return;

            openSpeciesModal(modal);

        });

    });


    /* =====================================================
       CLOSE BUTTONS
       ===================================================== */

    speciesModals.forEach(modal => {

        const closeButtons = modal.querySelectorAll(
            "[data-close-species-modal]"
        );


        closeButtons.forEach(button => {

            button.addEventListener("click", (event) => {

                event.preventDefault();

                closeSpeciesModal(modal);

            });

        });


        /* =================================================
           CLICK OUTSIDE FORM
           ================================================= */

        modal.addEventListener("click", (event) => {

            if (event.target === modal) {

                closeSpeciesModal(modal);

            }

        });

    });


    /* =====================================================
       ESCAPE
       ===================================================== */

    document.addEventListener("keydown", (event) => {

        if (event.key !== "Escape") return;

        const openedModal = document.querySelector(
            ".species-modal.is-open"
        );

        if (openedModal) {

            closeSpeciesModal(openedModal);

        }

    });


    /* =====================================================
       OPEN
       ===================================================== */

    function openSpeciesModal(modal) {

        speciesModals.forEach(otherModal => {

            otherModal.classList.remove("is-open");
            otherModal.setAttribute("aria-hidden", "true");

        });


        modal.classList.add("is-open");

        modal.setAttribute("aria-hidden", "false");


        document.body.classList.add("modal-open");

    }


    /* =====================================================
       CLOSE
       ===================================================== */

    function closeSpeciesModal(modal) {

        modal.classList.remove("is-open");

        modal.setAttribute("aria-hidden", "true");


        const anyModalOpen = document.querySelector(
            ".species-modal.is-open"
        );


        if (!anyModalOpen) {

            document.body.classList.remove("modal-open");

        }

    }

});
</script>

</body>
</html>