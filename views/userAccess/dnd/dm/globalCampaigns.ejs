<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
    

  <link rel="icon" href="img/title/">


  <link rel="stylesheet" href="/css/dnd/char/myCharList.css">


  <script
    type="module"
    src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
  ></script>
  <!-- Include jQuery library -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>
<body>
    

<!-- =========================================================
     MY CAMPAIGNS PAGE
========================================================= -->

<div class="characters-page">


    <!-- =====================================================
         NAVIGATION
    ====================================================== -->

    <header class="characters-navbar">

        <div class="characters-navbar__inner">


            <!-- Logo -->
            <a
                href="/"
                class="characters-navbar__logo"
                aria-label="Home"
            >
                <span class="characters-navbar__logo-symbol">
                    ◈
                </span>
            </a>


            <!-- Desktop navigation -->
            <nav class="characters-navbar__nav">

                <a href="/index" class="characters-navbar__link">
                    <span class="characters-navbar__link-icon">
                        ⌂
                    </span>

                    <span>
                        Exist D&D
                    </span>
                </a>

                <a href="/<%= userId %>/dnd" class="characters-navbar__link">
                    <span class="characters-navbar__link-icon">
                        ⌂
                    </span>

                    <span>
                        D&D Home
                    </span>
                </a>


                <a
                    href="/editProfile"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ♙
                    </span>

                    <span>
                        User Profile
                    </span>
                </a>


                <a
                    href="/<%= userId %>/dnd/globalCampaigns" 
                    class="characters-navbar__link characters-navbar__link--active"
                >
                    <span class="characters-navbar__link-icon">
                        ⚑
                    </span>

                    <span>
                        Global Campaigns
                    </span>
                </a>


                <a
                    href="/<%= userId %>/dnd/myCampaigns"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ⚑
                    </span>

                    <span>
                        My Campaigns
                    </span>
                </a>


                <a
                    href="/<%= userId %>/dnd/myChars"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ◈
                    </span>

                    <span>
                        My Characters
                    </span>
                </a>


                <a
                    href="/feedback"
                    class="characters-navbar__link"
                >
                    <span class="characters-navbar__link-icon">
                        ◌
                    </span>

                    <span>
                        Feedback
                    </span>
                </a>

            </nav>


            <!-- User -->
            <a
                href="/editProfile"
                class="characters-navbar__user"
            >

                <div class="characters-navbar__avatar">
                    <img
                        src="/images/user-avatar.jpg"
                        alt="User profile"
                    >
                </div>

                <span class="characters-navbar__user-arrow">
                    ⌄
                </span>

            </a>


            <!-- Mobile menu button -->
            <button
                type="button"
                class="characters-navbar__mobile-toggle"
                id="charactersMobileToggle"
                aria-label="Open navigation"
                aria-expanded="false"
            >
                <span></span>
                <span></span>
                <span></span>
            </button>

        </div>


        <!-- Mobile navigation -->
        <nav
            class="characters-navbar__mobile"
            id="charactersMobileNav"
        >

            <a href="/index">
                Exist D&D
            </a>
            <a href="/<%= userId %>/dnd">
                D&D Home
            </a>

            <a href="/editProfile">
                User Profile
            </a>


            <a
                href="/<%= userId %>/dnd/globalCampaigns"
                class="characters-navbar__mobile-link--active"
            >
                Global Campaigns
            </a>

            <a
                href="/<%= userId %>/dnd/myCampaigns"
                class=""
            >
                My Campaigns
            </a>

            <a
                href="/<%= userId %>/dnd/myChars"
            >
                My Characters
            </a>

            <a href="/feedback">
                Feedback
            </a>

        </nav>

    </header>



    <!-- =====================================================
         MAIN
    ====================================================== -->

    <main class="characters-main">


        <!-- =================================================
             PAGE HEADER
        ================================================== -->

        <section class="characters-heading">

            <div class="characters-heading__title-area">

                <h1 class="characters-heading__title">
                    Global Campaigns
                </h1>

                <div class="characters-heading__ornament">

                    <span class="characters-heading__ornament-line"></span>

                    <span class="characters-heading__ornament-diamond">
                        ◆
                    </span>

                    <span class="characters-heading__ornament-line"></span>

                </div>

            </div>


            <form
                action="/<%= userId %>/dnd/myCampaigns"
                method="POST"
                class="characters-create-form"
            >
                <button
                    type="submit"
                    class="characters-create-button characters-create-button--top"
                >

                    <span class="characters-create-button__icon">
                        +
                    </span>

                    <span>
                        New Campaign
                    </span>

                </button>
            </form>

        </section>



        <!-- =================================================
             SEARCH / SORT TOOLBAR
        ================================================== -->

        <section class="characters-toolbar">


            <!-- Search -->
            <div class="characters-search">

                <span class="characters-search__icon">
                    ⌕
                </span>

                <input
                    type="search"
                    id="characterSearch"
                    class="characters-search__input"
                    placeholder="Search campaigns..."
                    autocomplete="off"
                >

                <button
                    type="button"
                    class="characters-search__clear"
                    id="characterSearchClear"
                    aria-label="Clear search"
                >
                    ×
                </button>

            </div>


            <!-- Sort -->
            <div class="characters-sort">

                <span class="characters-sort__icon">
                    ☷
                </span>

                <label
                    for="characterSort"
                    class="characters-sort__label"
                >
                    Sort by
                </label>

                <select
                    id="characterSort"
                    class="characters-sort__select"
                >

                    <option value="name-asc">
                        Name (A-Z)
                    </option>

                    <option value="name-desc">
                        Name (Z-A)
                    </option>

                    <option value="newest" selected>
                        Recently Created
                    </option>

                    <option value="oldest">
                        Oldest First
                    </option>

                </select>

                <span class="characters-sort__arrow">
                    ⌄
                </span>

            </div>

        </section>



        <!-- =================================================
             RESULTS INFORMATION
        ================================================== -->

        <div class="characters-results-bar">

            <span
                class="characters-results-count"
                id="charactersResultsCount"
            >
                Campaigns
            </span>

            <button
                type="button"
                class="characters-reset"
                id="charactersReset"
            >
                Reset filters
            </button>

        </div>



        <!-- =================================================
             CAMPAIGN CARDS
        ================================================== -->

        <section
            class="characters-grid"
            id="charactersGrid"
        >

            <!-- ============================= -->
            <!-- ITERATE THROUGH CAMPAIGNS -->
            <!-- ============================= -->
            <% if (campaigns && Array.isArray(campaigns) && campaigns.length > 0) { %>
                <% campaigns.forEach(function(campaign) { %>
                    <article class="campaign-entry-card">

                        <!-- ========================================= -->
                        <!-- CAMPAIGN HEADER -->
                        <!-- ========================================= -->

                        <a
                            href="/dnd/dmOverview/<%= campaign._id %>"
                            class="campaign-entry-card__main-link"
                            aria-label="Vezi campania <%= campaign.name || 'Campanie fără titlu' %>"
                        >

                            <div class="campaign-entry-card__header">

                                <!-- Campaign emblem -->
                                <div class="campaign-entry-card__emblem" aria-hidden="true">
                                    <span>⚑</span>
                                </div>

                                <div class="campaign-entry-card__heading">

                                    <div class="campaign-entry-card__eyebrow">
                                        CAMPAIGN
                                    </div>

                                    <h2 class="campaign-entry-card__title">
                                        <%= campaign.name || "Campanie fără titlu" %>
                                    </h2>

                                    <div class="campaign-entry-card__status">
                                        <span class="campaign-entry-card__status-dot"></span>
                                        Campanie activă
                                    </div>

                                </div>

                            </div>


                            <!-- ========================================= -->
                            <!-- CAMPAIGN DESCRIPTION -->
                            <!-- ========================================= -->

                            <div
                                class="campaign-entry-card__description"
                                data-description="<%= campaign.shortDescription || 'Fără descriere disponibilă.' %>"
                            >
                                <span
                                    class="campaign-entry-card__description-icon"
                                    aria-hidden="true"
                                >
                                    ◈
                                </span>

                                <p>
                                    <%= campaign.shortDescription || "Fără descriere disponibilă." %>
                                </p>
                            </div>


                            <!-- ========================================= -->
                            <!-- CAMPAIGN META -->
                            <!-- ========================================= -->

                            <div class="campaign-entry-card__meta">

                                <div class="campaign-entry-card__meta-item">
                                    <span
                                        class="campaign-entry-card__meta-icon"
                                        aria-hidden="true"
                                    >
                                        ♟
                                    </span>

                                    <div>
                                        <span class="campaign-entry-card__meta-label">
                                            Players
                                        </span>

                                        <strong class="campaign-entry-card__meta-value">
                                            <%= campaign.playerCount %>
                                            /
                                            <%= campaign.max_nr_users || "—" %>
                                        </strong>
                                    </div>
                                </div>


                                <div class="campaign-entry-card__meta-item">

                                    <span
                                        class="campaign-entry-card__meta-icon"
                                        aria-hidden="true"
                                    >
                                        ⚔
                                    </span>

                                    <div>

                                        <span class="campaign-entry-card__meta-label">
                                            Challenge
                                        </span>

                                        <strong class="campaign-entry-card__meta-value">
                                            <%= campaign.worldGeneralKnowledge &&
                                                campaign.worldGeneralKnowledge.type_of_challenge
                                                ? campaign.worldGeneralKnowledge.type_of_challenge
                                                : "Not configured" %>
                                        </strong>

                                    </div>

                                </div>


                                <div class="campaign-entry-card__meta-item">

                                    <span
                                        class="campaign-entry-card__meta-icon"
                                        aria-hidden="true"
                                    >
                                        ◆
                                    </span>

                                    <div>

                                        <span class="campaign-entry-card__meta-label">
                                            Campaign
                                        </span>

                                        <strong class="campaign-entry-card__meta-value">
                                            Private
                                        </strong>

                                    </div>

                                </div>

                            </div>

                        </a>


                        <!-- ========================================= -->
                        <!-- CAMPAIGN ACTIONS -->
                        <!-- ========================================= -->

                        <div class="campaign-entry-card__actions">

                            <form
                                class="campaign-entry-card__join-form"
                                action="/<%= userId %>/dnd/globalCampaigns/<%= campaign._id %>/join"
                                method="POST"
                            >

                                <div class="campaign-entry-card__character-field">
                                    <label
                                        for="campaign-character-<%= campaign._id %>"
                                        class="campaign-entry-card__password-label"
                                    >
                                        The character you will play with
                                    </label>

                                    <select
                                        id="campaign-character-<%= campaign._id %>"
                                        name="charID"
                                        class="campaign-entry-card__character-select"
                                        required
                                        <%= campaign.availableCharacters.length ? "" : "disabled" %>
                                    >
                                        <option value="" selected disabled>
                                            <%= campaign.availableCharacters.length
                                                ? "Alege un personaj"
                                                : "Nu ai personaje disponibile" %>
                                        </option>
                                        <% campaign.availableCharacters.forEach(function(character) { %>
                                            <option value="<%= character._id %>">
                                                <%= character.charName || "Personaj fără nume" %>
                                            </option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="campaign-entry-card__password-field">

                                    <label
                                        for="campaign-password-<%= campaign._id %>"
                                        class="campaign-entry-card__password-label"
                                    >
                                        Join password
                                    </label>

                                    <div class="campaign-entry-card__input-wrap">

                                        <span
                                            class="campaign-entry-card__input-icon"
                                            aria-hidden="true"
                                        >
                                            ◆
                                        </span>

                                        <input
                                            id="campaign-password-<%= campaign._id %>"
                                            name="joinPassword"
                                            type="password"
                                            class="campaign-entry-card__password-input"
                                            placeholder="Enter password"
                                            autocomplete="off"
                                        >

                                    </div>

                                </div>


                                <div class="campaign-entry-card__buttons">

                                    <button
                                        type="submit"
                                        class="campaign-entry-card__button campaign-entry-card__button--join"
                                        <%= campaign.availableCharacters.length ? "" : "disabled" %>
                                    >
                                        <span aria-hidden="true">+</span>
                                        Join
                                    </button>

                                    <a
                                        href="/dnd/dmOverview/<%= campaign._id %>"
                                        class="campaign-entry-card__button campaign-entry-card__button--view"
                                    >
                                        View
                                    </a>

                                </div>

                            </form>

                        </div>

                    </article>
                <% }); %>
            <% } else { %>
                <div class="characters-grid__placeholder">

                

                <div class="characters-grid__placeholder-icon">
                    ◈
                </div>

                <strong>
                    Nu ai creat încă nicio campanie
                </strong>

                <span>
                    Creează o campanie pentru a începe configurarea ei.
                </span>

            </div>

            <% } %>

        </section>



        <!-- =================================================
             EMPTY SEARCH STATE
        ================================================== -->

        <section
            class="characters-empty"
            id="charactersEmpty"
            hidden
        >

            <div class="characters-empty__icon">
                ⌕
            </div>

            <h2>
                No campaigns found
            </h2>

            <p>
                No campaign matches your current search.
            </p>

            <button
                type="button"
                class="characters-empty__button"
                id="charactersEmptyReset"
            >
                Clear Search
            </button>

        </section>



        <!-- =================================================
             BOTTOM CREATE BUTTON
        ================================================== -->

        <div class="characters-create-area">

            <span class="characters-create-area__line"></span>

            <form
                action="/<%= userId %>/dnd/myCampaigns"
                method="POST"
                class="characters-create-form"
            >
                <button type="submit" class="characters-create-button">
                    <span class="characters-create-button__icon">+</span>
                    <span>Creează campanie</span>
                </button>
            </form>

            <span class="characters-create-area__line"></span>

        </div>

    </main>

</div>





    
  <script src="/js/dnd/MyCharList_script.js"></script>
  <script src="/js/dnd/charactersToolbar.js"></script>
  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  
</body>
</html>
