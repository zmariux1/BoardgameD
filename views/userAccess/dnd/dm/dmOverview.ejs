                    <% } %>

                </div>


                <!-- FOOTER -->

                <footer class="pendingItems_footer">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Idle items are hidden from players until made visible.
                    </span>

                </footer>

            </section>
         </div>
