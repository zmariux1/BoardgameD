                data-is-campaign-owner="<%= isOwner ? 'true' : 'false' %>"
                data-can-create="<%= canCreateQuest ? 'true' : 'false' %>"
                data-current-user-id="<%= currentUserId %>"
                data-participants="<%= JSON.stringify(charParticipantsDetails.map(({ charID, character }) => ({ id: String(charID), name: character ? character.charName : 'Character' }))) %>"
