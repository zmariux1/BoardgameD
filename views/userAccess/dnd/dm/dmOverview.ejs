                <div id="transferItems-modal-overlay" class="transferItems-modal-overlay ">

                    <form
                        id="transferItems-modal"
                        class="transferItems-modal"
                        action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : '' %>/pending-items"
                        method="POST"
                        data-can-save="<%= canManagePendingItems ? 'true' : 'false' %>"
                        data-can-transfer="<%= canTransferItems ? 'true' : 'false' %>"
                        data-transfer-action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : '' %>/transfer-items"
                    >

                        <!-- HEADER -->
                        <header class="transfer-modal__header">

                            <div class="transfer-modal__heading">

                                <h2 class="transfer-modal__title" data-items-title>
                                    Prepare session items
                                </h2>

                                <span class="transfer-modal__target-label">
                                    <%= selectedSession ? (selectedSession.name || 'Selected session') : 'No session selected' %>
                                </span>
                                <div class="transfer-modal__target transfer-items-target" hidden>
                                    <span class="transfer-modal__target-label">To:</span>
                                    <select
                                        class="transfer-modal__target-name transfer-modal__target-select"
                                        aria-label="Select recipient character"
                                    >
                                        <% const transferTargets = activeEncounterCombatants.filter((combatant) =>
                                            combatant.type === "character"
                                        ); %>
                                        <% transferTargets.forEach((combatant) => { %>
                                            <option value="<%= combatant.charID %>">
                                                <%= combatant.character?.charName || "Personaj fără nume" %>
                                            </option>
                                        <% }); %>
                                        <% if (!transferTargets.length) { %>
                                            <option value="" selected disabled>No active characters</option>
                                        <% } %>
                                    </select>
                                </div>

                            </div>

                            <button
                                type="button"
                                class="NotesExistJS transfer-modal__close"
                                aria-label="Close"
                            >
                                &times;
                            </button>

                        </header>


                        <!-- transferS -->
                        <div class="transferItems-modal__content">

                            <p class="pending-items-message" role="status" aria-live="polite"></p>
                            <div class="pending-items-filters">
                                <label class="pending-items-filter">
                                    <span>Search items</span>
                                    <input
                                        type="search"
                                        class="pending-items-search"
                                        placeholder="Search by name..."
                                        autocomplete="off"
                                    >
                                </label>
                                <label class="pending-items-filter">
                                    <span>Category</span>
                                    <select class="pending-items-category">
