const mongoose = require("mongoose");
const User = require("../../models/userModel");

const dndHomeLoad = async (req, res) => {
  const { userId } = req.params;

  if (!req.session.user_id) {
    return res.redirect("/login");
  }

  if (
    !mongoose.Types.ObjectId.isValid(userId) ||
    req.session.user_id.toString() !== userId.toString()
  ) {
    return res.status(403).send("Unauthorized");
  }

  try {
    const userExists = await User.exists({ _id: userId });
    if (!userExists) {
      return res.status(404).send("Utilizatorul nu a fost găsit.");
    }

    return res.render("userAccess/dnd/dndHome", {
      userId,
      pageTitle: "D&D Home"
    });
  } catch (error) {
    console.error("[DND HOME] load error:", error);
    return res.status(500).send("Eroare la încărcarea paginii D&D.");
  }
};

module.exports = { dndHomeLoad };