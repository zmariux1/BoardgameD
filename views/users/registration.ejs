<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login / Signup Page</title>
    <style>
        body {
          font-family: Arial, sans-serif;
          
          margin: 0;
          padding: 0;
          height: 100vh;
          position: relative;
          background-image: url('../img/colaj.jpg');
          background-size: cover;
          /* background-position: top center; */
          background-position: top center;
          background-attachment: fixed;
        }

        :root {
          --bodyC: #F8F6F0;
          --headerC: linear-gradient(135deg, rgb(145, 109, 179), rgb(253, 229, 236));
          --Buttons: linear-gradient(135deg, purple, #333);
          --theOwnerC: #F5F5F5;
          --casete: #49413F;
          --participantsC: linear-gradient(165deg, black, #333);
          --inviteDetailsC: linear-gradient(135deg, #000, #333);;
        }

        header{
          background: var(--headerC);
          display: flex;
          justify-content: end;
          height: 50px;
          align-items: center;
          z-index: 109;
          position: relative;
        }

        .account_not_connected{
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
          margin-right: 20px;
        }

        .paragraph0{
          margin: 0px;
        }

        .container {
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          background-color: rgb(253, 229, 236);
          border-radius: 5px;
          box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
          text-align: center;
          padding: 20px;
          width: 320px;
        }

        h1 {
          font-size: 24px;
        }

        .tabs {
          display: flex;
          justify-content: space-between;
          margin-bottom: 20px;
        }

        .tab {
          flex-grow: 1;
          cursor: pointer;
          padding: 10px;
          border: 1px solid #ccc;
          border-radius: 5px 5px 0 0;
        }

        .tab.active {
          background-color: #007bff;
          color: #fff;
        }

        .tab-content {
          display: none;
        }

        .tab-content.active {
          display: block;
        }

        .register_div{
          margin-bottom: 13px;
          height: 162px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
        }

        .tab-content  .email,
        .tab-content  .confirmPassword {
          width: 90%;
          padding: 10px;
          margin: 0px 0;
          border: 1px solid #ccc;
          border-radius: 0px;
          border-top-left-radius: 5px;
          border-top-right-radius: 5px;
        }

        .tab-content  .phone{
          width: 90%;
          padding: 10px;
          margin: 0px 0;
          border: 1px solid #ccc;
          border-radius: 0px;
        }

        .tab-content  .yourName,
        .tab-content  .password {
          width: 90%;
          padding: 10px;
          margin: 0px 0;
          border: 1px solid #ccc;
          border-radius: 0px;
          border-bottom-left-radius: 5px;
          border-bottom-right-radius: 5px;
          margin-bottom: 7px;
        }

        .pushUD {
          padding: 20px 0px;
          align-items: center;
        }
        input[type="file"]{
          display: none;
          outline: none;
          box-sizing: border-box;
        }
        .uploadImg_lbl{
          outline: none;
          box-sizing: border-box;
          text-transform: uppercase;
          background: linear-gradient(135deg, rgba(197, 138, 197, 0.8), rgba(247, 247, 247, 1));
          color: rgb(0, 0, 0);
          text-align: center;
          padding: 10px 15px;
          /* font-size: 16px; */
          letter-spacing: 1.5px;
          user-select: none;
          cursor: pointer;
          box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.35);
          border-radius: 3px; 
          transition: ease 0.6s;
        }

        .uploadImg_lbl i{
          font-size: 20px;
          margin-right: 10px;
        }

        .uploadImg_lbl:hover{
          background: linear-gradient(135deg,  rgba(255, 255, 255, 1), rgba(197, 138, 197, 0.8));
          transform: scale(0.9);
          transition: ease 0.6s;
        }
        .uploadImg_lbl:active{
          background: linear-gradient(135deg,  rgba(207, 162, 207, 0.801), rgba(207, 162, 207, 0.801));
          color: #363535;
          transform: scale(0.9);
          transition: ease 0.6s;
        }

        button {
          background-color: #007bff;
          color: #fff;
          border: none;
          border-radius: 5px;
          padding: 10px 20px;
          cursor: pointer;
          font-size: 16px;
        }

        button:hover {
          background-color: #0056b3;
        }

        .switch {
          margin-top: 10px;
        }

        .switch a {
          text-decoration: none;
          color: #007bff;
        }

        .switch a:hover {
          text-decoration: underline;
        }
    </style>
</head>
<body>
  <header class="navBar">
    <div class="account_not_connected"> 
      <a href="/login" class="login paragraph0">Login</a>
      <a href="/register" class="signup paragraph0">Signup</a>
    </div>
  </header>


  <div class="container">
    <h1>Register</h1>
    <h5>By clicking Sign Up, you agree to our <a href="/legal/terms">Terms</a>. 
      Learn how we process your data in our <a href="/legal/privacy_policy">Privacy Policy</a> 
      and <a href="/legal/cookie_policy">Cookie Policy</a>.
    </h5>
    <!-- <div class="tabs">
      <div class="tab active" id="loginTab">Login</div>
      <div class="tab" id="signupTab">Sign Up</div>
    </div> -->
    <!-- <div class="tab-content active" id="loginContent">
      <form action="login" method="post">
        <div class="register_div">
          <input type="email" placeholder="Email" class="email" id="email" name="email" required>
          <input type="password" placeholder="Password" class="password" id="password" name="password" required>
        </div>
          <button type="submit">Login</button>
      </form>
    </div> -->
    <div class="tab-content active" id="signupContent">
      <!-- de aici am scos si auth -->
      <form action="/register" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
          <input type="email" placeholder="Email" class="form-control email" id="email" name="email" aria-describedby="emailHelp" autocomplete="off" required>
        </div>
        <div class="mb-3">
          <input type="tel" pattern="[0-9]{10}" placeholder="Your Phone Number. eg: 07xxxxxxxx" class="form-control phone" id="phone" name="phone" aria-describedby="phoneHelp" autocomplete="off"  required>
        </div>
        <div class="mb-3">
          <input type="text" placeholder="Your UserName" class="form-control yourName" id="yourName" name="yourName" aria-describedby="yourNameHelp" autocomplete="off" required pattern="[a-zA-Z0-9]*" title="Please enter only letters and numbers">
        </div>
        <div class="mb-3 pushUD">
          <input type="file" id="uploadImg" name="image"  accept="image/*" required>
          <label class="uploadImg_lbl" for="uploadImg"><i class="fa-solid fa-upload"></i>Upload Image</label>
        </div>
        <div class="mb-3 ">
          <input type="password" placeholder="Password" class="form-control password" id="password" name="password" aria-describedby="passwordHelp" autocomplete="off" required>
        </div>
        <% if (error) { %>
          <p style="color: red"><%- error %></p>

        <% } %>
        <h5 style="color: rgb(92, 0, 0);">Do not lose your password, as you won't have the option to recover/change it</h5>
        <button type="submit" class="btn btn-primary" value="Register">Sign Up</button>
      </form>

      <% if(typeof message !== "undefined"){%>
          <p style="color: green"><%= message %></p>
      <% }%>






    </div>

    <div class="switch">
      <p>Already have an account? <a href="/login">Login</a></p>
      <!-- <p><a href="/login">Login</a> OR <a href="/forgot">Reset Password</a></p>       -->
      
    </div>
  </div>


  <script>
    // Let the user know that the image has been uploaded 
    function updateUploadLabel(input) {
      const label = input.parentElement.querySelector('.uploadImg_lbl');
      if (input.files.length > 0) {
        label.textContent = `${input.files.length} image${input.files.length > 1 ? 's' : ''} uploaded`;
      } else {
        label.textContent = 'Upload Image';
      }
    }
  </script>
  
    <script>
      if (message) {
          document.querySelector(".container").innerHTML += `<h4 class="alert alert-danger mt-4">${message}</h4>`
      }
  </script>
  <script src="js/register.js"></script>
</body>
</html>
