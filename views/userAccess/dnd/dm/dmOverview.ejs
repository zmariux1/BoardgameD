                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="9" cy="8" r="3.5"/>
                                <path d="M2.5 21c.6-4 2.7-6 6.5-6s5.9 2 6.5 6"/>
                                <circle cx="17.5" cy="10" r="2.5"/>
                                <path d="M15.5 15.5c2.7.2 4.6 1.8 5.2 4.5"/>
                            </svg>
                        </div>

                        <div class="questModal-metaContent">
                            <span class="questModal-label">
