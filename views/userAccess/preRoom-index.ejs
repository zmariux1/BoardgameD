<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="/img/title/titleIcon65.png">

    <link rel="stylesheet" href="/css/preRoom-style.css">
    <link rel="stylesheet" href="/css/elements/header.css">
    <link rel="stylesheet" href="/css/elements/botNavBar.css">
    <link rel="stylesheet" href="/css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>
  <%- include('../layouts/header') %>
  
  <div class="listControl">
    <input type="checkbox">
    <i class="fa-solid fa-circle-plus" style="color: #4173c8;"></i>
    <i class="fa-regular fa-calendar-days" style="color: #121b2b;"></i>
    <i class="fa-solid fa-users-slash" style="color: #111722;"></i>
    <i class="fa-solid fa-trash-can" style="color: #0c1018;"></i>
    <button id="cloneButton">Clone</button>
  </div>



</a>



<div class="display_organizer_position">
  <div class="display_organizer">
    <button class="css_display_organizer_btn host_btn">
      <i class="fa-solid fa-house-user fa-lg"></i>
      <p>Host</p>
    </i></button>
    <button class="css_display_organizer_btn guest_btn">
      <i class="fa-solid fa-person-walking-luggage fa-lg"></i>
      <p>Guest</p>
    </button>
  </div>
</div>



  <% if (userRooms && userRooms.length > 0) { %>
  <!-- My Rooms section all  -->
  <div class="botPad">
    <ul id="inqiu" class="myRooms_sections host_section">
      <h3>The list of invites you created</h3>
      <% userRooms.forEach(userRoom => { %>
        <li id="originalDiv"  > <a class="aRoom-MainBox" href="/room/<%= userRoom._id %>">
          
          <i class="fa-solid fa-volume-xmark muteNotifications" style="color: #0c1018; "></i>
          <div class="purpuse">
            <div class="check-div">
              <i class="fa-solid fa-house-user fa-lg"></i>
            </div>
            <ul class="boardgameList-div">
              <% userRoom.theBoardgames_name.forEach(boardgameName => { %>
                <li><%= boardgameName %></li>
              <% }); %>
            </ul>
          </div>
          <div class="mettingDetails-box">
            <div class="mettingDetails-box-top screen">
              <div class="date-div mettingDetails-div">
                <p class="date mettingDetails-text">Date
                  <% userRoom.notification.forEach(notif => { %>
                    <!-- verifica daca se potriveste motivul sau categoria  -->
                    <% if (notif.reason == "date") { %>
                      <!-- acceseaza lista de user care au vazut  -->
                      <% notif.notificationStatus.forEach(userStat => { %>
                        <!-- verifica daca se potriveste cu userul curent  -->
                        <% if (userStat.participantID.toString() == user._id.toString()) { %>
                          <i class="fa-solid fa-circle fa-2xs notificationDot" ></i>
                        <% } %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                </p>
                
                <p class="date mettingDetails-text"><%= userRoom.selectedDate %></p>
              </div>
              <div class="time-div mettingDetails-div">
                <p class="time mettingDetails-text">Time
                  <% userRoom.notification.forEach(notif => { %>
                    <!-- verifica daca se potriveste motivul sau categoria  -->
                    <% if (notif.reason == "time") { %>
                      <!-- acceseaza lista de user care au vazut  -->
                      <% notif.notificationStatus.forEach(userStat => { %>
                        <!-- verifica daca se potriveste cu userul curent  -->
                        <% if (userStat.participantID.toString() == user._id.toString()) { %>
                          <i class="fa-solid fa-circle fa-2xs notificationDot" ></i>
                        <% } %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                </p>
                
                <p class="time mettingDetails-text"><%= userRoom.selectedTime %></p>
              </div>
              <div class="players-div mettingDetails-div">
                <p class="players mettingDetails-text">Players
                  <i class="fa-solid fa-circle fa-2xs notificationDot"></i>
                </p>
                
                <p class="players mettingDetails-text"><%= userRoom.joined_guest.length %>/<%= userRoom.numberOfInvites %></p>
              </div>
              <div class="chat-div mettingDetails-div">
                <i class="customChatIcon fa-regular fa-comment">
                  <% userRoom.notification.forEach(notif => { %>
                    <!-- verifica daca se potriveste motivul sau categoria  -->
                    <% if (notif.reason == "new_msg") { %>
                      <!-- acceseaza lista de user care au vazut  -->
                      <% notif.notificationStatus.forEach(userStat => { %>
                        <!-- verifica daca se potriveste cu userul curent  -->
                        <% if (userStat.participantID.toString() == user._id.toString()) { %>
                          <i class="fa-solid fa-circle fa-2xs notificationDotChat"></i>
                        <% } %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                </i>
              </div>
            </div>
            
            <div class="mettingDetails-box-top mobile">
              <div class="date-div mettingDetails-div">
                <p class="date mettingDetails-text">Date: </p>
                
                <p class="date mettingDetails-text relative"><%= userRoom.selectedDate %>
                  <% userRoom.notification.forEach(notif => { %>
                    <!-- verifica daca se potriveste motivul sau categoria  -->
                    <% if (notif.reason == "date") { %>
                      <!-- acceseaza lista de user care au vazut  -->
                      <% notif.notificationStatus.forEach(userStat => { %>
                        <!-- verifica daca se potriveste cu userul curent  -->
                        <% if (userStat.participantID.toString() == user._id.toString()) { %>
                          <p class="notificationDot position1">.</p>
                        <% } %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                </p>
              </div>
              <div class="time-div mettingDetails-div">
                <p class="time mettingDetails-text">Time: </p>
                
                <p class="time mettingDetails-text relative"><%= userRoom.selectedTime %>
                  <% userRoom.notification.forEach(notif => { %>
                    <!-- verifica daca se potriveste motivul sau categoria  -->
                    <% if (notif.reason == "time") { %>
                      <!-- acceseaza lista de user care au vazut  -->
                      <% notif.notificationStatus.forEach(userStat => { %>
                        <!-- verifica daca se potriveste cu userul curent  -->
                        <% if (userStat.participantID.toString() == user._id.toString()) { %>
                          <p class="notificationDot position2">.</p>
                        <% } %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                </p>
              </div>
              <div class="players-div mettingDetails-div">
                <p class="players mettingDetails-text">Players: </p>
                
                <p class="players mettingDetails-text relative"><%= userRoom.joined_guest.length %>/<%= userRoom.numberOfInvites %>
                  <p class="notificationDot position3">.</p>
                </p>
              </div>
              <div class="chat-div mettingDetails-div">
                <i class="fa-regular fa-comment relative">
                  <% userRoom.notification.forEach(notif => { %>
                    <!-- verifica daca se potriveste motivul sau categoria  -->
                    <% if (notif.reason == "new_msg") { %>
                      <!-- acceseaza lista de user care au vazut  -->
                      <% notif.notificationStatus.forEach(userStat => { %>
                        <!-- verifica daca se potriveste cu userul curent  -->
                        <% if (userStat.participantID.toString() == user._id.toString()) { %>
                          <p class="notificationDot position4">.</p>
                        <% } %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                </i>
              </div>
            </div>
            <div class="mettingDetails-box-bot">
              <p class="location">Location: <%= userRoom.location %>
                <% userRoom.notification.forEach(notif => { %>
                  <!-- verifica daca se potriveste motivul sau categoria  -->
                  <% if (notif.reason == "location") { %>
                    <!-- acceseaza lista de user care au vazut  -->
                    <% notif.notificationStatus.forEach(userStat => { %>
                      <!-- verifica daca se potriveste cu userul curent  -->
                      <% if (userStat.participantID.toString() == user._id.toString()) { %>
                        <i class="fa-solid fa-circle fa-2xs notificationDotChat"></i>
                      <% } %>
                    <% }); %>
                  <% } %>
                <% }); %>
              </p>
              
            </div>


          </div>
        </a></li>
      <% }); %>
    </ul>
  </div>

  <% } else { %>
    <p>You haven't created any invites yet, so none can be seen</p>
  <% } %>









