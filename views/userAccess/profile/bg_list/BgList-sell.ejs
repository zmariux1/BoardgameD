<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="img/title/titleIcon65.png">

    <link rel="stylesheet" href="css/ownerBdList.css">
    <link rel="stylesheet" href="css/elements/header.css">
    <link rel="stylesheet" href="css/elements/botNavBar.css">
    <link rel="stylesheet" href="css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>
  <%- include('../../../layouts/header') %>



  <!-- profile section  -->

  <section class="thePage">
      <div class="container">
        <p class="pageTitle">Board games I want to sell</p>
        <div class="deeperSearchMsg">
          <h5 class="hiddenText activeText">Hint: Activate <i class="fa-solid fa-magnifying-glass-plus fa-sm"></i> to extend your search</h5>
          <h5 class="hiddenText">Note: The advanced search <i class="fa-solid fa-magnifying-glass-plus fa-sm"></i> takes 5 seconds more for every 15 games found</h5>
        </div>
        <div class="contariner_search_div">
          <button class="customTriggerAdvanced"><i class="fa-solid fa-magnifying-glass-plus"></i></button>
          <div class="search_div">
            <form action="/addSellBG" method="post" class="search_form activeForm">
              <input type="search" name="simple_searchBg" class="input-simpleSearchBg" placeholder="Quick Search"> 
              <button type="submit" name= "searchBg" class="btn-searchBg"><i class="custom_icon fa-solid fa-magnifying-glass search-icon"></i></button>
            </form>
            <form action="/addSellBG" method="post" class="search_form">
              <input type="search" name="searchBg" class="input-advancedSearchBg" placeholder="Advanced Search"> 
              <button type="submit" name= "searchBg" class="btn-searchBg"><i class="custom_icon fa-solid fa-magnifying-glass search-icon"></i></button>
            </form>
          </div>
        </div>

        <div class="tab-content" >
          <!-- de aici am scos si auth -->
      
          <section class="form_bgList_with_Submit">
            <div class="bgList_with_Submit">
              <ul class="bgList_without_Submit_subSelect">
      
      
                <% if (results && results.length > 0) { %>
                  <% results.forEach((game) => { %>
                    <form class="aBoardgame" action="/addSellBG" method="post" >
                      <!-- incepe - conditia de displa  -->
                      <% let matchFound = false; %>
                      <% sell_bg.sell_boardgames_ID.forEach((sell_Game) => { %>
                        <% if (sell_Game.objectid == game.objectid) { %>
                          <% matchFound = true; %>
                        <% } %>
                      <% }); %>
              
                      <% if (matchFound) { %>
                        
                        <div class="sizeCap_div">
                          <img class="sizeCap" src="<%= game.thumbnail %>" alt="">
                        </div>
                        <div class="bg_names_div" >
                          <p class="idleGreen" style="color: #3cb64d; ">
                            <input type="checkbox" class="hideMe boardgame-checkbox" id="theBoardgames_id" name="bg_thumbnail" value="<%= game.thumbnail %>">
                            <input type="checkbox" class="hideMe boardgame-checkbox" id="theBoardgames_id" name="bg_yearPublished" value="<%= game.yearPublished %>">
                            <input type="checkbox" class="hideMe boardgame-checkbox" id="theBoardgames_id" name="bg_id" value="<%= game.objectid %>">
                            <input type="checkbox" class="hideMe boardgame-checkbox autoCheckName" id="theBoardgames_name" name="bg_name" value="<%= game.name %>">
                            <span class="gameTitle"><%= game.name %> </span > <span class="gameTitle">(<%= game.yearPublished %>)</span>
                          </p>
                        </div>
                        <div class="submit_div">
                          <!-- <button type="button" class="submitButton submitButtoncss activeButton" onclick="checkAllCheckboxes(this)">+</button> -->
                          <p class="item_checked default_checked" ><i class="fa-solid fa-check" style="color: #3cb64d; "></i></p>
                          <!-- <button type="submit" name="submitBtn" value="" class="hideMe send" ></button> -->
                        </div>
                      <% } else { %>
                        
                        <div class="sizeCap_div">
                          <img class="sizeCap" src="<%= game.thumbnail %>" alt="">
                        </div>
                        <div class="bg_names_div" >
                          <p class="idleGreen">
                            <input type="checkbox" class="hideMe boardgame-checkbox" id="theBoardgames_id" name="bg_thumbnail" value="<%= game.thumbnail %>">
                            <input type="checkbox" class="hideMe boardgame-checkbox" id="theBoardgames_id" name="bg_yearPublished" value="<%= game.yearPublished %>">
                            <input type="checkbox" class="hideMe boardgame-checkbox" id="theBoardgames_id" name="bg_id" value="<%= game.objectid %>">
                            <input type="checkbox" class="hideMe boardgame-checkbox autoCheckName" id="theBoardgames_name" name="bg_name" value="<%= game.name %>">
                            <span class="gameTitle"><%= game.name %> </span > <span class="gameTitle">(<%= game.yearPublished %>)</span>
                          </p>
                        </div>
                        <div class="submit_div">
                          <button type="button" class="submitButton submitButtoncss activeButton" onclick="checkAllCheckboxes(this)">+</button>
                          <p class="item_checked " ><i class="fa-solid fa-check" style="color: #63E6BE;"></i></p>
                          <button type="submit" name="submit_createRoom" value="ceva" class="hideMe send" ></button>
                        </div>
                      <% } %>
                      <!-- end - conditia de displa  -->

                    </form>
                  <% }); %>
                <% } else { %>
                  <p>No board games found.</p>
                <% } %>
      
      
      
                </ul>
              
            </section>


          </form>
        </div>
      
        
        </ul>
        <a href='/userProfile-Bg/<%= userSession._id %>'class="returnBtn">Return to your list</a>
      </div>
      
  </section>
  
  
  









  <div id="loadingPopup" class="loading-popup">
    <div id="countdown" class="countdown"></div>
  </div>






  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon " 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
  </div>





  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script src="js/addBGProfileList-script.js"></script>
  <script src="js/header.js"></script>
</body>
</html>