                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--protection">
                                            ⛨
                                        </span>

                                        <span class="transfer-option__name">
                                            Protection from Evil
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--shield">
                                            ⛨
                                        </span>

                                        <span class="transfer-option__name">
                                            Shield
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--true-seeing">
