<% if (userSession) { %>

  <nav class="navBar_top header" id="myHeader">
    <div class="div-icon-recentGames hideInMobile">
      <button > <a href="/index"><i class="fa-solid fa-star"></i></a> </button>
      <!-- <button id="toggleButton"> <i class="fa-solid fa-star"></i> </button> -->
      
    </div>
    <div class="twoColorNav hideInMobile">
      <div  class="twoColorNav_Top"><br></div>
      <div class="twoColorNav_Bot">
        <div class="twoColorNav_left"></div>
        <div class="twoColorNav_center"></div>
        <div class="twoColorNav_right"></div>
      </div>
    </div>

    <div class="mid_header"> 
      <form>
        <!-- <input type="text" name="search" class="searchLocation" autocomplete="off" placeholder=" Search your area &#x1F50D;"> -->
      </form>
      <!-- <a href="/about">About us</a> -->
      <a href="/feedbackus">Feedback</a>
    </div>

    <div class="twoColorNav">
      <div  class="twoColorNav_Top"><br></div>
      <div class="twoColorNav_Bot">
        <div class="twoColorNav_left"></div>
        <div class="twoColorNav_center"></div>
        <div class="twoColorNav_right"></div>
      </div>
    </div>
    
    <div class="the_account_in_header">
      <div class="account_connected"> 

        <div class="all_notif">
          <div class="notification_div">
            <i class="custom_bell fa-regular fa-bell fa-lg"></i>
          </div>
          <div class="notification_container">

            <% if (allPages_RoomNotif && allPages_RoomNotif.length > 0) { %>
              <% allPages_RoomNotif.forEach(room => { %>
          
                <% room.notification.forEach(notif => { %>
                  <!-- verifica daca se potriveste motivul sau categoria  -->
                  <% if (notif.reason == "time" || notif.reason == "date" || notif.reason == "location" || notif.reason == "boardGame" || notif.reason == "new_msg") { %>
                    
                    <!-- acceseaza lista de user care au vazut  -->
                    <% notif.notificationStatus.forEach(userStat => { %>
                      <!-- verifica daca se potriveste cu userul curent  -->
                      <% if (userStat.participantID.toString() == user._id.toString()) { %>
                        <% if (userStat.theActualNotifItem == "new_time" || userStat.theActualNotifItem == "new_date" || userStat.theActualNotifItem == "new_location" || userStat.theActualNotifItem == "new_boardGame" || userStat.theActualNotifItem == "new_msg" ) { %>
                          <div class="theNotifItem_div">
                            <a href="http://localhost:5000/room/<%= notif.from_place %>">This invite has a new <b><%= notif.type %></b> related to the <b><%= notif.reason %></b> </a>
                          </div>
                        <% } %>
                      <% } %>
                    <% }); %>
                  <% } %>
                <% }); %>
          
              <% }); %>
            <% } else { %>
              <!-- <p>No notification found</p> -->
            <% } %>

            <!-- generate list of notifications -->
            <% if (notifications && notifications.length > 0) { %>
              <% notifications.forEach(notification => { %>
                <% if (notification.type == "stain") { %>
                  <div class="theNotifItem_div">
                    <p >A player has reported your <a href="/userProfile-Reputation/<%= user._id %>"> <%= notification.reason %> </a> of a gathering invite. Certain stain/report (usually related with the security of the other participants), may lead to account deactivation. <br> Read more in our <b><a href="/legal/community_guidelines">Community Guidelines</a> and <a href="/legal/terms">Terms of Use</a> </b></p>
                  </div> 
                <% } %>

                <% if (notification.type == "legal") { %>
                  <div class="theNotifItem_div">
                    <p>Check the <b><a href="">list of invites</a></b> where you participate, as you have an xxx update</p>
                  </div>
                <% } %>

              <% }) %>
            <% } else { %>
                <p>No notification found</p>
            <% } %>


          </div>
        </div>
        <div class="header_div_pic">
            <img class="header_pic" src="/userImages/<%= userSession.images %>" alt="">
            <!-- <img class="overlay_grey_pic" src="img/user/profileGuest.png" alt=""> -->
        </div>
        <div class="header_user_div_text">
            <ul class="navbar-nav">
              <%if (user){%>
                <p class="header_username paragraph0"><%= userSession.yourName%> </p>
                <li class="nav-item usersetting"><a class="nav-link paragraph0" href="/editProfile" >Profile</a></li>
                <li class="nav-item nodot "><a class=" logout paragraph0" href="/logout" >Logout</a></li>
                <%} else {%>
                  <li class="nav-item nodot"><a href="/register" class="nav-link">Register</a></li>
                  <li class="nav-item nodot"><a href="/login" class="nav-link">Login</a></li>
                  <%}%>
            </ul>
        </div>
        <!-- <div class="languages_div">
          <img class="lang_icon" src="img/Lang/Ro.png" alt="">
          <img class="lang_icon" src="img/Lang/Eng.png" alt="">
        </div> -->
      </div>
    
    </div>
  </nav>
  <% } else { %>

    <nav class="navBar_top header" id="myHeader">
      <div class="div-icon-recentGames">
        <button id="toggleButton"> <i class="fa-solid fa-star"></i> </button>
        
      </div>
      <div> 
        <form>
          <input type="text" name="search" class="searchLocation" placeholder=" Search your area &#x1F50D;">
        </form>
      </div>
      <div class="the_account_in_header">
        <div class="account_connected"> 
          <div class="rightLine">r</div>
          <div class="header_div_pic">
              <img class="header_pic" src="/userImages/<%= user.images %>" alt="">
              <!-- <img class="overlay_grey_pic" src="img/user/profileGuest.png" alt=""> -->
          </div>
          <div class="header_user_div_text">
              <ul class="navbar-nav">
                <%if (user){%>
                  <p class="header_username paragraph0"><%= user.yourName%> </p>
                  <li class="nav-item usersetting"><a class="nav-link paragraph0" href="/editProfile" >Profile</a></li>
                  <li class="nav-item nodot "><a class=" logout paragraph0" href="/logout" >Logout</a></li>
                  <%} else {%>
                    <li class="nav-item nodot"><a href="/register" class="nav-link">Register</a></li>
                    <li class="nav-item nodot"><a href="/login" class="nav-link">Login</a></li>
                    <%}%>
    
              </ul>
          </div>
          <!-- <div class="languages_div">
            <img class="lang_icon" src="img/Lang/Ro.png" alt="">
            <img class="lang_icon" src="img/Lang/Eng.png" alt="">
          </div> -->
        </div>
      
      </div>
    </nav>
  <% } %>





