<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    

    <link rel="icon" href="img/title/">

    <link rel="stylesheet" href="/css/theRoom-style.css">
    <link rel="stylesheet" href="/css/elements/header.css">
    <link rel="stylesheet" href="/css/elements/botNavBar.css">
    <link rel="stylesheet" href="/css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
</head>
<body>
  <%- include('../layouts/header') %>






  <% if (userRooms && userRooms.length > 0) { %>
    <% userRooms.forEach(room => { %>
      <div class="container">
        <div class="allPlayers-div">
          <div class="theOwner">
            <div class="userIDOwner">
              <div class="avatarImgOwner">
                <img class="profileGuest" src="/userImages/<%= room.user.images %>">
              </div>
              <div class="reputationBoxOnwer">
                <div class="honorsOwner">
                  <div class="honors">
                    <% const owner_matchingUserPlus2 = userPlus.find(up => up.userLink.toString() === room.user._id.toString()); %>
                    <% if (owner_matchingUserPlus2) { %>
                      <% const owner_goodReputationItems = owner_matchingUserPlus2.reputation.filter(item => item.type === 'Good'); %>
                      <% if (owner_goodReputationItems.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffledGoodReputation = owner_goodReputationItems.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffledGoodReputation.slice(0, 3).forEach(item => { %>
                          <div class="honorOwner">
                            <img src="/img/reputation/<%= item.type %>/<%= item.category %>/<%= item.subCategory %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } else { %>
                      <% } %>
                    <% } else { %>
                    <% } %>
                  </div>

                </div>
                <div class="redFlagsOwner">

                  <!-- Find matching userPlusData -->
                  <% const owner_matchingUserPlus = userPlus.find(up => up.userLink.toString() === room.user._id.toString()); %>
                  <% if (owner_matchingUserPlus) { %>
                    <% const owner_badReputationItems = owner_matchingUserPlus.reputation.filter(item => item.type === 'Bad'); %>
                    <% if (owner_badReputationItems.length > 0) { %>
                      <!-- Shuffle the badReputation array -->
                      <% const owner_shuffledBadReputation = owner_badReputationItems.sort(() => Math.random() - 0.5); %>
                      <% owner_shuffledBadReputation.slice(0, 2).forEach(item => { %>
                        <div class="flagOwner">
                          <img src="/img/reputation/<%= item.type %>/<%= item.category %>/<%= item.subCategory %>" class="repProfileIcon">
                        </div>
                      <% }) %>
                    <% } else { %>
                    <% } %>
                  <% } else { %>
                  <% } %>


                </div>
              </div>
            </div>
            <div  class="relative">
              <% let isIdentical = false; %>
              <% if (joinedGuestUsers && joinedGuestUsers.length > 0) { %>
                <% joinedGuestUsers.forEach(guestUser => { %>
                  <%
                    if (guestUser._id.toString() === user._id.toString()) {
                      isIdentical = true;
                    }
                  %>
                <% }); %>
              <% } else { %>
              <% } %>

              <% if (isIdentical ) { %>
                <button class="enable_edit"><i class="fa-solid fa-gear"></i> Enable Edit</button>
                <div  class="absolute">
                  <button class="display_reputation"><i class="fa-brands fa-brave" style="color: #1f0f0f;"></i> Display Reputation</button>
                  <button class="display_remove"><i class="fa-solid fa-trash-can " style="color: #1f0f0f;"></i> Display remove players</button>
                  <% if ( user._id.toString() == room.user._id.toString() ) { %>
                    <button class="display_block"><i class="fa-solid fa-ban"></i> Display block players</button>
                  <% } %>
                </div>
              <% } %>

            </div>

            <div class="inviteDetails">
              <% if (isIdentical ) { %>
                <p class="topSpaceText"><%= room.selectedDate %></p>
                <p class="zeroSpaceText"><%= room.selectedTime %></p>
                <p class="zeroSpaceText">Location: <%= room.location %></p>
                <p class="botSpaceText">Players: <%= room.joined_guest.length %>/<%= room.numberOfInvites %></p>
              <% } %>
            </div>
          </div>

          <div class="theParticipants">

            <% if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) { %>
                <% joinedGuestUsers.forEach(guestUser => { %>
                  <div class="userID ">
                    <div class="avatarImg">
                      <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                      <button type="submit" class="fix_rep_JS clean_btn fix_rep open-add-popup" onclick="checkAllCheckboxes(this)"><i class="custom_icon fa-brands fa-brave fa-2xl" style="color: #1f0f0f;"></i></button>

                      <!-- daca Session User == Owner, grant access to forms -->
                      <% if ( user._id.toString() == room.user._id.toString()) { %>
                        <form action="/removeRoomPlayerUp" method="POST" class="fix_trash">
                          <input type="hidden" name="removePlayer" value="<%= guestUser._id %>" id="">
                          <input type="hidden" name="roomID" value="<%= room._id %>" id="">
                          <button type="submit" class="clean_btn" onclick="checkAllCheckboxes(this)"><i class="custom_icon fa-solid fa-trash-can fa-xl" style="color: #1f0f0f;"></i></button>
                        </form>
                        <form action="/banRoomPlayerUp" method="POST" class="fix_ban">
                          <input type="hidden" name="banPlayer" value="<%= guestUser._id %>" id="">
                          <input type="hidden" name="roomID" value="<%= room._id %>" id="">
                          <button type="submit" class="clean_btn" onclick="checkAllCheckboxes(this)"><i class="custom_icon fa-solid fa-ban fa-xl" style="color: #1f0f0f;"></i></button>
                        </form>

                        <!-- daca Participant == Current session User, grant access to selfRemove -->
                      <% } else if ( guestUser._id.toString() == user._id.toString() ) { %>
                        <form action="/removeRoomPlayerUp" method="POST" class="fix_trash">
                          <input type="hidden" name="removePlayer" value="<%= guestUser._id %>" id="">
                          <input type="hidden" name="roomID" value="<%= room._id %>" id="">
                          <button type="submit" class="clean_btn" onclick="checkAllCheckboxes(this)"><i class="custom_icon fa-solid fa-trash-can fa-xl" style="color: #1f0f0f;"></i></button>
                        </form>
                      <% } else { %>
                      <% } %>


                    </div>
                    <div class="reputationBox">
                      <div class="honors">
                        <% const matchingUserPlus2 = userPlus.find(up => up.userLink.toString() === guestUser._id.toString()); %>
                        <% if (matchingUserPlus2) { %>
                          <% const goodReputationItems = matchingUserPlus2.reputation.filter(item => item.type === 'Good'); %>
                          <% if (goodReputationItems.length > 0) { %>
                            <!-- Shuffle the badReputation array -->
                            <% const shuffledGoodReputation = goodReputationItems.sort(() => Math.random() - 0.5); %>
                            <% shuffledGoodReputation.slice(0, 2).forEach(item => { %>
                              <div class="honor">
                                <img src="/img/reputation/<%= item.type %>/<%= item.category %>/<%= item.subCategory %>" class="repProfileIcon">
                              </div>
                            <% }) %>
                          <% } else { %>
                          <% } %>
                        <% } else { %>
                        <% } %>
                      </div>
                      <div class="redFlags">
                          <!-- Find matching userPlusData -->
                          <% const matchingUserPlus = userPlus.find(up => up.userLink.toString() === guestUser._id.toString()); %>
                          <% if (matchingUserPlus) { %>
                            <% const badReputationItems = matchingUserPlus.reputation.filter(item => item.type === 'Bad'); %>
                            <% if (badReputationItems.length > 0) { %>
                              <!-- Shuffle the badReputation array -->
                              <% const shuffledBadReputation = badReputationItems.sort(() => Math.random() - 0.5); %>
                              <% shuffledBadReputation.slice(0, 1).forEach(item => { %>
                                <div class="flag">
                                  <img src="/img/reputation/<%= item.type %>/<%= item.category %>/<%= item.subCategory %>" class="repProfileIcon">
                                </div>
                              <% }) %>
                            <% } else { %>
                            <% } %>
                          <% } else { %>
                          <% } %>
                      </div>
                    </div>
                  </div>





                  <div class="overlaySearch"></div>
                  <div class="popupSearch">
                    <% if ( guestUser._id.toString() !== userSession._id.toString() && isIdentical) { %>
                      <h5 class="title">How was your interaction with this Player?</h5>
                      <div class="flags">
  
                        <div class="userID">
                          <div class="avatarImg">
                            <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                          </div>
                          <div class="reputationBox">
                            <div class="honors">
                              <div class="honor1">
                                <img>
                              </div>
                              <div class="honor2">
                                <img>
                              </div>
                            </div>
                            <div class="redFlags">
                              <div class="flag1">
                                <img>
                              </div>
                            </div>
                          </div>
                        </div>


                        <!-- Honor  -->
                        <% let avoidDuplicate_honor = true; %>
                        <div class="Verify_if_the_player_is_Honored">
                          <% if (guestUser.honor) { %>
                            <% Object.entries(guestUser.honor).forEach(([category, values]) => { %>
                              <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                <!-- ATTENTIE LA FILTRUL PUS, IN CAZ CA SE MODIFICA MODELUL BAZEI DE DATE!!! -->
                                <% if (['Environment', 'Food & Drinks', 'Gaming Style', 'Personality', 'Good manners'].includes(Categories)) { %>
                                  <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                    <% Object.entries(itemDetails.reportedBy).forEach(([report, nefolositor]) => { %>
                                      <% Object.entries(nefolositor).forEach(([nefolositor2, eachReport]) => { %>
  
                                        <% if (eachReport.whichRoom == room._id && eachReport.userSessionId == userSession._id.toString()) { %> 
                                          <% avoidDuplicate_honor = false; %>
                                        <% } %>
                                        
                                        
                                      <% }); %>
                                    <% }); %>
                                  <% }); %>
                                <% } %>
                              <% }); %>
                            <% }); %>
                          <% } else { %>
                          <% } %>
                        </div>
                        <div class="split">
                          <% if (guestUser.honor && avoidDuplicate_honor === true) { %>
                          <div class="dropdown_rep">
                            <img class="repImgSize" src="/img/reputation/Good/honor.png" alt="">
                            <ul id="myDropdown" class="dropdown-content_rep">
  
  
                              <% Object.entries(guestUser.honor).forEach(([category, values]) => { %>
                                <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                  <!-- ATTENTIE LA FILTRUL PUS, IN CAZ CA SE MODIFICA MODELUL BAZEI DE DATE!!! -->
                                  <% if (['Environment', 'Food & Drinks', 'Gaming Style', 'Personality', 'Good manners'].includes(Categories)) { %>
                                    <!-- generate ejs categories -->
                                    <li class="dropdown_rep_category">
                                      <p  class="dropbtn_rep_category"><%= Categories %></p>
                                      <div id="myDropdown" class="dropdown-content_rep_category">
                                        <!-- generate ejs cat. items -->
                                        <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                          <!-- <li> subCategories:  item %>. It's details:  itemDetails.val %> -  itemDetails.report_title %> -  itemDetails.name %></li> -->
                                          <form action="/room/report" method="POST" class="stretch">
                                            <input type="hidden" name="whichReputationModel" value="honor">
                                            <input type="hidden" name="whoIsReported" value="<%= guestUser._id %>">
                                            <input type="hidden" name="mainCategory" value="<%= Categories %>">
                                            <input type="hidden" name="whichRoom" value="<%= room._id %>">
                                            <input type="hidden" name="userSession" value="<%= user._id %>">
                                            <button type="submit" name="item" value="<%= item %>" ><%= itemDetails.report_title %></button>
                                            
                                          </form>
                                          
                                        <% }); %>
                                      </div>
                                    </li>
                                  <% } %>
                                <% }); %>
                              <% }); %>
                            </ul>
                          </div>
                          <p style="color: rgb(57, 150, 74);">Celebrate and acknowledge the player's excellence and positive impact on the board games community.</p>
                          <% } else { %>
                            <p>The player has been already honored</p>
                          <% } %>
                        </div>


                        <!-- Feedback  -->
                        <% let avoidDuplicate_feedback = true; %>
                        <div class="Verify_if_the_player_is_feedbacked">
                          <% if (guestUser.feedback) { %>
                            <% Object.entries(guestUser.feedback).forEach(([category, values]) => { %>
                              <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                <% if (["Vibe", "Environment", "Discrimination", "Hygiene"].includes(Categories)) { %>
                                  <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                    <% if (itemDetails.reportedBy && typeof itemDetails.reportedBy === 'object') { %>
                                      <% Object.entries(itemDetails.reportedBy).forEach(([report, nefolositor]) => { %>
                                        <% if (nefolositor && typeof nefolositor === 'object') { %>
                                          <% Object.entries(nefolositor).forEach(([nefolositor2, eachReport]) => { %>
                                            <% if (eachReport && eachReport.whichRoom == room._id && eachReport.userSessionId == userSession._id.toString()) { %>
                                              <% avoidDuplicate_feedback = false; %>
                                            <% } %>
                                          <% }); %>
                                        <% } %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% } %>
                              <% }); %>
                            <% }); %>
                          <% } else { %>
                            
                          <% } %>
                        </div>
                        
                        <div class="split">
                          <% if (guestUser.feedback && avoidDuplicate_feedback === true) { %>
                          <div class="dropdown_rep">
                            <img class="repImgSize" src="/img/reputation/Feedback/feedback.png" alt="">
                            <ul id="myDropdown" class="dropdown-content_rep">
                              <% Object.entries(guestUser.feedback).forEach(([category, values]) => { %>
                                <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                  <!-- ATTENTIE LA FILTRUL PUS, IN CAZ CA SE MODIFICA MODELUL BAZEI DE DATE!!! -->
                                  <% if (["Vibe" , "Environment", "Discrimination", "Hygiene"].includes(Categories)) { %>
                                    <!-- generate ejs categories -->
                                    <li class="dropdown_rep_category">
                                      <p  class="dropbtn_rep_category"><%= Categories %></p>
                                      <div id="myDropdown" class="dropdown-content_rep_category">
                                        <!-- generate ejs cat. items -->
                                        <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                          <!-- <li> subCategories:  item %>. It's details:  itemDetails.val %> -  itemDetails.report_title %> -  itemDetails.name %></li> -->
                                          <form action="/room/report" method="POST" class="stretch">
                                            <input type="hidden" name="whichReputationModel" value="feedback">
                                            <input type="hidden" name="whoIsReported" value="<%= guestUser._id %>">
                                            <input type="hidden" name="mainCategory" value="<%= Categories %>">
                                            <input type="hidden" name="whichRoom" value="<%= room._id %>">
                                            <input type="hidden" name="userSession" value="<%= user._id %>">
                                            <button type="submit" name="item" value="<%= item %>" ><%= itemDetails.report_title %></button>
                                          </form>
                                          
                                        <% }); %>
                                      </div>
                                    </li>
                                  <% } %>
                                <% }); %>
                              <% }); %>
                            </ul>
                          </div>
                          <p style="color: rgb(84, 90, 0);">Give a constructive feedback to the player if you found something that they could improve</p>
                          <% } else { %>
                            <p>The player has received already a feedback</p>
                          <% } %>
                        </div>


                        <!-- Stain  -->
                        <% let avoidDuplicate_stain = true; %>
                        <div class="Verify_if_the_player_is_stained">
                          <% if (guestUser.stain && avoidDuplicate_stain === true) { %>
                            <% Object.entries(guestUser.stain).forEach(([category, values]) => { %>
                              <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                <% if (["Security", "Playing style" , "Environment", "Personality", "Good Manners"].includes(Categories)) { %>
                                  <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                    <% Object.entries(itemDetails.reportedBy).forEach(([report, nefolositor]) => { %>
                                      <% Object.entries(nefolositor).forEach(([nefolositor2, eachReport]) => { %>
  
                                        <% if (eachReport.whichRoom == room._id && eachReport.userSessionId == userSession._id.toString()) { %> 
                                          <% avoidDuplicate_stain = false; %>
                                        <% } %>
                                        
                                      <% }); %>
                                    <% }); %>
                                  <% }); %>
                                <% } %>
                              <% }); %>
                            <% }); %>
                          <% } else { %>
                          <% } %>
                        </div>
                        <div class="split">
                          <% if (guestUser.stain && avoidDuplicate_stain === true) { %>
                          <div class="dropdown_rep">
                            <img class="repImgSize" src="/img/reputation/Bad/stain.png" alt="">
                            <ul id="myDropdown" class="dropdown-content_rep">
                              <% Object.entries(guestUser.stain).forEach(([category, values]) => { %>
                                
                                <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                  <!-- ATTENTIE LA FILTRUL PUS, IN CAZ CA SE MODIFICA MODELUL BAZEI DE DATE!!! -->

                                  <% if (["Security", "Playing style" , "Environment", "Personality", "Good Manners"].includes(Categories)) { %>
                                    <!-- generate ejs categories -->
                                    <li class="dropdown_rep_category">
                                      <p  class="dropbtn_rep_category"><%= Categories %></p>
                                      <div id="myDropdown" class="dropdown-content_rep_category">
                                        <!-- generate ejs cat. items -->
                                        <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                          <!-- <li> subCategories:  item %>. It's details:  itemDetails.val %> -  itemDetails.report_title %> -  itemDetails.name %></li> -->
                                          <form action="/room/report" method="POST" class="stretch">
                                            <input type="hidden" name="whichReputationModel" value="stain">
                                            <input type="hidden" name="whoIsReported" value="<%= guestUser._id %>">
                                            <input type="hidden" name="mainCategory" value="<%= Categories %>">
                                            <input type="hidden" name="whichRoom" value="<%= room._id %>">
                                            <input type="hidden" name="userSession" value="<%= user._id %>">

                                            <input type="hidden" name="type" value="Bad">
                                            <input type="hidden" name="category" value="<%= Categories %>">
                                            <input type="hidden" name="subCategory" value="<%= itemDetails.name %>">
                                            <input type="hidden" name="add_rep" value="add_rep">

                                            <button type="submit" name="item" value="<%= item %>" ><%= itemDetails.report_title %></button>
                                          </form>
                                          
                                        <% }); %>
                                      </div>
                                    </li>
                                  <% } %>
                                <% }); %>
                              <% }); %>
                            </ul>
                          </div>
                          <p style="color: rgb(126, 15, 15);">The player has engaged in severely disruptive behavior, violated community standards, or created an environment that is harmful or unwelcoming.</p>
                          <% } else { %>
                            <p>The player has received already a Stain</p>
                          <% } %>
                        </div>


                      </div>
                    <% } else { %>
                      <h5 class="notForSelf">You cannot Honor/Feedback/Stain yourself</h5>
                    <% } %>


                    <a class="closeSearch" href="#">X</a>
                  </div>
                <% }); %>

            <% } else { %>
              <p>No joined guests found</p>
            <% } %>


          </div>
        </div>

        <div class="votingPolls_container">
          <div class="time_poll aPoll">
            <div class="pozVoteTitle">
              <h3>Vote a time</h3>
              <form action="/inviteVotes" method="post" class="finVote">
                <input type="hidden" name="votingCategory" value="time">
                <input type="hidden" name="roomID" value="<%= room._id %>">
                <button name="updateInvite" value="updateInvite" class="time_category category_button">Pick the highest voted time &nbsp;<i class="fa-solid fa-clock"></i></button>
              </form>
            </div>
            <form action="/inviteVotes" method="post">
              <label for="time">Add a Time:</label>
              <input type="time" name="newValue" id="time" required>

              <input type="hidden" name="roomID" value="<%= room._id %>">
              <input type="hidden" name="userSessionID" value="<%= user._id %>">
              <input type="hidden" name="votingCategory" value="time">
              <button class="poll_td_btn" name="newVote" value="newVote"><i class="fa-solid fa-list-check fa-lg"></i></button>
            </form>
            <!-- template  -->
            <% room.votes.forEach(function(vote) { %>
              <% if (vote.votingCategory === "time") { %>
                <form action="/inviteVotes" method="post" class="fullW100">
                  <button type="submit" class="skill-box" name="plusOneVote" value="plusOneVote">
                    <div class="pull_item">
                      <div class="leftSide_item">
                        <input type="hidden" name="roomID" value="<%= room._id %>">
                        <input type="hidden" name="userSessionID" value="<%= user._id %>">
                        <input type="hidden" name="item_ID" value="<%= vote._id %>">


                        <%var matchFound = false; // Flag variable to track if match is found %>
                        <%var count = 0; // Initialize counter variable %>
                    
                        <%if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) {%>
                          <%joinedGuestUsers.forEach(guestUser => {%>
                            <%if (Array.isArray(vote.votedBy_ID) && vote.votedBy_ID.includes(guestUser._id.toString())) {%>
                              <% count++; // Increment counter %>
                              <%if (guestUser._id.toString() == user._id.toString()) {%>
                                <%matchFound = true; // Set flag if match is found%>
                                
                              <%}%>
                            <%}%>
                          <%});%>
                        <%}%>

                        <!-- Check the flag variable and display appropriate icon -->
                        <%if (matchFound) { %>
                            <i class="fa-regular fa-circle-check"></i>
                        <% } else { %>
                            <i class="fa-regular fa-circle"></i>
                        <% } %>
                        
                        <!-- generate a procentage of how many of the participants have agreed in the poll -->
                        <%let totalParticipants = room.joined_guest.length; // Total number of participants%>
                        <%let percentage = parseInt((count / totalParticipants * 100).toFixed(2));%>
                        <%let truncatedPercentage = Math.floor(percentage / 10); // Remove the last digit%>
                        

                        <%let majorityThreshold = Math.ceil(totalParticipants / 2); // Calculate majority threshold%>

                        <%let successfulResult = count >= majorityThreshold; // Check if count meets or exceeds the majority threshold%>


                        <div class="item_name">
                          <span class="title"><%= vote.newValue %></span>
                        </div>
                      </div>
                      <div class="item_voters">
                        <% if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) { %>
                          <% joinedGuestUsers.forEach(guestUser => { %>
                            <% if (Array.isArray(vote.votedBy_ID) && vote.votedBy_ID.includes(guestUser._id.toString())) { %>
                              <%if (guestUser._id.toString() == user._id.toString()) {%>
                                <img class="votingImg" title="<%= guestUser.yourName %>" src="/userImages/<%= guestUser.images %>" style="border: 2px solid rgb(84, 84, 134);">
                              <% } else { %>
                                <img class="votingImg" title="<%= guestUser.yourName %>" src="/userImages/<%= guestUser.images %>">
                              <% } %>
                              
                            <% } %>
                          <% }) %>
                        <% } %>
                      </div>
                    </div>
        
                    <div class="skill-bar">
                        <span class="skill-per percentage<%=truncatedPercentage%> <%= successfulResult %>">
                            <span class="tooltip pop<%= successfulResult %>"><%= percentage %>% </span>
                        </span>
                    </div>

                  </button>
                </form>
              <% } %>
            <% }); %>
          </div>

          <div class="date_poll aPoll">
            <div class="pozVoteTitle">
              <h3>Vote a date</h3>
              <form action="/inviteVotes" method="post" class="finVote">
                <input type="hidden" name="votingCategory" value="date">
                <input type="hidden" name="roomID" value="<%= room._id %>">
                <button type="submit" name="updateInvite" value="updateInvite" class="date_category category_button">Replace the current date <br> with the highest vote &nbsp;<i class="fa-solid fa-calendar-days"></i></button>
              </form>
            </div>
            <form action="/inviteVotes" method="post">
              <label for="date">Add a Date:</label>
              <input type="date" name="newValue" id="date" required>
              <input type="hidden" name="roomID" value="<%= room._id %>">
              <input type="hidden" name="userSessionID" value="<%= user._id %>">
              <input type="hidden" name="votingCategory" value="date">
              <button class="poll_td_btn" name="newVote" value="newVote"><i class="fa-solid fa-list-check fa-lg"></i></i></button>
            </form>
            <!-- template  -->
            <% room.votes.forEach(function(vote) { %>
              <% if (vote.votingCategory === "date") { %>
                <form action="/inviteVotes" method="post" class="fullW100">
                  <button type="submit" class="skill-box" name="plusOneVote" value="plusOneVote">
