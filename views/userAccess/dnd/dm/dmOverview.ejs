                                                class="itemStatus_idle <%= pendingItem.isIdle ? 'is-visible' : '' %>"
                                                type="submit"
                                                name="visibility"
                                                value="Idle"
                                            >
                                                <i class="fa-solid fa-circle"></i>
                                                Idle
                                            </button>
                                        </form>
                                        <form
                                            action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/pending-items/visibility"
                                            method="post"
                                        >
                                            <input type="hidden" name="itemId" value="<%= pendingItem.id %>">
                                            <button
                                                class="itemStatus_visible <%= pendingItem.isVisible ? 'is-visible' : '' %>"
                                                type="submit"
                                                name="visibility"
                                                value="isVisible"
                                            >
                                                <i class="fa-regular fa-eye"></i>
                                            </button>
                                        </form>

                                    </div>


                                    <form
                                        action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/pending-items/delete"
