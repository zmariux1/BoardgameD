                  <li class="dropdown-list-item2 openLocation">Add a new location..</li>
                </ul>
              </div> -->
              <!-- dropdown ends -->
  
            <!-- </div> -->
  
            <!-- the board games container xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  -->
            <!-- <div class="boardgame_section"> -->
  
                <!-- search box input start  -->
                <!-- <div class="search-box">
                  <input type="text" id="search-input" placeholder="Search anything..">
                </div> -->
                <!-- search box input ends  -->
              <!-- <div id="parentDiv" class="boardgame_container">
                
                <div class="boardgame_bar">
  
                  <div class="checkTheGame">
                    <input type="checkbox">
                    
                  </div>
                  <div class="theGameDetails">
                    <p class="bar-text">Weight</p>
                    <p class="bar-text">Rate</p>
                    <p class="bar-text">Votes</p>
                  </div>
                </div> -->
                <!-- A game starts here  -->
                <!-- <div id="originalDiv" class="agame">
                  <div class="checkTheGame">
                    <input type="checkbox">
                    <p class="gameName">Boardgame1</p>
                  </div>
                  <div class="theGameDetails">
                    <p class="dificulty">3.1</p>
