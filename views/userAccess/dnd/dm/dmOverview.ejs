                    ========================================================= -->

                <form
                    id="transferConditions-modal-overlay"
                    class="transferConditions-modal-overlay"
                    action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : '' %>/conditions"
                    method="POST"
                >

                    <div id="transferConditions-modal" class="transferConditions-modal">

                        <!-- HEADER -->
                        <header class="transfer-modal__header">

                            <div class="transfer-modal__heading">

                                <h2 class="transfer-modal__title">
                                    Manage Conditions
                                </h2>

                                <div class="transfer-modal__target">
                                    <span class="transfer-modal__target-label">
                                        Affecting:
                                    </span>

                                    <select
                                        class="transfer-modal__target-name transfer-modal__target-select"
                                        aria-label="Select target character"
                                    >
                                        <% const conditionTargets = activeEncounterCombatants.filter((combatant) =>
                                            combatant.type === "character"
                                        ); %>
                                        <% conditionTargets.forEach((combatant, index) => { %>
                                            <option
                                                value="<%= combatant.charID %>"
                                                data-condition-indexes="<%= (combatant.character?.condition || [])
                                                    .map((condition) => String(condition.index || '').trim().toLowerCase())
                                                    .filter(Boolean)
                                                    .join(',') %>"
                                                <%= index === 0 ? "selected" : "" %>
                                            >
                                                <%= combatant.character?.charName || "Personaj fără nume" %>
                                            </option>
                                        <% }); %>
                                        <% if (!conditionTargets.length) { %>
                                            <option value="" selected disabled>No active characters</option>
                                        <% } %>
                                    </select>
                                </div>

                            </div>

                            <button
                                type="button"
                                class="NotesExistJS transfer-modal__close"
                                aria-label="Close"
                            >
                                &times;
                            </button>

                        </header>


                        <!-- CONDITIONS -->
                        <div class="transferConditions-modal__content">


                            <!-- =================================================
                                DEBUFFS
                            ================================================== -->

                            <section class="transfer-group transfer-group--debuff">
                                <div class="transfer-group__header">

                                    <span class="transfer-group__icon">
                                        ☠
                                    </span>

                                    <h3 class="transfer-group__title">
                                        Debuffs
                                    </h3>

                                </div>


                                <div class="transfer-group__list">
                                    <% const conditionIcons = {
                                        blinded: "◉",
                                        charmed: "♥",
                                        deafened: "♫",
                                        frightened: "☻",
                                        grappled: "✋",
                                        incapacitated: "×",
                                        invisible: "◌",
                                        paralyzed: "⚡",
                                        petrified: "◆",
                                        poisoned: "☠",
                                        prone: "◒",
                                        restrained: "⛓",
                                        stunned: "★",
                                        unconscious: "◐",
                                        exhaustion: "⚠"
                                    }; %>
                                    <% conditions.forEach((condition) => { %>
                                        <label class="transfer-option">
                                            <span class="transfer-option__icon transfer-option__icon--<%= condition.index %>">
                                                <%= conditionIcons[condition.index] || "✦" %>
                                            </span>
                                            <span class="transfer-option__name">
                                                <%= condition.name %>
                                            </span>
                                            <input
                                                type="checkbox"
                                                class="transfer-option__checkbox"
                                                name="conditions"
                                                value="<%= condition.index %>"
                                                data-condition-index="<%= condition.index %>"
                                            >
                                            <span class="transfer-option__checkmark"></span>
                                        </label>
                                    <% }); %>

                                </div>

                            </section>



                            <!-- =================================================
                                BUFFS
                            ================================================== -->

                            <section class="transfer-group transfer-group--buff">

                                <div class="transfer-group__header">

                                    <span class="transfer-group__icon">
                                        ⛨
                                    </span>

                                    <h3 class="transfer-group__title">
                                        Buffs
                                    </h3>

                                </div>


                                <div class="transfer-group__list">


                                    <label class="transfer-option transfer-option--active">

                                        <span class="transfer-option__icon transfer-option__icon--bless">
                                            ◆
                                        </span>

                                        <span class="transfer-option__name">
                                            Bless
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                            checked
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option transfer-option--active">

                                        <span class="transfer-option__icon transfer-option__icon--darkvision">
                                            ◉
                                        </span>

                                        <span class="transfer-option__name">
                                            Darkvision
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                            checked
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--freedom">
                                            ♫
                                        </span>

                                        <span class="transfer-option__name">
                                            Freedom of Movement
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--haste">
                                            ⚡
                                        </span>

                                        <span class="transfer-option__name">
                                            Haste
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--heroism">
                                            ⛨
                                        </span>

                                        <span class="transfer-option__name">
                                            Heroism
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--invisibility">
                                            ◌
                                        </span>

                                        <span class="transfer-option__name">
                                            Invisibility
                                        </span>

                                        <input
                                            type="checkbox"
                                            class="transfer-option__checkbox"
                                            name="replaceHere"
                                            value="replaceHere"
                                        >

                                        <span class="transfer-option__checkmark"></span>

                                    </label>


                                    <label class="transfer-option">

                                        <span class="transfer-option__icon transfer-option__icon--mind-shielding">
                                            ◈
                                        </span>

                                        <span class="transfer-option__name">
                                            Mind Shielding
                                        </span>

                                        <input
