<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="img/title/titleIcon65.png">

    <link rel="stylesheet" href="css/elements/standardAll.css">
    <link rel="stylesheet" href="css/peopleAndFriends.css">
    <link rel="stylesheet" href="css/elements/header.css">
    <link rel="stylesheet" href="css/elements/botNavBar.css">
    
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>
  <%- include('../../layouts/header') %>



  <!-- profile section  -->
  <section class="thePage">
    <% if (sessionAll && sessionAll.friends && sessionAll.friends.length > 0) { %>
      <div class="container">
        <p class="pageTitle">Your Friends list</p>
        <form action="/friends" method="post" class="search-div ">
          <input type="search" name="search_people" class="input_people"> 
          <button type="submit" class="btn_people"><i class="custom_icon fa-solid fa-magnifying-glass search-icon"></i></button>
        </form>

        <ul class="listOfPeople">
          <% if (matchingUsers && matchingUsers.length > 0) { %>
            <!-- list the search results -->
            <% matchingUsers.forEach(people1 => { %>
              <li class="aPerson">
                <a href="/userProfile/<%= people1._id %>" class="aPerson">
                  <form action="/friends" method="POST" class="aPerson">
                    <div class="aPerson">
                      <div class="userID">
                        <div class="avatarImg">
                          <img class="profileGuest" src="/userImages/<%= people1.images %>">
                        </div>
                      </div>
                      <div>
                        <p class="name"><%= people1.yourName %></p>
                      </div>
                    </div>
                    <input type="hidden" name="unfriend" value="<%= people1._id %>">
                    <button type="submit">Remove</button>
                  </form>
                </a>
              </li>


            <% }) %>
          <% } else { %>
            <!-- list ALL the people if there is no search done -->
            <% sessionAll.friends.forEach(people => { %>
              <li class="aPerson">
                <a href="/userProfile/<%= people._id %>" class="aPerson">
                  <form action="/friends" method="POST" class="aPerson">
                    <div class="aPerson">
                      <div class="userID">
                        <div class="avatarImg">
                          <img class="profileGuest" src="/userImages/<%= people.images %>">
                        </div>
                      </div>
                      <div>
                        <p class="name"><%= people.yourName %></p>
                      </div>
                    </div>
                    <input type="hidden" name="unfriend" value="<%= people._id %>">
                    <button type="submit">Remove</button>
                  </form>
                </a>
              </li>
            <% }) %>
          <% } %>
        </ul>


        <p class="redirect">Find <a href="/people">new friends</a></p>
      </div>
    <% } else { %>
      <div class="container">
        <p class="pageTitle">Your Friends list</p>
        <div class="search-div">
          <input type="search">
        </div>
        <ul class="listOfPeople">
        </ul>
        <p class="redirect">Find <a href="/people">new friends</a></p>
      </div>
    <% } %>
  </section>





  <div id="loadingPopup" class="loading-popup">
    <div id="countdown" class="countdown"></div>
  </div>




  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon activeBar" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon " 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
  </div>





  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script src="js/profile-script.js"></script>
  <script src="js/header.js"></script>
</body>
</html>