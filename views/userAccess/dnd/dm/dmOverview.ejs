<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
    rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">


    <!-- CSS -->
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/comun/style_root.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/comun/style_footer.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/comun/style_header.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/commun_standard_overview.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/combatOverview.css">
    <link rel="stylesheet" href="/css/dnd/char/charSheet/piese/hpModal.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/avatarFocus.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/enemyOrganiser.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/mass_standard.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/sidebar.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/pendingItems.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/map.css">
    <link rel="stylesheet" href="/css/dnd/dm/dm_overview/dm_overview/popups.css">
    
    <!-- Font Awesome -->
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >

</head>
<body class="d-flex no_select">
    <button
        class="dmSidebarToggle"
        type="button"
        aria-controls="dmSidebar"
        aria-expanded="false"
        aria-label="Open navigation menu"
    >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <%
        const savedEnvironment = selectedSession?.sessionSettings?.environment || {};
        const weatherSelections = {
            time_of_day: ["morning", "noon", "evening", "night"].includes(savedEnvironment.time_of_day)
                ? savedEnvironment.time_of_day
                : "noon",
            Atmospheric_conditions: ({
                none: "clear",
                rain: "rainy",
                snow: "snowy"
            })[savedEnvironment.Atmospheric_conditions] ||
                (["clear", "cloudy", "fog", "rainy", "stormy", "snowy"].includes(savedEnvironment.Atmospheric_conditions)
                    ? savedEnvironment.Atmospheric_conditions
                    : "rainy"),
            temperature: ["freezing", "cold", "normal", "warm", "hot", "extreme"].includes(savedEnvironment.temperature)
                ? savedEnvironment.temperature
                : "freezing",
            wind: savedEnvironment.wind === "chellenging"
                ? "challenging"
                : (["light", "average", "strong", "challenging", "tornado"].includes(savedEnvironment.wind)
                    ? savedEnvironment.wind
                    : "average"),
            terrain: ({
                normal: "normal land",
                difficult: "normal land",
                challenging: "snow",
                strong: "lava"
            })[savedEnvironment.terrain] ||
                (["normal land", "snow", "swamp", "water", "lava"].includes(savedEnvironment.terrain)
                    ? savedEnvironment.terrain
                    : "normal land")
        };
        const environmentLabels = {
            conditions: {
                clear: "Clear",
                cloudy: "Cloudy",
                fog: "Fog",
                rainy: "Rain",
                stormy: "Storm",
                snowy: "Snow"
            },
            temperature: {
                freezing: "Freezing",
                cold: "Cold",
                normal: "Normal",
                warm: "Warm",
                hot: "Hot",
                extreme: "Extreme"
            },
            wind: {
                light: "Light wind",
                average: "Average wind",
                strong: "Strong wind",
                challenging: "Challenging wind",
                tornado: "Tornado"
            },
            terrain: {
                "normal land": "Normal land",
                snow: "Snow",
                swamp: "Swamp",
                water: "Water",
                lava: "Lava"
            },
            time: {
                morning: "Morning",
                noon: "Noon",
                evening: "Evening",
                night: "Night"
            }
        };
        const conditionIcons = {
            clear: "fa-sun",
            cloudy: "fa-cloud",
            fog: "fa-smog",
            rainy: "fa-cloud-rain",
            stormy: "fa-cloud-bolt",
            snowy: "fa-snowflake"
        };
        const timeIcons = {
            morning: "fa-cloud-sun",
            noon: "fa-sun",
            evening: "fa-cloud-sun",
            night: "fa-moon"
        };
    %>

    <!-- 1. sidebar - stanga-->
    <aside class="dmSidebar" id="dmSidebar">

        <!-- CAMPAIGN HEADER -->
        <section class="sidebarCampaign">

            <div class="campaignIcon">
                <i class="fa-solid fa-compass"></i>
            </div>

            <div class="campaignInfo">
                <h2><%= campaign.name || "Campanie fără nume" %></h2>
                <p><%= campaign.status || "Status indisponibil" %></p>
            </div>

        </section>


        <!-- CAMPAIGN SESSIONS -->
        <details class="sidebarChapterDropdown">
            <summary class="sidebarChapter">
                <div class="chapterIcon">
                    <i class="fa-solid fa-scroll"></i>
                </div>

                <div class="chapterInfo">
                    <span>
                        <%= selectedSession ? `Chapter ${selectedChapter || "—"}` : "No session selected" %>
                    </span>
                    <p>
                        <%= selectedSession && selectedSession.name
                            ? selectedSession.name
                            : selectedSession
                                ? "Nameless Session"
                                : "Select or create a session" %>
                    </p>
                </div>

                <i class="fa-solid fa-chevron-down chapterArrow" aria-hidden="true"></i>
            </summary>

            <div class="sessionDropdownMenu">
                <% if (isOwner) { %>
                    <form action="/dnd/dmOverview/<%= campaign._id %>/sessions" method="POST">
                        <button class="sessionDropdownCreate" type="submit">
                            <i class="fa-solid fa-plus" aria-hidden="true"></i>
                            Prepare a new session
                        </button>
                    </form>
                <% } else { %>
                    <div class="sessionDropdownOwnerNotice">
                        Only the campaign owner can prepare a new session.
                    </div>
                <% } %>

                <% sessionOptions.forEach((session) => { %>
                    <a
                        class="sessionDropdownLink <%= selectedSession && String(selectedSession._id) === String(session._id) ? "is-selected" : "" %>"
                        href="/dnd/dmOverview/<%= campaign._id %>/session/<%= session._id %>"
                        <%= selectedSession && String(selectedSession._id) === String(session._id) ? 'aria-current="page"' : "" %>
                    >
                        <span>Chapter <%= session.chapter %></span>
                        <strong><%= session.name || "Nameless Session" %></strong>
                        <small><%= session.status %></small>
                    </a>
                <% }); %>
            </div>
        </details>

        <% if (isOwner && selectedSession && selectedSession.status === "inDevelopment") { %>
            <form
                class="sessionDevelopmentForm"
                action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>"
                method="POST"
            >
                <label class="sessionDevelopmentField">
                    <span>Session name</span>
                    <input
                        type="text"
                        name="name"
                        maxlength="100"
                        placeholder="Nameless Session"
                        value="<%= selectedSession.name || "" %>"
                    >
                </label>
                <label class="sessionDevelopmentField">
                    <span>Start date</span>
                    <input
                        type="date"
                        name="start_date"
                        value="<%= selectedSession.start_date ? new Date(selectedSession.start_date).toISOString().slice(0, 10) : "" %>"
                    >
                </label>
                <button class="sessionDevelopmentSave" type="submit">Save session details</button>
            </form>
        <% } %>

        <!-- START / END / RETURN TO DRAFT BUTTONS -->
        <% if (isOwner && selectedSession) { %>
            <div class="sessionLifecycleActions">
                <% if (selectedSession.status === "inDevelopment") { %>
                    <form action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/status" method="POST">
                        <input type="hidden" name="action" value="start">
                        <button class="sessionLifecycleButton sessionLifecycleButton--start" type="submit">
                            <i class="fa-solid fa-play" aria-hidden="true"></i>
                            Start Session
                        </button>
                    </form>
                <% } %>
                <% if (selectedSession.status === "current") { %>
                    <form action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/status" method="POST">
                        <input type="hidden" name="action" value="end">
                        <button class="sessionLifecycleButton sessionLifecycleButton--end" type="submit">
                            <i class="fa-solid fa-stop" aria-hidden="true"></i>
                            End Session
                        </button>
                    </form>
                <% } %>
                <% if (["current", "old"].includes(selectedSession.status)) { %>
                    <form action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/status" method="POST">
                        <input type="hidden" name="action" value="draft">
                        <button class="sessionLifecycleButton sessionLifecycleButton--draft" type="submit">
                            <i class="fa-solid fa-rotate-left" aria-hidden="true"></i>
                            Return to Draft
                        </button>
                    </form>
                <% } %>
            </div>
        <% } %>

        <!-- CAMPAIGN DETAILS -->
        <details class="sidebarPanel campaignDetails">
            <summary class="sidebarSectionTitle">
                <span>CAMPAIGN DETAILS</span>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </summary>
            <div class="campaignDetailsContent">
                <p>
                    Challenge:
                    <%= campaign.worldGeneralKnowledge && campaign.worldGeneralKnowledge.type_of_challenge
                        ? campaign.worldGeneralKnowledge.type_of_challenge
                        : "Nespecificat" %>
                </p>
                <p>
                    Continents:
                    <%= campaign.worldGeneralKnowledge && campaign.worldGeneralKnowledge.multi_continental
                        ? campaign.worldGeneralKnowledge.multi_continental
                        : "Nespecificat" %>
                </p>
                <p>Players: <%= campaign.min_nr_users ?? "—" %>–<%= campaign.max_nr_users ?? "—" %></p>

                <h4>Banned options</h4>
                <% if (campaign.conditions_banning_list && campaign.conditions_banning_list.length) { %>
                    <ul>
                        <% campaign.conditions_banning_list.forEach((condition) => { %>
                            <li><%= condition.reference || "Opțiune" %> (<%= condition.index || "fără index" %>)</li>
                        <% }); %>
                    </ul>
                <% } else { %>
                    <p>No banned options.</p>
                <% } %>

                <h4>Selected session</h4>
                <p>
                    <%= selectedSession
                        ? `${selectedSession.name || "Nameless Session"} — ${selectedSession.status}`
                        : "No session selected" %>
                </p>
            </div>
        </details>


        <!-- SESSION TIMER -->
        <section class="sidebarSession">

            <div class="sessionControls">

                <div class="sessionRing">

                    <div class="sessionRingInner">

                        <strong>02:15:37</strong>

                        <span>Session Time</span>

                    </div>

                </div>

                <% if (isOwner) { %>
                    <button
                        class="sessionAddButton"
                        type="button"
                        aria-label="Set session timer"
                        title="Set session timer"
                    >
                        <i class="fa-solid fa-plus"></i>
                    </button>
                <% } %>

                <button
                    class="sessionPause"
                    type="button"
                    aria-label="Pause session timer"
                    title="Pause session timer"
                >
                    <i class="fa-solid fa-pause"></i>
                </button>

            </div>

        </section>


        <!-- GLOBAL QUESTS -->
        <section class="sidebarPanel globalQuests">

            <div class="sidebarSectionTitle">

                <span>GLOBAL QUESTS</span>

                <i class="fa-solid fa-scroll"></i>

            </div>


            <div class="questList">
                <% const activeQuests = visibleQuests.filter((quest) =>
                    quest.status === "not_accepted" || quest.status === "accepted"
                );
                const archivedQuests = visibleQuests.filter((quest) =>
                    quest.status === "completed" || quest.status === "failed"
                );
                %>
                <div class="questListActive">
                    <% if (activeQuests.length) { %>
                        <% activeQuests.forEach((quest) => {
                        const modalData = questModalDataById[String(quest._id)] || {
                            id: String(quest._id),
                            name: quest.name || '',
                            status: quest.status,
                            ownerUserId: String(quest.owener_userID?._id || quest.owener_userID || ''),
                            fields: {}
                        };
                        %>
                            <article
                                class="globalQuest <%= quest.status === 'accepted' ? 'active' : '' %>"
                                data-quest-owner-id="<%= modalData.ownerUserId %>"
                                data-quest-modal="<%= JSON.stringify(modalData) %>"
                            >
                                <div class="questMarker">
                                    <i class="fa-solid fa-diamond"></i>
                                </div>
                                <div class="questContent">
                                    <h4><%= quest.name || "Quest fără nume" %></h4>
                                    <p><%= quest.description || "Fără descriere." %></p>
                                </div>
                                <span class="questStatus <%= quest.status === 'accepted' ? 'active' : '' %>">
                                    <i class="fa-solid fa-circle"></i>
                                </span>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <p>No active quests are visible to you yet.</p>
                    <% } %>
                </div>
                <% if (archivedQuests.length) { %>
                    <details class="questListArchive">
                        <summary>Questuri ieșite din atenția participanților</summary>
                        <div class="questListArchiveItems">
                            <% archivedQuests.forEach((quest) => { %>
                                <div class="questArchiveTitle questArchiveTitle--<%= quest.status %>">
                                    <%= quest.name || "Quest fără nume" %>
                                </div>
                            <% }); %>
                        </div>
                    </details>
                <% } %>
            </div>


            <button class="addQuest" type="button" <%= canCreateQuest ? "" : "disabled" %>>
                <i class="fa-solid fa-plus"></i>
                Add Global Quest
            </button>

        </section>


        <!-- ENVIRONMENT -->
        <section class="sidebarPanel environmentPanel<%= isOwner ? ' environmentPanel--editable' : '' %>">

            <div class="sidebarSectionTitle">
                <span>ENVIRONMENT</span>
            </div>

            <div class="environmentMain">
                <div>
                    <h3 id="environment-condition"><%= environmentLabels.conditions[weatherSelections.Atmospheric_conditions] %></h3>
                    <p class="environmentStats">
                        <span id="environment-temperature"><%= environmentLabels.temperature[weatherSelections.temperature] %></span>
                        <span>•</span>
                        <span id="environment-wind"><%= environmentLabels.wind[weatherSelections.wind] %></span>
                    </p>
                    <p class="environmentSub" id="environment-terrain">
                        <%= environmentLabels.terrain[weatherSelections.terrain] %>
                    </p>
                </div>
                <div class="weatherIcon">
                    <i id="environment-icon" class="fa-solid <%= conditionIcons[weatherSelections.Atmospheric_conditions] %>"></i>
                </div>
            </div>

        </section>


        <!-- TIME -->
        <section class="sidebarPanel timePanel<%= isOwner ? ' timePanel--editable' : '' %>">

            <div class="sidebarSectionTitle">
                <span>TIME OF DAY</span>
            </div>

            <div class="timeMain">
                <div>
                    <h3 id="environment-time"><%= environmentLabels.time[weatherSelections.time_of_day] %></h3>
                    <p>Time of day</p>
                </div>
                <div class="sunIcon">
                    <i id="environment-time-icon" class="fa-solid <%= timeIcons[weatherSelections.time_of_day] %>"></i>
                </div>
            </div>

        </section>


        <!-- QUICK TOOLS -->
        <nav class="sidebarTools">

            <!-- DND HOMEPAGE -->
            <a
                class="sidebarTool"
                href="/<%= currentUserId %>/dnd"
                title="D&D Homepage"
            >
                <i class="fa-solid fa-dragon" aria-hidden="true"></i>
                <span>D&D Homepage</span>
            </a>
            
            <% const sidebarCharacters = charParticipantsDetails
                .filter((participant) =>
                    String(participant.userID?._id || participant.userID || "") === String(currentUserId) &&
                    participant.character
                )
                .filter((participant, index, participants) =>
                    participants.findIndex((entry) =>
                        String(entry.character._id) === String(participant.character._id)
                    ) === index
                ); %>
            <!-- MY CHARACTER -->
            <% sidebarCharacters.forEach(({ character }) => { %>
                <a
                    class="sidebarTool"
                    href="/<%= currentUserId %>/dnd/char/<%= character._id %>"
                    title="My Character"
                >
                    <i class="fa-solid fa-user-shield" aria-hidden="true"></i>
                    <span><%= character.charName || "Character" %></span>
                </a>
            <% }); %>



            <!-- CHARACTER SHOPS -->
            <% sidebarCharacters.forEach(({ character }) => { %>
                <a
                    class="sidebarTool"
                    href="/<%= currentUserId %>/dnd/char/<%= character._id %>/playerShop"
                    title="Shop for <%= character.charName || 'Character' %>"
                >
                    <i class="fa-solid fa-store" aria-hidden="true"></i>
                    <span>Shop</span>
                    <small><%= character.charName || "Character" %></small>
                </a>
            <% }); %>
            
        </nav>


        <!-- BOTTOM NAVIGATION -->
        <footer class="sidebarFooter">

            <button>
                <i class="fa-solid fa-map"></i>
            </button>
            <button>
                <i class="fa-solid fa-book-open"></i>
            </button>

            <button class="sidebarFooterMain">
                <i class="fa-solid fa-compass-drafting"></i>
            </button>

            <button>
                <i class="fa-solid fa-gear"></i>
            </button>

        </footer>

    </aside>

    <% if (selectedSession) { %>
    <% const currentSession = selectedSession; %>


    <!-- 2. main box -->
     <main class="flex-grow-1" d-flex flex-raw> 
        <!-- Icon library: defined once, referenced everywhere via <use> -->
                    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
                    <defs>
                        <symbol id="dndc-i-heart" viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-10-9.4C.4 7.6 2.3 4 6 4c2.1 0 3.7 1.1 4.7 2.6C11.7 5.1 13.3 4 15.4 4c3.7 0 5.6 3.6 4 7.1-2.5 4.8-10 9.4-10 9.4z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-i-hero-avatar" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M5 21c.4-4.4 2.8-7 7-7s6.6 2.6 7 7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M8 5.5c.8-1.7 2.1-2.5 4-2.5s3.2.8 4 2.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-shield" viewBox="0 0 24 24"><path d="M12 3l7 3v5.5c0 4.6-3 8.2-7 9.5-4-1.3-7-4.9-7-9.5V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-i-eye" viewBox="0 0 24 24"><path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/></symbol>
                        <symbol id="dndc-i-eye-off" viewBox="0 0 24 24"><path d="M1.5 12S5 5.5 12 5.5 22.5 12 22.5 12 19 18.5 12 18.5 1.5 12 1.5 12z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="3" y1="21" x2="21" y2="3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-coin" viewBox="0 0 24 24"><circle cx="12" cy="7" r="5.4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="8.4" cy="15.5" r="5.4" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="15.6" cy="15.5" r="5.4" fill="none" stroke="currentColor" stroke-width="1.6"/></symbol>
                        <symbol id="dndc-i-sword" viewBox="0 0 24 24"><path d="M4 20L15 9M17 3l4 4-3 3-4-4 3-3z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><path d="M13 11l3 3M3 21l2-2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-spear" viewBox="0 0 24 24"><path d="M3 21L17 7M20 4l-3 3-2-2 3-3 2 2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-i-round-shield" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="2.6" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 3.5V8M12 16v4.5M3.5 12H8M16 12h4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-potion" viewBox="0 0 24 24"><path d="M10 3h4M11 3v4.5L7.2 14a4 4 0 003.5 6h2.6a4 4 0 003.5-6L13 7.5V3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M8.3 15.5h7.4" stroke="currentColor" stroke-width="1.4"/></symbol>
                        <symbol id="dndc-i-bone" viewBox="0 0 24 24"><path d="M5 9.2a2.2 2.2 0 10-3-3.1 2.2 2.2 0 003 3.1zM7 7l10 10M19 14.8a2.2 2.2 0 103 3.1 2.2 2.2 0 00-3-3.1zM17 17l-10-10M5 14.8a2.2 2.2 0 10-3 3.1 2.2 2.2 0 003-3.1zM19 9.2a2.2 2.2 0 103-3.1 2.2 2.2 0 00-3 3.1z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-helmet" viewBox="0 0 24 24"><path d="M4 15c0-5 3.5-9 8-9s8 4 8 9v2H4v-2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M11 6V3M4 17h16M9.5 17v3M14.5 17v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-meat" viewBox="0 0 24 24"><path d="M15 4c3 0 5 2.3 5 5.2 0 2.4-1.6 4-3.4 5.4L9 21l-2-2 6.4-7.6C11.8 10 10 8.4 10 6c0-1.1.9-2 2-2s2 .9 2 2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="6" cy="19" r="1.1" fill="currentColor"/></symbol>
                        <symbol id="dndc-i-pelt" viewBox="0 0 24 24"><path d="M4 6c2-2 5-3 8-3s6 1 8 3l-2 3 2 3-3 2 1 3-3 1-1 3-3-1-3 1-1-3-3-1 1-3-3-2 2-3-2-3z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-i-fang" viewBox="0 0 24 24"><path d="M9 3c-1 3-1 6 .5 9.5C11 16 11 19 9.5 21c3-1 5-3.5 5.5-7 .5-3.5-.5-7.5-2-11-1 .5-3 .5-4 0z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-i-mace" viewBox="0 0 24 24"><path d="M8 20l6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="12.5" y="3.5" width="8" height="8" rx="1.5" transform="rotate(45 16.5 7.5)" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M16.5 3v1M16.5 11v1M12 7.5h1M20 7.5h1" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-armor" viewBox="0 0 24 24"><path d="M12 3l-5 2v3L4 9v6l4 5h8l4-5V9l-3-1V5l-5-2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M12 8v10" stroke="currentColor" stroke-width="1.3"/></symbol>
                        <symbol id="dndc-i-skull" viewBox="0 0 24 24"><path d="M12 3C7.6 3 4.5 6.3 4.5 10.3c0 2.7 1.4 4.6 3 5.9v2.3c0 .8.6 1.5 1.5 1.5h6c.9 0 1.5-.7 1.5-1.5v-2.3c1.6-1.3 3-3.2 3-5.9C19.5 6.3 16.4 3 12 3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="9" cy="11" r="1.3" fill="currentColor"/><circle cx="15" cy="11" r="1.3" fill="currentColor"/><path d="M10.5 18v2.5M13.5 18v2.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-goblin" viewBox="0 0 24 24"><path d="M12 4c-3.5 0-6 2.6-6 6.2 0 2.6 1.3 4.4 2.7 5.6-.2.9-.5 2.2-.9 3.2 1.2.6 2.7 1 4.2 1s3-.4 4.2-1c-.4-1-.7-2.3-.9-3.2 1.4-1.2 2.7-3 2.7-5.6C18 6.6 15.5 4 12 4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 8L2.5 5M18 8l3.5-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M9.3 11.5c.3-.6.9-1 1.5-1M14.7 11.5c-.3-.6-.9-1-1.5-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-i-wolf" viewBox="0 0 24 24"><path d="M4 19l1.5-6L3 8l4.5 2L12 4l4.5 6L21 8l-2.5 5L20 19l-3.5-2.5L12 19l-4.5-2.5L4 19z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="9.7" cy="11.5" r="0.9" fill="currentColor"/><circle cx="14.3" cy="11.5" r="0.9" fill="currentColor"/></symbol>
                        <symbol id="dndc-i-bugbear" viewBox="0 0 24 24"><path d="M8 4C6 5 5 7.3 5 9.5c0 2 .8 3.6 2 4.8-.3 1.7-1 3.5-2 4.7 2 1.3 4.6 2 7 2s5-.7 7-2c-1-1.2-1.7-3-2-4.7 1.2-1.2 2-2.8 2-4.8 0-2.2-1-4.5-3-5.5-.6 1.3-1.7 2-3 2-.6 0-1.1-.1-1.6-.4-.5.3-1 .4-1.6.4-1.3 0-2.4-.7-3-2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-aberration" viewBox="0 0 24 24"><path d="M12 3c-4.2 0-6.5 3.1-6.5 6.8 0 2.1 1 3.9 2.5 5.1L7 21l5-2 5 2-1-6.1c1.5-1.2 2.5-3 2.5-5.1C18.5 6.1 16.2 3 12 3z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 8L4 5M16 8l4-3M9 10h.1M15 10h.1M10 14c1.2 1 2.8 1 4 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-creature-humanoid" viewBox="0 0 24 24"><circle cx="12" cy="7" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4.5 21c.4-4.4 3.2-7 7.5-7s7.1 2.6 7.5 7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-dragon" viewBox="0 0 24 24"><path d="M12 5c-3 0-5 2-5 5 0 1.5.6 2.8 1.8 3.7L8 20l4-2 4 2-.8-6.3C16.4 12.8 17 11.5 17 10c0-3-2-5-5-5z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 8L3 4l1 7 4 2M16 8l5-4-1 7-4 2M10 9h.1M14 9h.1M10 13l2 1 2-1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-elemental" viewBox="0 0 24 24"><path d="M12 3c4 3 6 5.5 6 9a6 6 0 01-12 0c0-2 1-3.5 2.5-5.2-.1 2 1 3 2 3.4C11 7.4 11.7 5.5 12 3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 15c0 1.2.8 2 2 2s2-.8 2-2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-creature-monstrosity" viewBox="0 0 24 24"><path d="M12 4c-4 0-6 3-6 6 0 2 1 3.5 2.5 4.5L8 21l4-2 4 2-.5-6.5C17 13.5 18 12 18 10c0-3-2-6-6-6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M7 7L3 4l1 7M17 7l4-3-1 7M9 10h.1M15 10h.1M10 14h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-construct" viewBox="0 0 24 24"><path d="M12 3l6 2v6c0 4-2.5 7.5-6 9-3.5-1.5-6-5-6-9V5l6-2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 9h6M10 13h.1M14 13h.1M10 16h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-creature-beast" viewBox="0 0 24 24"><path d="M5 20l1.5-6L4 8l4 2 4-6 4 6 4-2-2.5 6L19 20l-3.5-2.5L12 20l-3.5-2.5L5 20z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="9.5" cy="11.5" r=".8" fill="currentColor"/><circle cx="14.5" cy="11.5" r=".8" fill="currentColor"/></symbol>
                        <symbol id="dndc-creature-plant" viewBox="0 0 24 24"><path d="M12 21V11M12 15C6 15 4 11 4 6c5 0 8 2 8 7M12 12c0-5 3-8 8-8 0 5-2 9-8 9" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-fiend" viewBox="0 0 24 24"><path d="M12 5c-4 0-6 3-6 6 0 2 1 3.5 2.5 4.5L8 21l4-2 4 2-.5-6.5C17 14.5 18 13 18 11c0-3-2-6-6-6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 7L4 3l1 7M16 7l4-4-1 7M10 11h.1M14 11h.1M10 15l2-1 2 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-ooze" viewBox="0 0 24 24"><path d="M4 19c0-2 2-3 2-6 0-2 1-3 2-4 0 2 1 3 2 3 0-4 2-7 4-9 0 4 1 6 3 8 1 1 2 3 2 5a5 5 0 01-5 5H9a5 5 0 01-5-2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-fey" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M12 12v8M9 20l3-2 3 2M8 7C4 5 3 8 5 11l4 1M16 7c4-2 5 1 3 4l-4 1M12 3V1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-giant" viewBox="0 0 24 24"><circle cx="12" cy="6.5" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 21c.3-5 3.2-8 8-8s7.7 3 8 8z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M9 6h.1M15 6h.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></symbol>
                        <symbol id="dndc-creature-celestial" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9 12L3 8l2 8 5-1M15 12l6-4-2 8-5-1M12 11v9M9 20h6M12 2V1" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></symbol>
                        <symbol id="dndc-creature-undead" viewBox="0 0 24 24"><path d="M12 3C7.5 3 5 6 5 10c0 2.5 1.2 4.2 3 5.5V19h8v-3.5c1.8-1.3 3-3 3-5.5 0-4-2.5-7-7-7z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="9" cy="10" r="1.2" fill="currentColor"/><circle cx="15" cy="10" r="1.2" fill="currentColor"/><path d="M10 16v3M14 16v3" stroke="currentColor" stroke-width="1.4"/></symbol>
                        <% monsters.filter((monster) => /^[a-z]/i.test(monster.index)).forEach((monster) => { %>
                            <% if (!['bugbear', 'goblin'].includes(monster.index)) { %>
                                <% const creatureType = monster.type.startsWith('swarm') ? 'beast' : monster.type; %>
                                <symbol id="dndc-i-<%= monster.index %>" viewBox="0 0 24 24"><use href="#dndc-creature-<%= creatureType %>"/></symbol>
                            <% } %>
                        <% }); %>
                    </defs>
                    </svg>

        <!-- 2.1. container personaje -->
        <div  class="">
            <!-- 2.1.1. Combat Overview -->
            <section class="combatOverview_section fantasy-panel  d -flex flex-column">
                <div class="combatTitleBar">
                    <h3 class="combatTitle">
                        Combat Overview
                    </h3>
                    <% if (isOwner && selectedSession) { %>
                        <button
                            class="participantsToggleButton"
                            type="button"
                            aria-expanded="false"
                            aria-controls="participantsPickerOverlay"
                        >
                            <i class="fa-solid fa-users" aria-hidden="true"></i>
                            Participants
                        </button>
                    <% } %>
                </div>

                <% if (isOwner && selectedSession) { %>
                    <div
                        class="participantsPickerOverlay"
                        id="participantsPickerOverlay"
                        aria-hidden="true"
                    >
                        <form
                            class="participantsPicker"
                            action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/active-encounter"
                            method="POST"
                            role="dialog"
                            aria-modal="true"
                            aria-labelledby="participantsPickerTitle"
                        >
                            <header class="participantsPickerHeader">
                                <div>
                                    <span class="participantsPickerEyebrow">COMBAT SETUP</span>
                                    <h2 id="participantsPickerTitle">Participants</h2>
                                </div>
                                <button
                                    class="participantsPickerClose"
                                    type="button"
                                    aria-label="Close participants"
                                >
                                    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                                </button>
                            </header>

                            <div class="participantsPickerList">
                                <% if (charParticipantsDetails.length) { %>
                                    <% charParticipantsDetails.forEach((participant) => { %>
                                        <label class="participantsPickerOption">
                                            <input
                                                type="checkbox"
                                                name="characterIds"
                                                value="<%= participant.charID %>"
                                                <%= activeEncounterParticipantIds.has(String(participant.charID)) ? "checked" : "" %>
                                            >
                                            <span class="participantsPickerCheckbox" aria-hidden="true"></span>
                                            <span class="participantsPickerCharacter">
                                                <strong><%= participant.character?.charName || "Character" %></strong>
                                                <small><%= participant.charID %></small>
                                            </span>
                                        </label>
                                    <% }); %>
                                <% } else { %>
                                    <p class="participantsPickerEmpty">No campaign participants found.</p>
                                <% } %>
                            </div>

                            <footer class="participantsPickerFooter">
                                <button class="participantsPickerCancel" type="button">Cancel</button>
                                <button class="participantsPickerSave" type="submit">Save participants</button>
                            </footer>
                        </form>
                    </div>
                <% } %>

                <div class="simplifiedOverview">

                    <details class="overviewCard roundCard">
                        <summary class="overviewLabel">
                            ROUND
                        </summary>

                        <div class="overviewValue" id="round-number">
                            3
                        </div>

                    </details>

                    <details class="overviewCard">
                        <summary class="overviewHeader">
                            THREAT
                        </summary>

                        <div class="overviewRow">
                            <span>Party</span>
                            <strong id="party-hp">84</strong>
                        </div>

                        <div class="overviewRow">
                            <span>Enemy</span>
                            <strong id="enemy-hp">79</strong>
                        </div>

                    </details>

                    <details class="overviewCard">
                        <summary class="overviewHeader">
                            SPELL SLOTS
                        </summary>

                        <div class="overviewRow">
                            <span>Party</span>
                            <strong id="party-spellsSlots">17</strong>
                        </div>

                        <div class="overviewRow">
                            <span>Enemy</span>
                            <strong id="enemy-spellsSlots">3</strong>
                        </div>

                    </details>

                    <details class="overviewCard">
                        <summary class="overviewHeader">
                            SKILLS
                        </summary>

                        <div class="overviewRow">
                            <span>Party</span>
                            <strong id="party-skills">12</strong>
                        </div>

                        <div class="overviewRow">
                            <span>Enemy</span>
                            <strong id="enemy-skills">8</strong>
                        </div>

                    </details>

                </div>
                <div id="initOrder" class="overview_combat_grid_wrapper">
                    <!-- Combat participants grid -->
                    <div class="overview_combat_grid">

                        <!-- Grid header -->
                        <div class="overview_combat_grid_header">
                            <div class="header-cell header-init">INIT</div>
                            <div class="header-cell header-creature">CREATURE</div>
                            <div class="header-cell header-hp">HP</div>
                            <div class="header-cell header-ac">AC</div>
                            <div class="header-cell header-conditions">CONDITIONS</div>
                            <div class="header-cell header-more">MORE</div>
                        </div>

                        <% activeEncounterCombatants.forEach((combatant) => { %>
                            <% const character = combatant.type === "character" ? combatant.character : null; %>
                            <article
                                class="overview_combat_grid_participant <%= combatant.type === 'character' ? 'is-player' : 'is-enemy' %><%= character && initialFocusCharacter && String(character._id) === String(initialFocusCharacter._id) ? ' is-char-focus-selected active' : '' %>"
                                data-combatant-type="<%= combatant.type === 'character' ? 'player' : 'enemy' %>"
                                data-active-encounter-id="<%= combatant.id %>"
                                <% if (combatant.type === "character") { %>
                                    data-participant-id="<%= combatant.charID %>"
                                    data-user-id="<%= combatant.userID %>"
                                    data-focus-details="<%= JSON.stringify(character?.focusDetails || {}) %>"
                                    data-personal-quests="<%= JSON.stringify(personalQuestsByCharacterId[String(combatant.charID)] || []) %>"
                                    tabindex="0"
                                    aria-label="Select <%= character?.charName || 'character' %> details"
                                <% } else { %>
                                    data-encounter-enemy-id="<%= combatant.id %>"
                                    data-enemy-status="<%= combatant.status %>"
                                <% } %>
                            >
                                <div class="init">
                                    <div class="cellInit"><%= combatant.initiativeOrder ?? "—" %></div>
                                </div>

                                <div class="creature">
                                    <div class="cellCreature">
                                        <% if (character && character.charAvatar) { %>
                                            <img src="<%= character.charAvatar %>" alt="">
                                        <% } else if (character) { %>
                                            <svg class="cellCreature__placeholder" aria-hidden="true"><use href="#dndc-i-hero-avatar"/></svg>
                                        <% } %>
                                        <div class="creatureInfo">
                                            <p class="overview_creatureName">
                                                <%= character
                                                    ? character.charName || "Personaj fără nume"
                                                    : combatant.type === "enemy"
                                                        ? combatant.name
                                                        : "Personaj indisponibil" %>
                                            </p>
                                            <p class="overview_creatureType massTextDescription">
                                                <% if (character) { %>
                                                    <%= character.race && character.race.index || "Rasă nespecificată" %>
                                                    <span>&bull;</span>
                                                    <% if (character.classes && character.classes.length) { %>
                                                        <%= character.classes.map((classDetails) =>
                                                            `${classDetails.index || "Clasă"} ${classDetails.level || ""}`.trim()
                                                        ).join(", ") %>
                                                    <% } else { %>
                                                        Clasă nespecificată
                                                    <% } %>
                                                <% } else if (combatant.type === "enemy") { %>
                                                    <%= combatant.reference === "custom" ? "Custom Enemy" : "Monster" %>
                                                <% } else { %>
                                                    ID: <%= combatant.charID %>
                                                <% } %>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div class="hp">
                                    <% if (character && (character.hp || character.calculatedMaxHP !== undefined)) { %>
                                        <div
                                            class="cellHp <%= isOwner ? 'cellHp--editable' : '' %>"
                                            <% if (isOwner) { %>
                                                data-character-id="<%= character._id %>"
                                                data-hp-type="character"
                                                data-failed-death-saves="<%= character.hp?.failedDeathSaves ?? 0 %>"
                                                data-success-death-saves="<%= character.hp?.successDeathSaves ?? 0 %>"
                                                aria-label="Modifică punctele de viață"
                                                title="Click pentru Heal sau Damage"
                                            <% } %>
                                        >
                                            <span class="cellHp_current"><%= character.hp?.currentHP_left ?? character.calculatedMaxHP ?? character.hp?.fullHP ?? "—" %></span> /
                                            <span class="cellHp_max"><%= character.calculatedMaxHP ?? character.hp?.fullHP ?? "—" %></span>
                                        </div>
                                        <div class="health-bar">
                                            
                                            <hr class="health-bar-bg">
                                            <hr class="health-bar-fill">
                                        </div>
                                    <% } else if (combatant.type === "enemy") { %>
                                        <div
                                            class="cellHp <%= isOwner ? 'cellHp--editable' : '' %>"
                                            <% if (isOwner) { %>
                                                data-enemy-id="<%= combatant.id %>"
                                                data-hp-type="enemy"
                                                aria-label="Modifică punctele de viață ale monstrului"
                                                title="Click pentru Heal sau Damage"
                                            <% } %>
                                        >
                                            <span class="cellHp_current"><%= combatant.currentHP ?? "—" %></span> /
                                            <span class="cellHp_max"><%= combatant.maximumHP ?? "—" %></span>
                                        </div>
                                        <div class="health-bar">
                                            
                                            <hr class="health-bar-bg">
                                            <hr class="health-bar-fill">
                                        </div>
                                    <% } else { %>
                                        <div class="cellHp">—</div>
                                    <% } %>
                                </div>

                                <div class="ac">
                                    <div class="cellAc">
                                        <div class="shield"><%= character ? character.calculatedAC : combatant.type === "enemy" && Number.isFinite(combatant.armorClass) ? combatant.armorClass : "—" %></div>
                                    </div>
                                </div>

                                <div class="conditions">
                                    <div class="conditionsWrapper">
                                        <% if (character && character.condition && character.condition.length) { %>
                                            <% character.condition.forEach((condition) => { %>
                                                <% const conditionIndex = String(condition.index || condition.category_name || "condition").toLowerCase(); %>
                                                <% const conditionDefinition = conditions.find((entry) => entry.index === conditionIndex); %>
                                                <% const conditionLabel = conditionDefinition?.name || condition.index || condition.category_name || "Condition"; %>
                                                <span
                                                    class="condition <%= conditionIndex.replace(/[^a-z0-9_-]/g, '-') %>"
                                                    <% if (conditionDefinition?.color) { %>
                                                        style="--condition-background: <%= conditionDefinition.color %>"
                                                    <% } %>
                                                >
                                                    <span class="conditionLabel">
                                                        <%= conditionLabel %>
                                                    </span>
                                                    <form
                                                        class="conditionDeleteForm"
                                                        action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession._id %>/conditions/delete"
                                                        method="post"
                                                        data-character-id="<%= combatant.charID %>"
                                                        data-condition-index="<%= condition.index || '' %>"
                                                    >
                                                        <button
                                                            type="submit"
                                                            class="conditionDeleteButton"
                                                            aria-label="Delete <%= conditionLabel %> condition"
                                                            title="Delete condition"
                                                        >
                                                            <i class="fa-solid fa-xmark"></i>
                                                        </button>
                                                    </form>
                                                </span>
                                            <% }); %>
                                        <% } else { %>
                                            <span>—</span>
                                        <% } %>
                                    </div>
                                </div>

                                <div class="notes">
                                    <button
                                        type="button"
                                        id="options_<%= combatant.id %>_btn"
                                        class="user_more_options_JS participantActionButton JS_moreOptionsButton_combatParticipant"
                                        data-participant-id="<%= combatant.type === 'character' ? combatant.charID : '' %>"
                                        data-participant-type="<%= combatant.type === 'character' ? 'player' : 'enemy' %>"
                                        aria-label="Participant actions"
                                    >
                                        <i class="fa-solid fa-ellipsis-vertical"></i>
                                    </button>
                                </div>
                            </article>
                        <% }); %>
                        <% if (!activeEncounterCombatants.length) { %>
                            <p>No active combatants.</p>
                        <% } %>

                    </div>
                </div>

                <% if (isOwner) { %>
                <div class="combatTools">

                    <form
                        action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : '' %>/encounter-builder/cleanup"
                        method="post"
                    >
                        <button
                            class="addStuff_button"
                            type="submit"
                            name="action"
                            value="removeDeadEnemies"
                            <%= !isOwner || !selectedSession ? "disabled" : "" %>
                        >
                            ⚔ Remove Dead Enemies
                        </button>
                    </form>

                    <form
                        action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : '' %>/encounter-builder/cleanup"
                        method="post"
                    >
                        <button
                            class="addStuff_button"
                            type="submit"
                            name="action"
                            value="removeAllEnemies"
                            <%= !isOwner || !selectedSession ? "disabled" : "" %>
                        >
                            ⚔ Remove All Enemies
                        </button>
                    </form>

                </div>
                <% } %>




                <!-- =========================================================
                    POPUP - PARTICIPANT ACTION MENU
                    ========================================================= -->

                <div
                    id="participantActionMenu"
                    class="participantActionMenu"
                    role="menu"
                    aria-hidden="true"
                >

                    <div class="participantMenuHeader">

