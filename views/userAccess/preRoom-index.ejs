  <div id="loadingPopup" class="loading-popup">
    <div id="countdown" class="countdown"></div>
  </div>

  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon positionRelative activeBar" 
    onclick="change(this); window.location.href='/preRoom-index'">
    <% if (allPages_RoomNotif && allPages_RoomNotif.length > 0) { %>
      <% allPages_RoomNotif.forEach(room => { %>
  
        <% room.notification.forEach(notif => { %>
          <!-- verifica daca se potriveste motivul sau categoria  -->
          <% if (notif.reason == "time" || notif.reason == "date" || notif.reason == "location" || notif.reason == "boardGame" || notif.reason == "new_msg") { %>
            <!-- acceseaza lista de user care au vazut  -->
            <% notif.notificationStatus.forEach(userStat => { %>
              <!-- verifica daca se potriveste cu userul curent  -->
              <% if (userStat.participantID.toString() == user._id.toString()) { %>
                <% if (userStat.theActualNotifItem == "new_time" || userStat.theActualNotifItem == "new_date" || userStat.theActualNotifItem == "new_location" || userStat.theActualNotifItem == "new_boardGame" || userStat.theActualNotifItem == "new_msg" ) { %>
                  <i class="fa-solid fa-circle fa-2xs notificationDot"></i>
                <% } %>
              <% } %>
            <% }); %>
          <% } %>
        <% }); %>
  
      <% }); %>
    <% } else { %>
      <!-- <p>No notification found</p> -->
    <% } %>
    </ion-icon>
    <ion-icon name="home-outline" class="icon " 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
  </div>




