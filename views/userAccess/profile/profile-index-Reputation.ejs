<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="/img/title/titleIcon65.png">


    <link rel="stylesheet" href="/css/profile_reputation.css">
    <link rel="stylesheet" href="/css/elements/header.css">
    <link rel="stylesheet" href="/css/elements/botNavBar.css">
    <link rel="stylesheet" href="/css/elements/standardAll.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
    
</head>
<body>

  <%- include('../../layouts/header') %>



  <!-- User Profile Avatar  -->
  <ul class="position_avatar">
    <div class="userID">
      <div class="avatarImg">
        <img class="profileGuest" src="/userImages/<%= user.images %>">
      </div>
      <div name="dosarRep">
        <% let groupedData_honer = []; %>
        <% let groupedData_stain = []; %>
      
        <% if (userPlus) { %>
          <p> <%= userPlus.allReputation %> </p>
              
              <% userPlus.allReputation.forEach(reputation => { %>
                <p> <%= reputation %> </p>
                <!-- match with honor  -->
                <% if (importHonorDetail && importHonorDetail.length > 0) { %>
                  <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
      
                    <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                      <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                        <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                          <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                            <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                              <% groupedData_honer.push(subCategory); %>
                            <% }; %>
                          <% }); %>
                        <% } %>
                      <% }); %>
                    <% }); %>
      
                  <% }); %>
                <% } %>
      
                <!-- match with stain  -->
                <% if (importStainDetail && importStainDetail.length > 0) { %>
                  <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
      
                    <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                      <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                        <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                          <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                            <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                              <% groupedData_stain.push(subCategory); %>
                            <% }; %>
                          <% }); %>
                        <% } %>
                      <% }); %>
                    <% }); %>
      
                  <% }); %>
                <% } %>
      
      
              <% }); %>
          
        <% } %>
      </div>
      <div class="reputationBox">
        <div class="honors">
          <% if (groupedData_honer && groupedData_honer.length > 0) { %>
            <!-- Shuffle the badReputation array -->
            <% const owner_shuffled_honer = groupedData_honer.sort(() => Math.random() - 0.5); %>
            <% owner_shuffled_honer.slice(0, 2).forEach(item => { %>
              <div class="honor1" title="<%= item.description %>">
                <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
              </div>
            <% }) %>
          <% } %>
        </div>
        <div class="redFlags">
          <% if (groupedData_stain && groupedData_stain.length > 0) { %>
            <!-- Shuffle the badReputation array -->
            <% const owner_shuffled_stain = groupedData_stain.sort(() => Math.random() - 0.5); %>
            <% owner_shuffled_stain.slice(0, 1).forEach(item => { %>
              <div class="flag1" title="<%= item.description %>">
                <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </div>
  </ul>

  <div class="centerV pairBtn">
    <div class="centerV ">
      <button class="tab_reputation_btn honor_JS_btn">Honor</button>
      <button class="tab_reputation_btn stain_JS_btn">Stain</button>
    </div>
    <button class="tab_reputation_btn Feedback_JS_btn">Feedback</button>
  </div>
  
  <!-- Honor  - xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-->
  <ul id="honor_section" class="honeycomb ">
    <!-- match with honor  -->
    <% if (importHonorDetail && importHonorDetail.length > 0) { %>
      <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>

        <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
          <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
            <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
              <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 

                <!-- check if the reputation is a match  -->
                <% let repIsAMatch = false %>
                <% if (userPlus) { %>
                  <!-- <p> userPlus.allReputation  </p> -->
                      <% userPlus.allReputation.forEach(reputation => { %>
                        <!-- <p>  reputation </p> -->
                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                          <% repIsAMatch = true %>
                        <% }; %>
                      <% }); %>
                <% } %>

                <!-- Display the reputation  -->
                <% if (repIsAMatch) { %>
                  <li type="submit" class="honeycomb-cell honorBackground" >
                    <img src="/img/reputation/<%= subCategory.type %>/<%= subCategory.fileCateg %>/<%= subCategory.name %>" class="honeycomb-cell_img" alt="<%= subCategory.report_title %>">
                    <div class="honeycomb-cell_title"> <%= subCategory.displayName %> </div>
                  </li>
                <% } else if (!repIsAMatch) { %>
                  <li type="submit" class="honeycomb-cell " >
                    <img src="/img/reputation/<%= subCategory.type %>/<%= subCategory.fileCateg %>/<%= subCategory.name %>" class="honeycomb-cell_img" alt="<%= subCategory.report_title %>">
                    <div class="honeycomb-cell_title"> <%= subCategory.displayName %> </div>
                  </li>
                <% }; %>


              <% }); %>
            <% } %>
          <% }); %>
        <% }); %>

      <% }); %>
    <% } %>



  </ul>


  <% if (user._id.toString() === userSession._id.toString()) { %>
    <!-- Feedback  - xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-->
    <ul id="feedback_section" class="honeycomb ">
      <!-- match with feedback  -->
      <% if (importFeedbackDetail && importFeedbackDetail.length > 0) { %>
        <% Object.entries(importFeedbackDetail).forEach(([nothing, nothing2]) => { %>
  
          <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
            <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
              <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
  
                  <!-- check if the reputation is a match  -->
                  <% let repIsAMatch = false %>
                  <% if (userPlus) { %>
                    <!-- <p> userPlus.allReputation  </p> -->
                        <% userPlus.allReputation.forEach(reputation => { %>
                          <!-- <p>  reputation </p> -->
                          <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                            <% repIsAMatch = true %>
                          <% }; %>
                        <% }); %>
                  <% } %>
  
                  <!-- Display the reputation  -->
                  <% if (repIsAMatch) { %>
                    <li type="submit" class="honeycomb-cell feedbackBackground" >
                      <img src="/img/reputation/<%= subCategory.type %>/<%= subCategory.fileCateg %>/<%= subCategory.name %>" class="honeycomb-cell_img" alt="<%= subCategory.report_title %>">
                      <div class="honeycomb-cell_title"> <%= subCategory.displayName %> </div>
                    </li>
                  <% } else if (!repIsAMatch) { %>
                    <li type="submit" class="honeycomb-cell " >
                      <img src="/img/reputation/<%= subCategory.type %>/<%= subCategory.fileCateg %>/<%= subCategory.name %>"
                        class="honeycomb-cell_img"
                        alt="<%= subCategory.report_title %>"
                        >
  
                      <div class="honeycomb-cell_title"> <%= subCategory.displayName %> </div>
                    </li>
                  <% }; %>
  
  
                <% }); %>
              <% } %>
            <% }); %>
          <% }); %>
  
        <% }); %>
      <% } %>
  
  
  
    </ul>
  <% } %>



  <!-- Stain  - xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-->
  <ul id="stain_section" class="honeycomb ">
    <!-- match with stain  -->
    <% if (importStainDetail && importStainDetail.length > 0) { %>
      <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
  
        <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
          <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
            <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
              <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
  
                <!-- check if the reputation is a match  -->
                <% let repIsAMatch = false %>
                <% if (userPlus) { %>
                  <!-- <p> userPlus.allReputation  </p> -->
                      <% userPlus.allReputation.forEach(reputation => { %>
                        <!-- <p>  reputation </p> -->
                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                          <% repIsAMatch = true %>
                        <% }; %>
                      <% }); %>
                <% } %>
  
                <!-- Display the reputation  -->
                <% if (repIsAMatch) { %>
                  <li type="submit" class="honeycomb-cell stainBackground" >
                    <img src="/img/reputation/<%= subCategory.type %>/<%= subCategory.fileCateg %>/<%= subCategory.name %>" class="honeycomb-cell_img" alt="<%= subCategory.report_title %>">
                    <div class="honeycomb-cell_title"> <%= subCategory.displayName %> </div>
                  </li>
                <% } else if (!repIsAMatch) { %>
                  <li type="submit" class="honeycomb-cell " >
                    <img src="/img/reputation/<%= subCategory.type %>/<%= subCategory.fileCateg %>/<%= subCategory.name %>" class="honeycomb-cell_img" alt="<%= subCategory.report_title %>">
                    <div class="honeycomb-cell_title"> <%= subCategory.displayName %> </div>
                  </li>
                <% }; %>
  
  
              <% }); %>
            <% } %>
          <% }); %>
        <% }); %>
  
      <% }); %>
    <% } %>
  
  
  
  </ul>









  <!-- additional bottom bar - profile   -->
  <% if (user._id.toString() === userSession._id.toString()) { %>
    <!-- additional bottom bar - profile   -->
    <nav class="bottom-bar-profile">
      <a href='/userProfile/<%= userSession._id %>' class="currentProfileLocation paddingBar-left " >Profile</a>
      <a href='/userProfile-Reputation/<%= userSession._id %>' class="currentProfileLocation activeProfileLocation-Tab" >Reputation</a>
      <a href='/userProfile-Bg/<%= userSession._id %>' class="currentProfileLocation bgbar " >Board Games</a>
      <!-- <a href='/userProfile-History' class="currentProfileLocation" onclick="changeProfBar(this, 3)">History</a> -->
    </nav>
    <% } else { %>
        <!-- additional bottom bar - profile   -->
    <nav class="bottom-bar-profile">
      <a href='/userProfile/<%= user._id %>' class="currentProfileLocation paddingBar-left " >Profile</a>
      <a href='/userProfile-Reputation/<%= user._id %>' class="currentProfileLocation activeProfileLocation-Tab" >Reputation</a>
      <a href='/userProfile-Bg/<%= user._id %>' class="currentProfileLocation bgbar " >Board Games</a>
    </nav>
    <% } %>



  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <% if (user._id.toString() === userSession._id.toString()) { %>
      <ion-icon name="person-outline" class="icon activeBar" 
      onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <% } else { %>
      <button class="customReturn activeBar" title="Return to your Profile"><i class="fa-solid fa-person-walking-arrow-loop-left" onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'"></i></button>
    <% } %>
    <ion-icon name="folder-outline" class="icon" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon " 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
  </div>





  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script src="/js/profile_reputation.js"></script>
  <script src="/js/header.js"></script>
</body>
</html>