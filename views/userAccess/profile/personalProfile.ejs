<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="img/title/titleIcon65.png">


    <link rel="stylesheet" href="css/personalProfile.css">
    <link rel="stylesheet" href="css/elements/header.css">
    <link rel="stylesheet" href="css/elements/botNavBar.css">
    <link rel="stylesheet" href="css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>
  <%- include('../../layouts/header') %>

  <div class="thePage">
    <form action="/editProfile" method="POST" enctype="multipart/form-data" class="container">
      <div class="accountDetails">
        <div class="title">
          <h2>Account</h2>
          <h5>Edit your account information</h5>
        </div>
        <div class="profile_div ">
          <h4 class="categoryTitles">Profile Details</h4>
          <hr>

          <div class="profImg_div">
            <img class="prof_pic" src="/userImages/<%= user.images %>" alt=""> 
          </div>
          <div class="profileDetails">
            <div class="known_div inside_divs_profileDetails">
              <input type="file" class=" imageInput" name="image" >
              <input type="hidden" name="user_id" value="<%= user._id %>">
            </div>
            <div class="known_div inside_divs_profileDetails">
              <input type="checkbox" class="checkbox" >
              <p class="names_p">Known As:</p> 
              <input 
              type="text" placeholder="Add Known as"
              value="<%= user.yourName%>"  class="form-control yourName" id="yourName" name="yourName" aria-describedby="yourNameHelp" autocomplete="off"  required>
            </div>
            <div class="firstName_div inside_divs_profileDetails">
              <input type="checkbox" class="checkbox" >
              <p class="names_p">First Name:</p> 
              <input 
              type="text" placeholder="Add First Name"
              value="<%= user.firstName%>"
                class="form-control firstName" id="firstName" name="firstName" aria-describedby="firstNameHelp" autocomplete="off"  required>
            </div>
            <div class="lastName inside_divs_profileDetails">
              <input type="checkbox" class="checkbox" >
              <p class="names_p">Last Name:</p> 
              <input 
              type="text" placeholder="Add Last Name"
              value="<%= user.lastName%>"  class="form-control lastName" id="lastName" name="lastName" aria-describedby="lastNameHelp" autocomplete="off"  required>
            </div>
            
          </div>




        </div>

        <div class="email_div">
          <h4 class="categoryTitles">Email Address</h4>
          <hr>
          <div class="firstName_div inside_divs_profileDetails">
            <!-- <input type="checkbox" class="checkbox" > -->
            <p class="names_p"><%= user.email%></p> 

          </div>

        </div>
        <div class="phone_div">
          <h4 class="categoryTitles">Phone Number</h4>
          <hr>
          <input 
              type="tel" placeholder="Your phone number"
              value="<%= user.phone %>" class="form-control phone" id="phone" name="phone" aria-describedby="phoneHelp" autocomplete="off"  required>
        </div>
      </div>
  
      <!-- <div class="password_div">
        <h4 class="categoryTitles">Password</h4>
        <hr>
        <div class="passDot">
          <div class="pass_div">
            <input 
            type="text" 
            placeholder="**********" class="form-control yourName" class="form-control password" id="password" name="password" aria-describedby="passwordHelp" autocomplete="off" required>
          </div>
        </div>
      </div> -->
      <button type="submit" class="btn btn-primary customBtn" value="Save and Update Profile">Save and Update Profile</button>
    </form>
  </div>











  <div id="loadingPopup" class="loading-popup">
    <div id="countdown" class="countdown"></div>
  </div>


  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon activeBar" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon " 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
  </div>


  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script src="js/profile-script.js"></script>
  <script src="js/header.js"></script>
</body>
</html>