<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="img/title/titleIcon65.png">

    <link rel="stylesheet" href="css/feedback.css">
    <link rel="stylesheet" href="css/elements/header.css">
    <link rel="stylesheet" href="css/elements/botNavBar.css">
    <link rel="stylesheet" href="css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>


  <form action="/feedbackus" method="post" class="container">
    <% if (sent && sent.length > 0) { %>
      <h3>Thanks for sharing your feedback with us!</h3>
      <p class="return_home">This really helps us to improve.</p>
      <p>You will now be redirected to the main page</p>
      
    <% } else { %>
      <h3>Share your thoughts with us</h3>
      <!-- <hr> -->
      <div class="orgRow">
        <div class="items">
          <div class="item">
            <input type="checkbox" id="feature_ideas"  name="checkbox" value="ideas">
            <label for="feature_ideas">Feature Ideas</label>
          </div>
          <div class="item">
            <input type="checkbox" id="replace" name="checkbox" value="replace">
            <label for="replace">Replace a design with </label>
          </div>
          <div class="item">
            <input type="checkbox" id="bug" name="checkbox" value="bug">
            <label for="bug">It doesn't work</label>
          </div>
          <div class="item">
            <input type="checkbox" id="other" name="checkbox" value="other">
            <label for="other">Something else..</label>
          </div>
  
  
  
          
          
        </div>
        <input type="hidden" name="userSessionID" value="<%= user._id %>">
        <input type="hidden" name="date" value="<%= date %>">
        <!-- <hr> -->
        <textarea class="feedbackMsg" name="description" cols="30" rows="10" placeholder="Share as many details as you can, such as: 'where', 'what happen', 'when', 'from where to where', 'what where you expecting'. "></textarea>
      </div>
      <hr>
      <button type="submit">Send</button>
    <% } %>
    
  </form>

    <!-- Bottom bar  -->
    <div class="bottom-bar">
      <ion-icon name="home-outline" class="icon" 
      onclick="change(this); window.location.href='/index'">
      </ion-icon>
      <ion-icon name="add-circle-outline" class="icon longLoading" 
      onclick="change(this); window.location.href='/createRoom-index'" >
      </ion-icon>
      <!-- <ion-icon name="image-outline" class="icon" 
      onclick="change(this); window.location.href='/gallery'">
      </ion-icon> -->
      <div class="titleNav_div">
        <!-- <p class="titleNav">N a v i g a t i o n &nbsp; B a r</p> -->
      </div>
    </div>



  <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script src="js/layouts/header.js"></script>
  <script src="js/layouts/navBar.js"></script>
  <script src="js/feedback.js"></script>
</body>
</html>