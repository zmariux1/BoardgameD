<%
    /*
     * NAVIGARE D&D (desktop + mobile)
     * Include:  include('<cale>/piese/dnd_nav', { userId, activeNav: 'home' })
     * activeNav: 'home' | 'chars' | 'globalCampaigns' | 'myCampaigns'
     * CSS: /css/dnd/piese/dnd_nav.css (link in <head>)
     * JS:  /js/dnd/dnd_nav.js (inclus mai jos)
     */
    const navActive = typeof activeNav !== 'undefined' ? activeNav : '';
    const navLinks = [
    { key: 'home', href: `/${userId}/dnd`, icon: '⌂', label: 'D&D Home', mobileLabel: 'D&D Home' },
    { key: 'chars', href: `/${userId}/dnd/myChars`, icon: '◈', label: 'Characters', mobileLabel: 'My Chars' },
    { key: 'globalCampaigns', href: `/${userId}/dnd/globalCampaigns`, icon: '⚑', label: 'GlobalCampaigns', mobileLabel: 'Global Campaigns' },
    { key: 'myCampaigns', href: `/${userId}/dnd/myCampaigns`, icon: '⚔', label: 'My DM Campaigns', mobileLabel: 'My DM Campaigns' },
    { key: 'exit', href: '/index', icon: '⌂', label: 'Exit D&D', mobileLabel: 'Exit D&D' }
    ];
%>
<header class="characters-navbar">
    <div class="characters-navbar__inner">
        <a
            href="/<%= userId %>/dnd"
            class="characters-navbar__logo"
            aria-label="D&D Home"
        >
            <span class="characters-navbar__logo-symbol" aria-hidden="true">◈</span>
        </a>

        <nav class="characters-navbar__nav" aria-label="Navigare principală">
            <% navLinks.forEach(function(link) { %>
                <a
                    href="<%= link.href %>"
                    class="characters-navbar__link<%= navActive === link.key ? ' characters-navbar__link--active' : '' %>"
                    <%- navActive === link.key ? 'aria-current="page"' : '' %>
                >
                    <span class="characters-navbar__link-icon" aria-hidden="true"><%= link.icon %></span>
                    <span><%= link.label %></span>
                </a>
            <% }); %>
        </nav>

        <a href="/editProfile" class="characters-navbar__user" aria-label="Profilul utilizatorului">
            <div class="characters-navbar__avatar">
                <img src="/images/user-avatar.jpg" alt="">
            </div>
            <span class="characters-navbar__user-arrow" aria-hidden="true">⌄</span>
        </a>

        <button
            type="button"
            class="characters-navbar__mobile-toggle"
            id="charactersMobileToggle"
            aria-label="Deschide navigarea"
            aria-expanded="false"
            aria-controls="charactersMobileNav"
        >
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <nav class="characters-navbar__mobile" id="charactersMobileNav" aria-label="Navigare mobilă">
        <% navLinks.forEach(function(link) { %>
            <a
                href="<%= link.href %>"
                <%- navActive === link.key ? 'class="characters-navbar__mobile-link--active" aria-current="page"' : '' %>
            ><%= link.mobileLabel %></a>
        <% }); %>
        <a href="/editProfile">Profile</a>
    </nav>
</header>

<script src="/js/dnd/dnd_nav.js"></script>
