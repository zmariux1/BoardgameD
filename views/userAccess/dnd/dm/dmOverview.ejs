                    <div class="questModal-titleWrap">

                        <div class="questModal-questIcon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 2l2.2 3.9L18 8.1l-3.8 2.2L12 14l-2.2-3.7L6 8.1l3.8-2.2L12 2z"/>
                                <circle cx="12" cy="12" r="9"/>
                                <path d="M12 7v10M7 12h10"/>
                            </svg>
                        </div>

                        <h2 id="quest-title">
                            Quest
                        </h2>
                        <input type="text" placeholder="Quest Name" name="title" value="" class="questModal-titleInput questModal-edit-input" hidden required maxlength="120">

                    </div>

                    <div class="questModal-headerActions">

                        <!-- EDIT -->
                        <button
                            class="questModal-iconButton questModal-edit"
                            type="button"
                            aria-label="Edit quest"
                            title="Edit quest"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M4 16.5V20h3.5L18.8 8.7l-3.5-3.5L4 16.5z"/>
                                <path d="M14 6l3.5 3.5"/>
                            </svg>
                        </button>

                        <!-- CLOSE -->
                        <button
                            class="questModal-iconButton questModal-close NotesExistJS"
                            type="button"
                            aria-label="Close quest"
                            title="Close"
                        >
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M6 6l12 12M18 6L6 18"/>
                            </svg>
                        </button>

                    </div>

                </header>


                <!-- Decorative divider -->
                <div class="questModal-divider">
                    <span></span>
                </div>


                <!-- =========================
                    QUEST META
                ========================== -->
                <section class="questModal-meta">

                    <div class="questModal-metaRow">

                        <div class="questModal-metaIcon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12z"/>
                                <circle cx="12" cy="9" r="2.5"/>
                            </svg>
                        </div>

                        <div class="questModal-metaContent">
                            <span class="questModal-label">
                                Location
                            </span>

                            <span class="questModal-value questModal-value--location"></span>
                        </div>

                    </div>


                    <div class="questModal-metaRow">

                        <div class="questModal-metaIcon">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <circle cx="12" cy="7" r="4"/>
                                <path d="M4 21c.8-4.1 3.2-6 8-6s7.2 1.9 8 6"/>
                            </svg>
                        </div>

                        <div class="questModal-metaContent">
                            <span class="questModal-label">
