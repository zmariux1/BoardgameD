                    >
                        ×
                    </button>

                </header>


                <!-- =========================================
                    SETTINGS
                ========================================== -->

                <div class="weather-popup__body">


                    <!-- TIME OF DAY -->

                    <div class="weather-setting">

                        <label
                            class="weather-setting__label"
                            for="weather-time"
                        >
                            <span
                                class="weather-setting__icon"
                                aria-hidden="true"
                            >
                                ☼
                            </span>

                            <span class="weather-setting__label-text">
                                TIME OF DAY
                            </span>
                        </label>


                        <div class="weather-select">

                            <select id="weather-time" name="time_of_day">
                                <option value="morning" <%= weatherSelections.time_of_day === 'morning' ? 'selected' : '' %>>
                                    Morning
                                </option>
                                <option value="noon" <%= weatherSelections.time_of_day === 'noon' ? 'selected' : '' %>>
                                    Noon
                                </option>
                                <option value="evening" <%= weatherSelections.time_of_day === 'evening' ? 'selected' : '' %>>
                                    Evening
                                </option>
                                <option value="night" <%= weatherSelections.time_of_day === 'night' ? 'selected' : '' %>>
                                    Night
                                </option>
                            </select>

                            <span
                                class="weather-select__arrow"
                                aria-hidden="true"
                            >
                                ▾
                            </span>

                        </div>

                    </div>



                    <!-- ATMOSPHERIC CONDITIONS -->

                    <div class="weather-setting">

                        <label
                            class="weather-setting__label"
                            for="weather-condition"
                        >
                            <span
                                class="weather-setting__icon"
                                aria-hidden="true"
                            >
                                ☁
                            </span>

                            <span class="weather-setting__label-text">
                                Sky Conditions
                            </span>
                        </label>


                        <div class="weather-select">

                            <select id="weather-condition" name="Atmospheric_conditions">
                                <option value="clear" <%= weatherSelections.Atmospheric_conditions === 'clear' ? 'selected' : '' %>>
                                    None
                                </option>
                                <option value="cloudy" <%= weatherSelections.Atmospheric_conditions === 'cloudy' ? 'selected' : '' %>>
                                    Cloudy
                                </option>
                                <option value="fog" <%= weatherSelections.Atmospheric_conditions === 'fog' ? 'selected' : '' %>>
                                    Fog
                                </option>
                                <option value="rainy" <%= weatherSelections.Atmospheric_conditions === 'rainy' ? 'selected' : '' %>>
                                    Rain
                                </option>
                                <option value="stormy" <%= weatherSelections.Atmospheric_conditions === 'stormy' ? 'selected' : '' %>>
                                    Storm
                                </option>
                                <option value="snowy" <%= weatherSelections.Atmospheric_conditions === 'snowy' ? 'selected' : '' %>>
                                    Snow
                                </option>
                            </select>

                            <span
                                class="weather-select__arrow"
                                aria-hidden="true"
                            >
                                ▾
                            </span>

                        </div>

                    </div>



                    <!-- TEMPERATURE -->

                    <div class="weather-setting">

                        <label
                            class="weather-setting__label"
                            for="weather-temperature"
                        >
                            <span
                                class="weather-setting__icon"
                                aria-hidden="true"
                            >
                                ♨
                            </span>

                            <span class="weather-setting__label-text">
                                TEMPERATURE
                            </span>
                        </label>


                        <div class="weather-select">

                            <select id="weather-temperature" name="temperature">
                                <option value="freezing" <%= weatherSelections.temperature === 'freezing' ? 'selected' : '' %>>
                                    Freezing
                                </option>
                                <option value="cold" <%= weatherSelections.temperature === 'cold' ? 'selected' : '' %>>
                                    Cold
                                </option>
                                <option value="normal" <%= weatherSelections.temperature === 'normal' ? 'selected' : '' %>>
                                    Normal
                                </option>
                                <option value="warm" <%= weatherSelections.temperature === 'warm' ? 'selected' : '' %>>
                                    Warm
                                </option>
                                <option value="hot" <%= weatherSelections.temperature === 'hot' ? 'selected' : '' %>>
                                    Hot
                                </option>
                                <option value="extreme" <%= weatherSelections.temperature === 'extreme' ? 'selected' : '' %>>
                                    Extreme
                                </option>
                            </select>

                            <span
                                class="weather-select__arrow"
                                aria-hidden="true"
                            >
                                ▾
                            </span>

                        </div>

                    </div>



                    <!-- WIND -->

                    <div class="weather-setting">

                        <label
                            class="weather-setting__label"
                            for="weather-wind"
                        >
                            <span
                                class="weather-setting__icon weather-setting__icon--wind"
                                aria-hidden="true"
                            >
                                ≋
                            </span>

                            <span class="weather-setting__label-text">
                                WIND
                            </span>
                        </label>


                        <div class="weather-select">

                            <select id="weather-wind" name="wind">
                                <option value="light" <%= weatherSelections.wind === 'light' ? 'selected' : '' %>>
                                    Light
                                </option>
                                <option value="average" <%= weatherSelections.wind === 'average' ? 'selected' : '' %>>
                                    Average
                                </option>
                                <option value="strong" <%= weatherSelections.wind === 'strong' ? 'selected' : '' %>>
                                    Strong
                                </option>
                                <option value="challenging" <%= weatherSelections.wind === 'challenging' ? 'selected' : '' %>>
                                    Challenging
                                </option>
                                <option value="tornado" <%= weatherSelections.wind === 'tornado' ? 'selected' : '' %>>
                                    Tornado
                                </option>
                            </select>

                            <span
                                class="weather-select__arrow"
                                aria-hidden="true"
                            >
                                ▾
                            </span>

                        </div>

                    </div>

                    <!-- Terrain -->

                    <div class="weather-setting">

                        <label
                            class="weather-setting__label"
                            for="weather-terrain"
                        >
                            <span
                                class="weather-setting__icon weather-setting__icon--terrain"
                                aria-hidden="true"
                            >
                                ≋
                            </span>

                            <span class="weather-setting__label-text">
                                TERRAIN
                            </span>
                        </label>


                        <div class="weather-select">

                            <select id="weather-terrain" name="terrain">
                                <option value="normal land" <%= weatherSelections.terrain === 'normal land' ? 'selected' : '' %>>
                                    Normal Land (solid)
                                </option>
                                <option value="snow" <%= weatherSelections.terrain === 'snow' ? 'selected' : '' %>>
                                    Snow (difficult)
                                </option>
                                <option value="swamp" <%= weatherSelections.terrain === 'swamp' ? 'selected' : '' %>>
                                    Swamp (difficult)
                                </option>
                                <option value="water" <%= weatherSelections.terrain === 'water' ? 'selected' : '' %>>
                                    Water (difficult)
                                </option>
                                <option value="lava" <%= weatherSelections.terrain === 'lava' ? 'selected' : '' %>>
                                    Lava (difficult)
                                </option>
                            </select>

                            <span
                                class="weather-select__arrow"
                                aria-hidden="true"
                            >
                                ▾
                            </span>

                        </div>

                    </div>

                    <!-- Air -->

                    <!-- <div class="weather-setting">

                        <label
                            class="weather-setting__label"
                            for="weather-wind"
                        >
                            <span
                                class="weather-setting__icon weather-setting__icon--wind"
                                aria-hidden="true"
                            >
                                ≋
                            </span>

                            <span class="weather-setting__label-text">
                                WIND
                            </span>
                        </label>


                        <div class="weather-select">

                            <select id="weather-wind" name="weather-wind">
                                <option value="light">
                                    Light
                                </option>
                                <option value="average" selected>
                                    Average
                                </option>
                                <option value="strong">
                                    Strong
                                </option>
                                <option value="challenging">
                                    Challenging
                                </option>
                                <option value="tornado">
                                    Tornado
                                </option>
                            </select>

                            <span
                                class="weather-select__arrow"
                                aria-hidden="true"
                            >
                                ▾
                            </span>

                        </div>

                    </div> -->

                </div>



                <!-- =========================================
                    FOOTER
                ========================================== -->

                <footer class="weather-popup__footer">
                    <p class="weather-popup__save-message" role="status" aria-live="polite" hidden></p>

                    <button
                        class="weather-popup__apply"
                        type="submit"
                        <%= isOwner && selectedSession ? '' : 'disabled' %>
                    >

                        <span
                            class="weather-popup__apply-icon"
                            aria-hidden="true"
                        >
                            ✓
                        </span>

                        APPLY

                    </button>

                </footer>

            </div>

        </form>
        <% } %>




        
     </main>
    <% } else { %>
        <main class="flex-grow-1">
            <p role="status">No sessions exist for this campaign yet. The campaign owner can prepare one from the session dropdown.</p>
        </main>
    <% } %>





    <% if (isOwner) { %>

        <!-- SESSION SETTINGS MODAL -->
        <div
            class="sessionSettingsModal"
            id="sessionSettingsModal"
            aria-hidden="true"
        >

            <form
                class="sessionSettingsDialog"
                id="sessionSettingsForm"
                role="dialog"
                aria-modal="true"
                aria-labelledby="sessionSettingsTitle"
                action="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : "" %>"
                method="POST"
                data-session-update-enabled="<%= selectedSession && selectedSession.status === "inDevelopment" ? "true" : "false" %>"
            >

                <div class="sessionSettingsHeader">

                    <div>
                        <p class="sessionSettingsEyebrow">Session timer</p>
                        <h3 id="sessionSettingsTitle">Set session countdown</h3>
                    </div>

                    <button
                        type="button"
                        class="sessionSettingsClose"
                        aria-label="Close session timer settings"
                    >
                        <i class="fa-solid fa-xmark"></i>
                    </button>

                </div>

                <div class="sessionSettingsBody">

                    <div class="sessionSettingsMode">

                        <label class="sessionModeOption">
                            <input
                                type="radio"
                                name="sessionMode"
                                value="duration"
                                checked
                            >
                            <span>Set allocated time</span>
                        </label>

                        <label class="sessionModeOption">
                            <input
                                type="radio"
                                name="sessionMode"
                                value="endTime"
                            >
                            <span>Set end time</span>
                        </label>

                    </div>

                    <div class="sessionSettingsField sessionFieldDuration">

                        <label for="sessionDurationMinutesInput">
                            Allocated time (minutes)
                        </label>

                        <input
                            id="sessionDurationMinutesInput"
                            type="number"
                            min="1"
                            max="1440"
                            step="1"
                            value="135"
                        >

                    </div>

                    <div
                        class="sessionSettingsField sessionFieldEndTime"
                        hidden
                    >

                        <label for="sessionEndTimeInput">
                            Session end time
                        </label>

                        <input
                            id="sessionEndTimeInput"
                            type="datetime-local"
                            data-end-date="<%= selectedSession && selectedSession.end_date ? new Date(selectedSession.end_date).toISOString() : "" %>"
                        >

                    </div>

                    <% if (selectedSession && selectedSession.status === "inDevelopment") { %>

                        <input
                            type="hidden"
                            name="name"
                            value="<%= selectedSession.name || "" %>"
                        >

                        <div class="sessionSettingsField sessionFieldStartDate">

                            <label for="sessionStartDateInput">
                                Session start date and time
                            </label>

                            <input
                                id="sessionStartDateInput"
                                name="start_date"
                                type="datetime-local"
                                step="60"
                                data-start-date="<%= selectedSession.start_date ? new Date(selectedSession.start_date).toISOString() : "" %>"
                            >

                        </div>

                    <% } %>

                    <p
                        class="sessionSettingsSaveMessage"
                        id="sessionSettingsSaveMessage"
                        role="status"
                        aria-live="polite"
                        hidden
                    ></p>

                </div>

                <div class="sessionSettingsActions">

                    <button
                        type="button"
                        class="sessionSettingsCancel"
                    >
                        Cancel
                    </button>

                    <button
                        type="button"
                        class="sessionSettingsApply"
                    >
                        Apply
                    </button>

                </div>

            </form>

        </div>
        <!-- END SESSION SETTINGS MODAL -->


        <!-- HP ADJUSTMENT MODAL -->
        <div
            id="hpAdjustmentModal"
            class="hpAdjustmentModal"
            data-endpoint-prefix="/dnd/dmOverview/<%= campaign._id %>/characters/"
            data-enemy-endpoint-prefix="/dnd/dmOverview/<%= campaign._id %>/session/<%= selectedSession ? selectedSession._id : "" %>/enemies/"
            aria-hidden="true"
        >

            <form
                class="hpAdjustmentDialog"
                aria-labelledby="hpAdjustmentTitle"
            >

                <div
                    class="hp-modal"
                    role="dialog"
                    aria-modal="true"
                    aria-labelledby="hpAdjustmentTitle"
                >

                    <div class="hp-modal__frame">

                        <header class="hp-modal__header">

                            <div class="hp-modal__heading">
                                <span class="hp-modal__heart" aria-hidden="true">♥</span>
                                <h2 id="hpAdjustmentTitle">Hit Points</h2>
                            </div>

                            <button
                                class="hp-modal__close"
                                type="button"
                                aria-label="Close"
                                data-hp-close
                            >×</button>

                        </header>

                        <section
                            class="hp-panel hp-panel--current"
                            aria-label="Current hit points"
                        >

                            <div class="hp-current">

                                <span class="hp-eyebrow">CURRENT HP</span>

                                <div class="hp-current__value">
                                    <strong class="hp-modal__current-value">—</strong>
                                    <span>/</span>
                                    <span class="hp-modal__maximum-value">—</span>
                                </div>

                            </div>

                            <div
                                class="hp-bar"
                                role="progressbar"
                                aria-label="Hit points"
                                aria-valuemin="0"
                            >
                                <div
                                    class="hp-bar__fill"
                                    style="width: 0%"
                                ></div>
                            </div>

                            <div class="hp-actions">

                                <label class="hp-number">

                                    <span class="hp-sr-only">Amount</span>

                                    <input
                                        id="hpAdjustmentAmount"
                                        name="amount"
                                        type="number"
                                        min="1"
                                        step="1"
                                        required
                                    >

                                </label>

                                <button
                                    class="hp-button hp-button--heal"
                                    type="submit"
                                    name="action"
                                    value="heal"
                                >
                                    <span aria-hidden="true">＋</span>
                                    Heal
                                </button>

                                <button
                                    class="hp-button hp-button--damage"
                                    type="submit"
                                    name="action"
                                    value="damage"
                                >
                                    <span aria-hidden="true">−</span>
                                    Damage
                                </button>

                            </div>

                        </section>

                        <section
                            class="hp-panel hp-panel--death"
                            aria-labelledby="death-title"
                            hidden
                        >

                            <h3 class="hp-section-title" id="death-title">
                                <span aria-hidden="true">☠</span>
                                Death Saving Throws
                            </h3>

                            <div class="hp-save-row">

                                <span class="hp-save-label">Failures</span>

                                <div
                                    class="hp-save-icons"
                                    aria-label="0 of 3 failures"
                                >
                                    <span class="hp-skull is-inactive" aria-hidden="true">☠</span>
                                    <span class="hp-skull is-inactive" aria-hidden="true">☠</span>
                                    <span class="hp-skull is-inactive" aria-hidden="true">☠</span>
                                </div>

                            </div>

                            <div class="hp-save-row hp-save-row--success">

                                <span class="hp-save-label">Successes</span>

                                <div
                                    class="hp-save-icons"
                                    aria-label="0 of 3 successes"
                                >
                                    <span class="hp-success is-inactive" aria-hidden="true">✦</span>
                                    <span class="hp-success is-inactive" aria-hidden="true">✦</span>
                                    <span class="hp-success is-inactive" aria-hidden="true">✦</span>
                                </div>

                            </div>

                            <button
                                class="hp-button hp-button--roll"
                                type="button"
                            >
                                <span aria-hidden="true">✥</span>
                                Roll Saving Throws
                            </button>

                        </section>

                        <section
                            class="hp-panel hp-panel--settings"
                            aria-label="HP settings"
                        >

                            <label class="hp-field">

                                <span class="hp-field__icon" aria-hidden="true">♥</span>
                                <span class="hp-field__label">Max HP</span>

                                <input
                                    class="hp-modal__maximum-setting"
                                    type="number"
                                    min="1"
                                    readonly
                                >

                            </label>

                            <label class="hp-field">

                                <span class="hp-field__icon" aria-hidden="true">♥</span>
                                <span class="hp-field__label">Current HP</span>

                                <input
                                    class="hp-modal__current-setting"
                                    type="number"
                                    min="0"
                                    readonly
                                >

                            </label>

                            <label class="hp-field">

                                <span class="hp-field__icon" aria-hidden="true">✥</span>
                                <span class="hp-field__label">Modifier</span>

                                <input
                                    type="number"
                                    value="0"
                                    readonly
                                >

                            </label>

                            <label class="hp-overwrite">

                                <span class="hp-overwrite__check">
                                    <input type="checkbox" disabled>
                                    <span>Overwrite</span>
                                </span>

                                <span class="hp-overwrite__description">
                                    Replace current HP with the value above.
                                </span>

                            </label>

                        </section>

                    </div>

                </div>

            </form>

        </div>
        <!-- END HP ADJUSTMENT MODAL -->

    <% } %>

    <!-- Font Awesome -->
<link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
>

<!-- Bootstrap JavaScript -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>



<script src="/js/dnd/DM/dmOverview/dm_overview.js"></script>
<script src="/js/dnd/DM/dmOverview/map.js"></script>
</body>
</html>