                </div>
                <div class="time-div">
                  <input type="time" id="selectedTime" name="selectedTime" required>
                </div>
              </div>
            </div>

  
            <!-- who's games are proposed?  -->
            <!-- search bar start -->
            <!-- <div class="search-bar">
              <div class="whosGames-title-div">
                <h5 class="whosGames-title-title">Who's games will be played?</h5>
              </div> -->
              <!-- dropdown start  -->
              <!-- <div id="expend-who" class="dropdown-who">
                <div id="drop-text" class="dropdown-text">
                  <span id="span">Everything</span>
                  <i id="icon" class="fa-solid fa-chevron-down"></i>
