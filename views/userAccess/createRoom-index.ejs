          </div>
          
          <button type="submit" name = "submit_createRoom" value="Submit" class="submitButton" onclick="submitSelectedBoardgames()" >Create the invite</button>
          <div class="replaceSubmit"><p>Enjoy! ^_^</p></div>
        </form>
      </section>

    </div>

    <div class="switch">
      <p class="aboutBg">Select up to 3 games you wish to play </p>
      <p class="aboutDetails">Select with who, when, and where to meet </p>
    </div>
  </div>
</div>




  <div id="loadingPopup" class="loading-popup">
    <div id="countdown" class="countdown"></div>
  </div>

  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon " 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading activeBar" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
