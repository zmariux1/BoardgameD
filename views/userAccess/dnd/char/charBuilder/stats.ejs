<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Alege-ți Clasa</title>
    
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/root.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/comunBuilder.css">

    <link rel="stylesheet" href="/css/dnd/char/builder/class_selection.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/stats.css">
    
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/asideBar.css">
    <link rel="stylesheet" href="/css/dnd/char/builder/piese/header.css">

</head>

<body>

<div class="character-page">

    <!-- =========================================================
            TOP BAR
    ========================================================== -->
    <%- include('piese/header') %>


    <!-- =========================================================
            MAIN LAYOUT
    ========================================================== -->
    <div class="character-layout">


        <!-- =====================================================
                LEFT SIDEBAR
        ====================================================== -->
        <%- include('piese/asideBar') %>



        <!-- =====================================================
                MAIN CONTENT
        ====================================================== -->

        <main class="character-content stats-editor" id="statsEditor">

            <div class="pozitionare_content">

                <!-- =========================================================
                    1. ABILITY SUMMARY
                ========================================================== -->
    
                <header class="stats-editor__header">
                    <h1 class="stats-editor__title">STATS &amp; ABILITY SCORES</h1>
    
                    <p class="stats-editor__subtitle">
                        Allocate your ability scores. These values determine your character's core attributes.
                    </p>
                </header>
    
    
                <%
                    const abilitySummaryDefinitions = [
                        { key: 'STR', label: 'STRENGTH', value: baseAbilityScore && baseAbilityScore.str !== undefined ? baseAbilityScore.str : '0' },
                        { key: 'DEX', label: 'DEXTERITY', value: baseAbilityScore && baseAbilityScore.dex !== undefined ? baseAbilityScore.dex : '0' },
                        { key: 'CON', label: 'CONSTITUTION', value: baseAbilityScore && baseAbilityScore.con !== undefined ? baseAbilityScore.con : '0' },
                        { key: 'INT', label: 'INTELLIGENCE', value: baseAbilityScore && baseAbilityScore.int !== undefined ? baseAbilityScore.int : '0' },
                        { key: 'WIS', label: 'WISDOM', value: baseAbilityScore && baseAbilityScore.wis !== undefined ? baseAbilityScore.wis : '0' },
                        { key: 'CHA', label: 'CHARISMA', value: baseAbilityScore && baseAbilityScore.cha !== undefined ? baseAbilityScore.cha : '0' }
                    ];
                %>

                <section class="ability-summary" aria-label="Ability Score Summary">
                    <% abilitySummaryDefinitions.forEach((ability) => { %>
                        <form
                            class="ability-summary__item"
                            data-ability-key="<%= ability.key.toLowerCase() %>"
                            data-form-kind="stats-individual"
                            action="/<%= userId %>/dnd/builder/<%= characterId %>/stats_individual"
                            method="POST"
                        >
                            <div class="ability-summary__label">
                                <span class="ability-summary__ornament"></span>
                                <span class="ability-summary__text"><%= ability.label %></span>
                                <span class="ability-summary__ornament"></span>
                            </div>

                            <div class="ability-summary__value">
                                <input
                                    type="number"
                                    class="ability-summary__input"
                                    name="<%= ability.key %>-value"
                                    value="<%= ability.value %>"
                                    aria-label="<%= ability.label %> score"
                                >
                            </div>

                            <!-- <div class="ability-summary__total">
                                TOTAL: <span><%= ability.value %></span>
                            </div> -->
                        </form>
                    <% }); %>
                </section>
    
    
                <!-- =========================================================
                    2. DICE ROLL GROUPS
                ========================================================== -->
    
                <section class="editor-panel dice-groups" id="diceRollGroups">
    
                    <button
                        type="button"
                        class="editor-panel__header"
                        aria-expanded="true"
                    >
                        <span class="editor-panel__title">Dice Roll Groups</span>
    
                        <span class="editor-panel__toggle" aria-hidden="true">
                            ⌃
                        </span>
                    </button>
    
    
                    <div class="editor-panel__body">
                        <%
                            const fallbackDiceRollGroups = [
                                {
                                    id: 'group-1',
                                    slots: [
                                        { index: 1, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 2, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 3, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 4, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 5, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 6, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' }
                                    ]
                                },
                                {
                                    id: 'group-2',
                                    slots: [
                                        { index: 1, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 2, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 3, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 4, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 5, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
                                        { index: 6, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' }
                                    ]
                                }
                            ];
                        %>
    
                        <div class="dice-groups__toolbar">
    
                            <button
                                type="button"
                                id="dice-group-1"
                                class="dice-groups__count"
                                data-group-index="1"
                                aria-pressed="true"
                            >
                                Groups: <strong>1</strong>
                            </button>

                            <button
                                type="button"
                                id="dice-group-2"
                                class="dice-groups__count"
                                data-group-index="2"
                                aria-pressed="false"
                            >
                                Groups: <strong>2</strong>
                            </button>
                        </div>
    
    
                        <div class="dice-group">
    
                            <button
                                type="button"
                                class="dice-group__nav dice-group__nav--prev"
                                aria-label="Previous roll set"
                            >
                                ‹
                            </button>
    
    
                            <form class="dice-group__columns" id="diceGroupColumns" aria-label="Dice group values"></form>
    
    
                            <button
                                type="button"
                                class="dice-group__nav dice-group__nav--next"
                                aria-label="Next roll set"
                            >
                                ›
                            </button>
    
                        </div>
    
    
                        <div class="dice-group__actions">
    
                            <button
                                type="button"
                                class="btn btn--danger"
                            >
                                RESET GROUP
                            </button>
    
                            <button
                                type="button"
                                class="btn btn--success"
                            >
                                APPLY ABILITY SCORES from this group
                            </button>
    
                        </div>
    
                    </div>
    
                </section>
    
    
                <!-- =========================================================
                    3. ABILITY SCORE INCREASES
                ========================================================== -->
    
                <!-- <section class="editor-panel asi-panel" id="abilityScoreIncreases">
    
                    <button
                        type="button"
                        class="editor-panel__header"
                        aria-expanded="false"
                    >
    
                        <div>
                            <span class="editor-panel__title">
                                Ability Score Increases
                            </span>
    
                            <span class="editor-panel__meta">
                                3 Choices&nbsp; • &nbsp;Origin
                            </span>
                        </div>
    
                        <span class="editor-panel__toggle" aria-hidden="true">
                        ⌄
                        </span>
    
                    </button>
    
                    <div class="editor-panel__body editor-panel__body--collapsed">
                    </div>
    
                </section> -->
    
    
                <!-- =========================================================
                    4. SCORE CALCULATIONS
                ========================================================== -->
    
                <section class="score-calculations">
    
                    <header class="score-calculations__header">
    
                        <h2 class="score-calculations__title">
                            Score Calculations
                        </h2>
    
                        <p class="score-calculations__description">
                            Calculations, including the base scores you set above and any modifiers,
                            are found below. You can also override any automatic calculations or
                            modify them under each ability summary.
                        </p>
    
                    </header>
    
    
                    <%
                        const abilityStatDefinitions = [
                            { key: 'str', label: 'STRENGTH', cardClass: 'strength_listing', total: 14, modifier: '+2' },
                            { key: 'dex', label: 'DEXTERITY', cardClass: 'dexterity_listing', total: 16, modifier: '+3' },
                            { key: 'con', label: 'CONSTITUTION', cardClass: 'constitution_listing', total: 16, modifier: '+3' },
                            { key: 'int', label: 'INTELLIGENCE', cardClass: 'intelligence_listing', total: 14, modifier: '+2' },
                            { key: 'wis', label: 'WISDOM', cardClass: 'wisdom_listing', total: 18, modifier: '+4' },
                            { key: 'cha', label: 'CHARISMA', cardClass: 'charisma_listing', total: 12, modifier: '+1' }
                        ];
                    %>

                    <div class="score-grid">
                        <% abilityStatDefinitions.forEach((stat) => { %>
                            <% const baseValue = baseAbilityScore && baseAbilityScore[stat.key] !== undefined ? baseAbilityScore[stat.key] : '0'; %>
                            <% const bonusValue = abilityScoreBonuses && abilityScoreBonuses[stat.key] !== undefined ? abilityScoreBonuses[stat.key] : '0'; %>
                            <% const modifierValue = abilityScoreModifiers && abilityScoreModifiers[stat.key] !== undefined ? abilityScoreModifiers[stat.key] : '0'; %>
                            <% const overwriteValue = abilityScoreOverwrite && abilityScoreOverwrite[stat.key] !== undefined ? abilityScoreOverwrite[stat.key] : '0'; %>
                            <% const displayedTotalScore = AllStats && AllStats[stat.key.toUpperCase()] !== undefined
                              ? AllStats[stat.key.toUpperCase()]
                              : Number(baseValue) + Number(bonusValue) + Number(modifierValue); %>
                            <% const displayedModifier = calculatedModifiers && calculatedModifiers[stat.key.toUpperCase()] !== undefined
                              ? calculatedModifiers[stat.key.toUpperCase()]
                              : 0; %>
                            <% const newTotalScore = NEW_AllStats && NEW_AllStats[stat.key.toUpperCase()] !== undefined
                              ? NEW_AllStats[stat.key.toUpperCase()]
                              : displayedTotalScore; %>
                            <% const newModifierScore = NEW_calculatedModifiers && NEW_calculatedModifiers[stat.key.toUpperCase()] !== undefined
                              ? NEW_calculatedModifiers[stat.key.toUpperCase()]
                              : 0; %>
                            <% const newBaseScore = NEW_base && NEW_base[stat.key.toUpperCase()] !== undefined
                              ? NEW_base[stat.key.toUpperCase()]
                              : baseValue; %>
                            <% const newBonusScore = NEW_bonuses && NEW_bonuses[stat.key.toUpperCase()] !== undefined
                              ? NEW_bonuses[stat.key.toUpperCase()]
                              : bonusValue; %>

                            <article class="score-card <%= stat.cardClass %>" data-ability-key="<%= stat.key %>">
                                <header class="score-card__header">
                                    <span class="score-card__icon">✦</span>
                                    <span class="score-card__title"><%= stat.label %></span>
                                </header>

                                <div class="score-card__rows">
                                    <div class="score-row listing_total_score score-row--highlight">
                                        <span>Total Score</span>
                                      <strong><%= newTotalScore %></strong>
                                    </div>

                                    <div class="score-row listing_modifier_score score-row--highlight">
                                        <span>Modifier</span>
                                      <strong><%= newModifierScore %></strong>
                                    </div>

                                    <div class="score-row listing_base_score">
                                        <span>Base Score</span>
                                        <strong><%= newBaseScore %></strong>
                                    </div>

                                    <div class="score-row listing_bonus_score">
                                        <span>Bonus</span>
                                        <strong><%= newBonusScore %></strong>
                                    </div>

                                    <div class="score-row listing_modified_score">
                                        <span>Set Score</span>
                                        <strong>0</strong>
                                    </div>

                                    <div class="score-row">
                                        <span>Stacking Bonus</span>
                                        <strong>+0</strong>
                                    </div>

                                    <form
                                        class="score-row score-row--input form_modifying_score"
                                        data-form-kind="stats-individual"
                                        action="/<%= userId %>/dnd/builder/<%= characterId %>/stats_individual"
                                        method="POST"
                                    >
                                        <label for="<%= stat.key %>-other-modifier">
                                            Other Modifier
                                        </label>

                                        <input
                                            id="<%= stat.key %>-other-modifier"
                                            name="<%= stat.key %>-modifier"
                                            type="text"
                                            value="<%= modifierValue %>"
                                            class="listing_modifying_score"
                                            placeholder="--"
                                        >
                                    </form>

                                    <form
                                        class="score-row score-row--input form_overwrite_score"
                                        data-form-kind="stats-individual"
                                        action="/<%= userId %>/dnd/builder/<%= characterId %>/stats_individual"
                                        method="POST"
                                    >
                                        <label for="<%= stat.key %>-overwrite">
                                            Overwrite Score
                                        </label>

                                        <input
                                            id="<%= stat.key %>-overwrite"
                                            name="<%= stat.key %>-overwrite"
                                            type="text"
                                            value="<%= overwriteValue %>"
                                            class="listing_override_score"
                                            placeholder="--"
                                        >
                                    </form>
                                </div>
                            </article>
                        <% }); %>
                    </div>
    
                </section>


                    
            </div>
        </main>












        

    </div>

</div>












  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script>
    const pageContext = {
      userId: '<%= userId %>',
      characterId: '<%= characterId %>'
    };

    const abilityOptions = ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'];
    const abilityLabelMap = {
      STR: 'STRENGTH',
      DEX: 'DEXTERITY',
      CON: 'CONSTITUTION',
      INT: 'INTELLIGENCE',
      WIS: 'WISDOM',
      CHA: 'CHARISMA'
    };

    let pendingIndividualSaves = Promise.resolve();

    function getAbilityKeyFromInput(inputElement) {
      const inputName = String(inputElement && inputElement.name ? inputElement.name : '').toUpperCase();
      const match = inputName.match(/^(STR|DEX|CON|INT|WIS|CHA)-/);
      return match ? match[1] : '';
    }

    function syncAbilitySummaryLabel(inputElement) {
      if (!inputElement || !inputElement.name) {
        return;
      }

      const abilityKey = getAbilityKeyFromInput(inputElement);
      const form = inputElement.closest('.ability-summary__item');
      const label = form ? form.querySelector('.ability-summary__text') : null;

      if (!label) {
        return;
      }

      label.textContent = abilityLabelMap[abilityKey] || abilityKey;
    }

    function syncSummaryInputToListingBaseScore(inputElement) {
      if (!inputElement || !inputElement.name) {
        return;
      }

      const abilityKey = getAbilityKeyFromInput(inputElement).toLowerCase();
      const listingCard = document.querySelector(`.score-card[data-ability-key="${abilityKey}"]`);
      const baseScoreElement = listingCard ? listingCard.querySelector('.listing_base_score strong') : null;

      if (!baseScoreElement) {
        return;
      }

      const numericValue = Number(inputElement.value);
      baseScoreElement.textContent = Number.isFinite(numericValue) ? String(numericValue) : inputElement.value;
    }

    function syncSummaryTotalsFromListing() {
      document.querySelectorAll('.ability-summary__item').forEach((form) => {
        const input = form.querySelector('.ability-summary__input');
        if (!input || !input.name) {
          return;
        }

        const abilityKey = getAbilityKeyFromInput(input).toLowerCase();
        const listingCard = document.querySelector(`.score-card[data-ability-key="${abilityKey}"]`);
        const listingTotal = listingCard ? listingCard.querySelector('.listing_total_score strong') : null;
        const totalValue = listingTotal ? listingTotal.textContent.trim() : (input.value || '0');
        const totalElement = form.querySelector('.ability-summary__total span');

        if (totalElement) {
          totalElement.textContent = totalValue || '0';
        }
      });
    }

    function bindSummaryInputSync() {
      document.querySelectorAll('.ability-summary__input').forEach((input) => {
        syncAbilitySummaryLabel(input);

        input.addEventListener('input', (event) => {
          const currentInput = event.currentTarget;
          syncSummaryInputToListingBaseScore(currentInput);
          syncSummaryTotalsFromListing();
        });

        syncSummaryInputToListingBaseScore(input);
      });

      syncSummaryTotalsFromListing();
    }

    async function submitIndividualForm(formElement) {
      if (!formElement) {
        return;
      }

      const formData = new FormData(formElement);
      const payload = Object.fromEntries(formData.entries());

      if (!Object.keys(payload).length) {
        return;
      }

      const response = await fetch(formElement.action, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        credentials: 'same-origin',
        body: JSON.stringify(payload)
      });

      const result = await response.json().catch(() => ({}));

      if (!response.ok) {
        throw new Error(result && result.message ? result.message : 'Unable to save the ability update.');
      }

      return result;
    }

    function bindIndividualStatForms() {
      document.querySelectorAll('form[data-form-kind="stats-individual"]').forEach((form) => {
        if (form.dataset.bound === 'true') {
          return;
        }

        form.dataset.bound = 'true';

        const input = form.querySelector('input');
        if (!input) {
          return;
        }

        input.addEventListener('change', async (event) => {
          const currentInput = event.currentTarget;
          const currentForm = currentInput.closest('form');

          if (!currentForm) {
            return;
          }

          currentForm.dataset.isSubmitting = 'true';
          const savePromise = pendingIndividualSaves.then(() => submitIndividualForm(currentForm));
          pendingIndividualSaves = savePromise.catch(() => {});

          try {
            await savePromise;
            currentInput.dataset.lastSavedValue = currentInput.value;
          } catch (error) {
            console.error('Individual stats save error:', error);
            alert(error.message || 'Unable to save this field.');
          } finally {
            currentForm.dataset.isSubmitting = 'false';
          }
        });
      });
    }

    const defaultDiceRollGroups = [
      {
        id: 'group-1',
        slots: [
          { index: 1, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 2, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 3, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 4, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 5, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 6, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' }
        ]
      },
      {
        id: 'group-2',
        slots: [
          { index: 1, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 2, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 3, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 4, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 5, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' },
          { index: 6, mainScore: 1, dice: [1, 1, 1, 1], selectedAbility: '' }
        ]
      }
    ];

    const serverDiceRollGroups = <%- JSON.stringify((locals && locals.diceRollGroups) || fallbackDiceRollGroups) %>;
    const diceRollGroups = (serverDiceRollGroups && serverDiceRollGroups.length ? serverDiceRollGroups : defaultDiceRollGroups).map((group, groupIndex) => ({
      ...group,
      id: group.id || `group-${groupIndex + 1}`,
      slots: (group.slots || []).map((slot, slotIndex) => {
        const computedMainScore = slot.mainScore ?? getPrimaryScore(slot.dice || [1, 1, 1, 1]);
        return {
          ...slot,
          index: slot.index ?? slotIndex + 1,
          mainScore: computedMainScore,
          dice: slot.dice ?? [1, 1, 1, 1],
          selectedAbility: slot.selectedAbility || ''
        };
      })
    }));

    let activeGroupIndex = 1;

    function getPrimaryScore(diceValues) {
      const sortedDice = [...diceValues].sort((a, b) => b - a);
      return sortedDice.slice(0, 3).reduce((sum, value) => sum + value, 0);
    }

    function syncAbilityAvailability() {
      const allSelects = document.querySelectorAll('.roll-slot__select');

      allSelects.forEach((select) => {
        const currentValue = select.value;

        Array.from(select.options).forEach((option) => {
          if (!option.value) {
            option.hidden = false;
            option.disabled = false;
            return;
          }

          const isUsedInAnotherSelect = Array.from(allSelects).some((otherSelect) => {
            return otherSelect !== select && otherSelect.value === option.value;
          });

          option.hidden = isUsedInAnotherSelect && option.value !== currentValue;
          option.disabled = isUsedInAnotherSelect && option.value !== currentValue;
        });
      });
    }

    function renderDiceGroup(groupIndex) {
      const targetGroup = diceRollGroups[groupIndex - 1];
      const container = document.getElementById('diceGroupColumns');

      if (!targetGroup || !container) {
        return;
      }

      container.innerHTML = targetGroup.slots.map((slot) => {
        const diceMarkup = slot.dice
          .map((value, diceIndex) => {
            const dieClass = diceIndex < 3 ? 'die die--blue' : 'die die--gray';
            return `<span class="${dieClass}">${value}</span>`;
          })
          .join('');

        const selectOptions = ['<option value="">Select</option>']
          .concat(abilityOptions.map((option) => {
            const selected = slot.selectedAbility === option ? 'selected' : '';
            return `<option value="${option}" ${selected}>${option}</option>`;
          }))
          .join('');

        return `
          <article class="roll-slot" data-slot-index="${slot.index}" data-group-index="${groupIndex}">
            <input
              class="roll-slot__score"
              type="number"
              min="1"
              max="30"
              value="${slot.mainScore}"
              data-group-index="${groupIndex}"
              data-slot-index="${slot.index}"
              aria-label="Main score ${slot.index}"
            >

            <div class="roll-slot__dice">
              ${diceMarkup}
            </div>

            <label class="roll-slot__select-wrapper">
              <span class="sr-only">Ability</span>
              <select class="roll-slot__select" data-group-index="${groupIndex}" data-slot-index="${slot.index}" name="group_${groupIndex}_roll_${slot.index}_ability">
                ${selectOptions}
              </select>
            </label>
          </article>
        `;
      }).join('');

      document.querySelectorAll('.roll-slot__select').forEach((select) => {
        select.addEventListener('change', (event) => {
          const currentSelect = event.currentTarget;
          const chosenValue = currentSelect.value;
          const groupIndexValue = Number(currentSelect.dataset.groupIndex);
          const slotIndexValue = Number(currentSelect.dataset.slotIndex);

          const group = diceRollGroups[groupIndexValue - 1];
          const slot = group && group.slots.find((item) => item.index === slotIndexValue);

          if (slot) {
            slot.selectedAbility = chosenValue || '';
          }

          syncAbilityAvailability();
        });
      });

      document.querySelectorAll('.roll-slot__score').forEach((input) => {
        input.addEventListener('input', (event) => {
          const target = event.currentTarget;
          const groupIndexValue = Number(target.dataset.groupIndex);
          const slotIndexValue = Number(target.dataset.slotIndex);
          const group = diceRollGroups[groupIndexValue - 1];
          const slot = group && group.slots.find((item) => item.index === slotIndexValue);

          if (slot) {
            slot.mainScore = Number(target.value || 0);
          }
        });
      });

      document.querySelectorAll('.dice-groups__count').forEach((button) => {
        const isActive = Number(button.dataset.groupIndex) === groupIndex;
        button.setAttribute('aria-pressed', String(isActive));
      });

      syncAbilityAvailability();
    }

    function setActiveGroup(nextGroupIndex) {
      activeGroupIndex = nextGroupIndex;
      renderDiceGroup(nextGroupIndex);
    }

    function randomizeActiveGroupValues() {
      diceRollGroups.forEach((group) => {
        group.slots.forEach((slot) => {
          const randomDice = Array.from({ length: 4 }, () => Math.floor(Math.random() * 6) + 1);
          slot.dice = randomDice;
          slot.mainScore = getPrimaryScore(randomDice);
          slot.selectedAbility = '';
        });
      });

      renderDiceGroup(activeGroupIndex);
    }

    document.getElementById('dice-group-1')?.addEventListener('click', () => setActiveGroup(1));
    document.getElementById('dice-group-2')?.addEventListener('click', () => setActiveGroup(2));

    document.querySelector('.dice-group__nav--prev')?.addEventListener('click', () => {
      const previousIndex = activeGroupIndex === 1 ? 2 : 1;
      setActiveGroup(previousIndex);
    });

    document.querySelector('.dice-group__nav--next')?.addEventListener('click', () => {
      const nextIndex = activeGroupIndex === 1 ? 2 : 1;
      setActiveGroup(nextIndex);
    });

    document.querySelector('.btn--danger')?.addEventListener('click', randomizeActiveGroupValues);

    document.querySelector('.btn--success')?.addEventListener('click', async () => {
      const activeGroup = diceRollGroups[activeGroupIndex - 1];
      const selectedValues = activeGroup ? activeGroup.slots.map((slot) => ({
        index: slot.index,
        mainScore: slot.mainScore,
        selectedAbility: slot.selectedAbility,
        dice: slot.dice
      })) : [];

      const blanks = selectedValues.filter((slot) => !slot.selectedAbility);
      if (blanks.length) {
        alert('Please assign every roll to a unique ability before applying the group.');
        return;
      }

      const seen = new Set();
      const duplicate = selectedValues.some((slot) => {
        if (seen.has(slot.selectedAbility)) {
          return true;
        }

        seen.add(slot.selectedAbility);
        return false;
      });

      if (duplicate) {
        alert('Each ability can be assigned only once within the selected group.');
        return;
      }

      const abilityPayload = selectedValues
        .filter((slot) => slot.selectedAbility)
        .map((slot) => ({
          type: slot.selectedAbility,
          value: Number(slot.mainScore)
        }));

      abilityPayload.forEach((score) => {
        const summaryInput = document.querySelector(
          `.ability-summary__item[data-ability-key="${score.type.toLowerCase()}"] .ability-summary__input`
        );

        if (summaryInput) {
          summaryInput.value = score.value;
          syncAbilitySummaryLabel(summaryInput);
          syncSummaryInputToListingBaseScore(summaryInput);
          syncSummaryTotalsFromListing();
        }
      });

      window.selectedDiceGroup = {
        groupIndex: activeGroupIndex,
        values: selectedValues,
        abilityScores: abilityPayload
      };

      try {
        await pendingIndividualSaves;

        const response = await fetch(`/${pageContext.userId}/dnd/builder/${pageContext.characterId}/stats`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          credentials: 'same-origin',
          body: JSON.stringify({
            abilityScores: abilityPayload
          })
        });

        const result = await response.json().catch(() => ({}));

        if (!response.ok) {
          throw new Error(result && result.message ? result.message : 'Unable to save ability scores.');
        }

        console.log('Selected dice group payload:', window.selectedDiceGroup);
        console.log('Saved ability scores:', result);
        window.location.reload();
      } catch (error) {
        console.error('Save ability scores error:', error);
        alert(error.message || 'Unable to save ability scores.');
      }
    });

    bindSummaryInputSync();
    bindIndividualStatForms();
    setActiveGroup(activeGroupIndex);
  </script>

</body>
</html>