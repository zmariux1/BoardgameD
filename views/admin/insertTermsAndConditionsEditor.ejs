<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
  <link rel="stylesheet" href="/css/insertTermsAndConditionsEditor.css">
</head>
<body>
  <div class="container">
    <div class="mainTitle_agreements_Submit">
      <title>"Important: Please Read and Agree to Terms & Conditions to Complete Your Account Registration"</title>
      <div class="allTheRules">
        <!-- generator - for each   -->
        <!-- template with title and content  -->


        <div class="category">
          <% if (termsAndConditions && termsAndConditions.length > 0) { %>
            <% termsAndConditions.forEach(termsAndConditions => { %>
              <div class="stretch_title">
                <form action="/admin/zmr/termsAndConditions_remove" method="POST">
                  <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                  <button type="submit" name="remove_category" value="remove_category"><i class="fa-regular fa-trash-can"></i></button>
                </form>
                <form action="/admin/zmr/termsAndConditions_edit" method="POST">
                  <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                  <input type="text" name="insert_category" value="<%= termsAndConditions.category %>">
                  <button type="submit" name="update_category" value="update_category"><i class="fa-solid fa-check"></i></button>
                </form>
                <h2>Category: <%= termsAndConditions.category %></h2>
              </div>
              <ul>
                  <% termsAndConditions.items.forEach(item => { %>
                    <li class="anItem">
                      <div class="condition_title">
                        <form action="/admin/zmr/termsAndConditions_remove" method="POST">
                          <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                          <input type="hidden" name="item_id" value="<%= item._id %>">
                          <button type="submit" name="remove_title" value="update_title"><i class="fa-regular fa-trash-can"></i></button>
                        </form>
                        <form action="/admin/zmr/termsAndConditions_edit" method="POST">
                          <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                          <input type="hidden" name="item_id" value="<%= item._id %>">
                          <input type="text" name="insert_title" value="<%= item.condition_title %>">
                          <button type="submit" name="update_title" value="update_title"><i class="fa-solid fa-check"></i></button>
                        </form>
                        <h3>Title: <%= item.condition_title %></h3>
                      </div>
                      <ul class="condition_content">
                        <% item.condition_content.forEach(content => { %>
                          <form action="/admin/zmr/termsAndConditions_remove" method="POST">
                            <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                            <input type="hidden" name="item_id" value="<%= item._id %>">
                            <input type="hidden" name="original_content" value="<%= content %>">
                            <button type="submit" name="remove_content" value="remove_content"><i class="fa-regular fa-trash-can"></i></button>
                          </form>
                          <form action="/admin/zmr/termsAndConditions_edit" method="POST">
                            <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                            <input type="hidden" name="item_id" value="<%= item._id %>">
                            <input type="hidden" name="original_content" value="<%= content %>">
                            <input type="text" name="insert_content" value="<%= content %>">
                            <button type="submit" name="update_content" value="update_content"><i class="fa-solid fa-check"></i></button>
                          </form>
                          <li ><%= content %></li>
                        <% }); %>
                      </ul>
                      <div class="insertAnotherContent">
                        <form action="/admin/zmr/termsAndConditions_generator" method="POST" class="newContent_form">
                          <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                          <input type="hidden" name="item_id" value="<%= item._id %>">
                          <button type="submit" name="newContent" value="newContent" class="stretchButton">Add a new description</button>
                        </form>
                      </div>
                      
                    </li>
                  <% }); %>
                  <div class="insertAnotherTitle">
                    <form action="/admin/zmr/termsAndConditions_generator" method="POST" class="newTitle_form">
                      <input type="hidden" name="category_id" value="<%= termsAndConditions._id %>">
                      <button type="submit" name="newTitle" value="newTitle">Generate an entire new Title</button>
                    </form>
                  </div>
              </ul>
            <% }); %>
          <% } else { %>
            <p>No room data found</p>
          <% } %>


        </div>
        <div class="insertAnotherCategory stretch_title">
          <form action="/admin/zmr/termsAndConditions_generator" method="POST" class="newCategory_form">
            <button type="submit" name="newCategory" value="newCategory">Generate an entire new Category</button>
          </form>
        </div>
      </div>
      <div class="alltheChecks">
        <label for="something">
          <input type="checkbox" id="something"> Something
        </label>
        <label for="checkbox1">
          <input type="checkbox" id="checkbox1"> I have read and agree to the Terms & Conditions
        </label>

      </div>
      
    </div>

    <form action="">
      <button type="submit" class="last_agreement">Push the final version</button>
    </form>
    
  </div>






  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>

</body>
</html>