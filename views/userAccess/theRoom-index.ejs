<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Document</title>
    

  <link rel="icon" href="img/title/">


  <link rel="stylesheet" href="/css/theRoom-style2.css">
  <link rel="stylesheet" href="/css/elements/header.css">
  <link rel="stylesheet" href="/css/elements/botNavBar.css">
  <link rel="stylesheet" href="/css/elements/standardAll.css">
  <script
    type="module"
    src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
  ></script>
  <!-- Include jQuery library -->
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
</head>
<body>
  <%- include('../layouts/header') %>



  

  <% if (userRooms && userRooms.length > 0) { %>
    <% userRooms.forEach(room => { %>

      <% let isIdentical = false; %>
      <% if (joinedGuestUsers && joinedGuestUsers.length > 0) { %>
        <% joinedGuestUsers.forEach(guestUser => { %>
          <%if (guestUser._id.toString() === user._id.toString()) {%>
            <%isIdentical = true;%>
          <%}%>
        <% }); %>
      <% } else { %>
      <% } %>




      <% if (isIdentical ) { %>
        <div class="container">
          <section class="center_perception">
            <!-- lista cu detalii  -->
            <div class="detailsTopField_div">
              <div class="userIDOwner">
                <div class="avatarImgOwner">
                  <img class="profileGuest" src="/userImages/<%= room.user.images %>">
                </div>

                <div name="dosarRep">
                  <% let groupedData_honer = []; %>
                  <% let groupedData_stain = []; %>
                
                  <% if (userPlus && userPlus.length > 0) { %>
                    <% userPlus.forEach(data => { %>
                      <% if (data.userLink.toString() == room.user._id.toString()) { %>
                        
                        <% data.allReputation.forEach(reputation => { %>
                
                          <!-- match with honor  -->
                          <% if (importHonorDetail && importHonorDetail.length > 0) { %>
                            <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
                
                              <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                  <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                    <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                      <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                        <% groupedData_honer.push(subCategory); %>
                                      <% }; %>
                                    <% }); %>
                                  <% } %>
                                <% }); %>
                              <% }); %>
                
                            <% }); %>
                          <% } %>
                
                          <!-- match with stain  -->
                          <% if (importStainDetail && importStainDetail.length > 0) { %>
                            <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
                
                              <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                  <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                    <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                      <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                        <% groupedData_stain.push(subCategory); %>
                                      <% }; %>
                                    <% }); %>
                                  <% } %>
                                <% }); %>
                              <% }); %>
                
                            <% }); %>
                          <% } %>
                
                
                        <% }); %>
                      <% } %>
                    <% }); %>
                    
                  <% } %>
                </div>
                <div class="reputationBoxOnwer">
                  <div class="honorsOwner">
                      <% if (groupedData_honer && groupedData_honer.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_honer = groupedData_honer.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_honer.slice(0, 3).forEach(item => { %>
                          <div class="honorOwner" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>"  class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                  </div>

                  <div class="redFlagsOwner">
                    <% if (groupedData_stain && groupedData_stain.length > 0) { %>
                      <!-- Shuffle the badReputation array -->
                      <% const owner_shuffled_stain = groupedData_stain.sort(() => Math.random() - 0.5); %>
                      <% owner_shuffled_stain.slice(0, 2).forEach(item => { %>
                        <div class="flagOwner" title="<%= item.description %>">
                          <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                        </div>
                      <% }) %>
                    <% } %>
                  </div>

                </div>


              </div>
              <div class="inviteDetails_div">
                <div class="categoryTitles">
                  <h4>Invite details</h4>
                  <i class="customArrow fa-solid fa-arrow-down"></i>
                </div>
                <hr>
                <div class="details_div">
                  <div class="detailsItem_div">
                    <p>Time:</p>
                    <p><%= room.selectedTime %></p>
                  </div>
                  <div class="detailsItem_div">
                    <p>Date:</p>
                    <p><%= room.selectedDate %></p>
                  </div>
                  <div class="detailsItem_div">
                    <p>Location:</p>
                    <p><%= room.location %></p>
                  </div>
                  <div class="detailsItem_div">
                    <p>Players:</p>
                    <p><%= room.joined_guest.length %> / <%= room.numberOfInvites %></p>
                  </div>
                </div>
              </div>
            </div>
            <!-- lista cu jocuri  -->
            <div class="selectedBGList_div">
              <div class="categoryTitles">
                <h4>Board Games</h4>
                <i class="fa-solid fa-arrow-down"></i>
              </div>
              <hr>
              <div class="BGList_div">
                <% room.theBoardgames_name.forEach(boardgame => { %>
                  <a><%= boardgame %></a>
                <% }) %>
              </div>
            </div>

            <div class="participants">
              <div class="categoryTitles">
                <h4>Participants</h4>
                <i class="customArrow fa-solid fa-arrow-down"></i>
              </div>
              <hr>
              <div class="btnList_div">
                <button  class="rep_btn showHonor">Honor</button>
                <button  class="rep_btn showFeedback">Feedback</button>
                <button  class="rep_btn showStain">Report</button>
              </div>
              <div class="participants_container">

                <% if (joinedGuestUsers && joinedGuestUsers.length > 0 && isIdentical) { %>
                    <% joinedGuestUsers.forEach(guestUser => { %>
                      <div class="userPlusRemove">
                        <div class="userID ">
                          <div class="avatarImg">
                            <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                            <button type="submit" class="clean_btn fix_honorBtn open_honer_popup"><i class="custom_icon fa-solid fa-medal " ></i></button>
                            <button type="submit" class="clean_btn fix_feedbackBtn open_feedback_popup"><i class="custom_icon fa-solid fa-heart-pulse " ></i></button>
                            <button type="submit" class="clean_btn fix_stainBtn open_stain_popup"><i class="custom_icon fa-solid fa-disease "></i></button>
                          </div>

                          <div name="dosarRep">
                            <% let groupedData_honer = []; %>
                            <% let groupedData_stain = []; %>
                          
                            <% if (userPlus && userPlus.length > 0) { %>
                              <% userPlus.forEach(data => { %>
                                <% if (data.userLink.toString() == guestUser._id.toString()) { %>
                                  
                                  <% data.allReputation.forEach(reputation => { %>
                          
                                    <!-- match with honor  -->
                                    <% if (importHonorDetail && importHonorDetail.length > 0) { %>
                                      <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
                          
                                        <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                          <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                            <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                              <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                                <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                                  <% groupedData_honer.push(subCategory); %>
                                                <% }; %>
                                              <% }); %>
                                            <% } %>
                                          <% }); %>
                                        <% }); %>
                          
                                      <% }); %>
                                    <% } %>
                          
                                    <!-- match with stain  -->
                                    <% if (importStainDetail && importStainDetail.length > 0) { %>
                                      <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
                          
                                        <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                          <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                            <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                              <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                                <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                                  <% groupedData_stain.push(subCategory); %>
                                                <% }; %>
                                              <% }); %>
                                            <% } %>
                                          <% }); %>
                                        <% }); %>
                          
                                      <% }); %>
                                    <% } %>
                          
                          
                                  <% }); %>
                                <% } %>
                              <% }); %>
                              
                            <% } %>
                          </div>
                          <div class="reputationBox">
                            <div class="honors">
                              <% if (groupedData_honer && groupedData_honer.length > 0) { %>
                                <!-- Shuffle the badReputation array -->
                                <% const owner_shuffled_honer = groupedData_honer.sort(() => Math.random() - 0.5); %>
                                <% owner_shuffled_honer.slice(0, 2).forEach(item => { %>
                                  <div class="honor" title="<%= item.description %>">
                                    <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                                  </div>
                                <% }) %>
                              <% } %>
                            </div>
                            <div class="redFlags">
                              <% if (groupedData_stain && groupedData_stain.length > 0) { %>
                                <!-- Shuffle the badReputation array -->
                                <% const owner_shuffled_stain = groupedData_stain.sort(() => Math.random() - 0.5); %>
                                <% owner_shuffled_stain.slice(0, 1).forEach(item => { %>
                                  <div class="flag" title="<%= item.description %>">
                                    <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                                  </div>
                                <% }) %>
                              <% } %>
                            </div>
                          </div>
                        </div>
                        <div class="removeOrBan">
                          <!-- daca Session User == Owner, grant access to forms -->
                          <% if ( user._id.toString() == room.user._id.toString() && isIdentical) { %>
                            <form action="/removeRoomPlayerUp" method="POST" class="fix_trash">
                              <input type="hidden" name="removePlayer" value="<%= guestUser._id %>" id="">
                              <input type="hidden" name="roomID" value="<%= room._id %>" id="">
                              <button type="submit" class="clean_btn"><i class="center_icon custom_icon_out  fa-solid fa-trash-can fa-xl " style="color: #e7e7e7;"></i></button>
                            </form>
                            <form action="/banRoomPlayerUp" method="POST" class="fix_ban">
                              <input type="hidden" name="banPlayer" value="<%= guestUser._id %>" id="">
                              <input type="hidden" name="roomID" value="<%= room._id %>" id="">
                              <button type="submit" class="clean_btn"><i class="center_icon custom_icon_out fa-solid fa-ban fa-xl " style="color: #e7e7e7;"></i></button>
                            </form>

                            <!-- daca Participant == Current session User, grant access to selfRemove -->
                          <% } else if ( guestUser._id.toString() == user._id.toString() && isIdentical) { %>
                            <form action="/removeRoomPlayerUp" method="POST" class="fix_trash">
                              <input type="hidden" name="removePlayer" value="<%= guestUser._id %>" id="">
                              <input type="hidden" name="roomID" value="<%= room._id %>" id="">
                              <button type="submit" class="clean_btn"><i class="custom_icon_out fa-solid fa-trash-can fa-xl center_icon" style="color: #e7e7e7;"></i></button>
                            </form>
                          <% } else { %>
                          <% } %>
                        </div>
                      </div>







                      <div class="overlaySearch"></div>
                      <div class="popup_honer">
                        <% if ( guestUser._id.toString() !== userSession._id.toString() && isIdentical) { %>
                          <div class="whosThePlayer">
                            <div class="userIDOwner">
                              <div class="avatarImgOwner">
                                <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                              </div>
                              <div class="reputationBox">
                                <div class="honors">
                                  <div class="honor1">
                                    <img>
                                  </div>
                                  <div class="honor2">
                                    <img>
                                  </div>
                                </div>
                                <div class="redFlags">
                                  <div class="flag1">
                                    <img>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <p class="title">How was <br> your interaction <br> with <span><%= guestUser.yourName %></span>?</p>
                          </div>

                          <div>
                            <h3>Select a Honor category:</h3>
                            <!-- Honor  -->
                            <% let avoidDuplicate_honor = true; %>
                            <div class="Verify_if_the_player_is_Honored">
                              <% if (guestUser.honor) { %>
                                <% Object.entries(guestUser.honor).forEach(([category, values]) => { %>
                                  <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                    <!-- ATTENTIE LA FILTRUL PUS, IN CAZ CA SE MODIFICA MODELUL BAZEI DE DATE!!! -->
                                    <% if (['Environment', 'Food & Drinks', 'Gaming Style', 'Personality', 'Good manners'].includes(Categories)) { %>
                                      <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                        <% Object.entries(itemDetails.reportedBy).forEach(([report, nefolositor]) => { %>
                                          <% Object.entries(nefolositor).forEach(([nefolositor2, eachReport]) => { %>
      
                                            <% if (eachReport.whichRoom == room._id && eachReport.userSessionId == userSession._id.toString()) { %> 
                                              <% avoidDuplicate_honor = false; %>
                                            <% } %>
                                            
                                            
                                          <% }); %>
                                        <% }); %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                              <% } else { %>
                              <% } %>
                            </div>
                            <div class="split">
                              <% if ( importHonorDetail && importHonorDetail.length > 0 && avoidDuplicate_honor === true) { %>
                                <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>

                                  <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                    <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                      <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                        <details class="reportingList">
                                          <summary class="reportItems"><%= Category %></summary>
                                          <ul>
                                            <% Object.entries(value).forEach(([sdfg, subCategory]) => { %>
                                              <!-- <li> subCategories:  item %>. It's details:  itemDetails.val %> -  itemDetails.report_title %> -  itemDetails.name %></li> -->
                                              <li>
                                                <form action="/room/report" method="POST" class="stretch">
                                                  <input type="hidden" name="whichRoom" value="<%= room._id %>">
                                                  <input type="hidden" name="whichReputationModel" value="honor">
                                                  <input type="hidden" name="userSession" value="<%= user._id %>">
                                                  <input type="hidden" name="whoIsReported" value="<%= guestUser._id %>">
                                                  <input type="hidden" name="mainCategory" value="<%= Category %>"> 
                                                  <input type="hidden" name="permanentReputationNumber" value="<%= subCategory.permanentReputationNumber %>">
                                                  <input type="hidden" name="displayRep" value="yes">
                                                  <input type="hidden" name="folder" value="<%= subCategory.type %>">
                                                  <input type="hidden" name="itemHeadTitle" value="<%= sdfg %>">
                                                  <button type="submit"> <%= subCategory.report_title %> </button>
                                                </form>
                                              </li>
                                            <% }); %>
                                          </ul>
                                        </details>
                                      <% } %>
                                    <% }); %>
                                  <% }); %>
                                  
                                <% }); %>
                              <% } %>
                            </div>
                          </div>
                          <p style="color: rgb(57, 150, 74); text-align: center;">Celebrate and acknowledge <br> the player’s positive impact <br> on the board games community.</p>
                        <% } else { %>
                          <h5 class="notForSelf">You cannot Honor yourself</h5>
                        <% } %>


                        <a class="closeSearch" href="#">X</a>
                      </div>



                      <div class="popup_feedback">
                        <% if ( guestUser._id.toString() !== userSession._id.toString() && isIdentical) { %>
                          <div class="whosThePlayer">
                            <div class="userIDOwner">
                              <div class="avatarImgOwner">
                                <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                              </div>
                              <div class="reputationBox">
                                <div class="honors">
                                  <div class="honor1">
                                    <img>
                                  </div>
                                  <div class="honor2">
                                    <img>
                                  </div>
                                </div>
                                <div class="redFlags">
                                  <div class="flag1">
                                    <img>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <p class="title">How was <br> your interaction <br> with <span><%= guestUser.yourName %></span>?</p>
                          </div>

                          <div>
                            <h3>Select a Feedback category:</h3>
                            <!-- Feedback  -->
                            <% let avoidDuplicate_feedback = true; %>
                            <div class="Verify_if_the_player_is_feedbacked">
                              <% if (guestUser.feedback) { %>
                                <% Object.entries(guestUser.feedback).forEach(([category, values]) => { %>
                                  <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                    <% if (["Vibe", "Environment", "Discrimination", "Hygiene"].includes(Categories)) { %>
                                      <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                        <% if (itemDetails.reportedBy && typeof itemDetails.reportedBy === 'object') { %>
                                          <% Object.entries(itemDetails.reportedBy).forEach(([report, nefolositor]) => { %>
                                            <% if (nefolositor && typeof nefolositor === 'object') { %>
                                              <% Object.entries(nefolositor).forEach(([nefolositor2, eachReport]) => { %>
                                                <% if (eachReport && eachReport.whichRoom == room._id && eachReport.userSessionId == userSession._id.toString()) { %>
                                                  <% avoidDuplicate_feedback = false; %>
                                                <% } %>
                                              <% }); %>
                                            <% } %>
                                          <% }); %>
                                        <% } %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                              <% } else { %>
                                
                              <% } %>
                            </div>
                            
                            <div class="split">
                              <% if ( importFeedbackDetail && importFeedbackDetail.length > 0 && avoidDuplicate_feedback === true) { %>
                                <% Object.entries(importFeedbackDetail).forEach(([nothing, nothing2]) => { %>

                                  <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                    <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                      <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                        <details class="reportingList">
                                          <summary class="reportItems"><%= Category %></summary> 
                                          <ul>
                                            <% Object.entries(value).forEach(([sdfg, subCategory]) => { %>
                                              <!-- <li> subCategories:  item %>. It's details:  itemDetails.val %> -  itemDetails.report_title %> -  itemDetails.name %></li> -->
                                              <li>
                                                <form action="/room/report" method="POST" class="stretch">
                                                  <input type="hidden" name="whichRoom" value="<%= room._id %>">
                                                  <input type="hidden" name="whichReputationModel" value="feedback">
                                                  <input type="hidden" name="userSession" value="<%= user._id %>">
                                                  <input type="hidden" name="whoIsReported" value="<%= guestUser._id %>">
                                                  <input type="hidden" name="mainCategory" value="<%= Category %>">
                                                  <input type="hidden" name="permanentReputationNumber" value="<%= subCategory.permanentReputationNumber %>">
                                                  <input type="hidden" name="displayRep" value="yes">
                                                  <input type="hidden" name="folder" value="<%= subCategory.type %>"> 
                                                  <input type="hidden" name="itemHeadTitle" value="<%= sdfg %>"> 
                                                  <button type="submit"><%= subCategory.report_title %></button>
                                                </form>
                                              </li>
                                            <% }); %>
                                          </ul>
                                        </details>
                                      <% } %>
                                    <% }); %>
                                  <% }); %>
                  
                                <% }); %>
                              <% } %>
                            </div>

                          </div>
                          <p style="color: rgb(84, 90, 0); text-align: center;">Give a constructive feedback to the player <br> if you found something <br> that they could improve</p>
                        <% } else { %>
                          <h5 class="notForSelf">You cannot Feedback yourself</h5>
                        <% } %>


                        <a class="closeSearch" href="#">X</a>
                      </div>



                      <div class="popup_stain">
                        <% if ( guestUser._id.toString() !== userSession._id.toString() && isIdentical) { %>
                          <div class="whosThePlayer">
                            <div class="userIDOwner">
                              <div class="avatarImgOwner">
                                <img class="profileGuest" src="/userImages/<%= guestUser.images %>">
                              </div>
                              <div class="reputationBox">
                                <div class="honors">
                                  <div class="honor1">
                                    <img>
                                  </div>
                                  <div class="honor2">
                                    <img>
                                  </div>
                                </div>
                                <div class="redFlags">
                                  <div class="flag1">
                                    <img>
                                  </div>
                                </div>
                              </div>
                            </div>
                            <p class="title">How was <br> your interaction <br> with <span><%= guestUser.yourName %></span>?</p>
                          </div>

                          <div>
                            <h3>Select a Stain category:</h3>
                            <!-- Stain  -->
                            <% let avoidDuplicate_stain = true; %>
                            <div class="Verify_if_the_player_is_stained">
                              <% if (guestUser.stain && avoidDuplicate_stain === true) { %>
                                <% Object.entries(guestUser.stain).forEach(([category, values]) => { %>
                                  <% Object.entries(values).forEach(([Categories, subCategories]) => { %>
                                    <% if (["Security", "Playing style" , "Environment", "Personality", "Good Manners", "Display"].includes(Categories)) { %>
                                      <% Object.entries(subCategories).forEach(([item, itemDetails]) => { %>
                                        <% Object.entries(itemDetails.reportedBy).forEach(([report, nefolositor]) => { %>
                                          <% Object.entries(nefolositor).forEach(([nefolositor2, eachReport]) => { %>
      
                                            <% if (eachReport.whichRoom == room._id && eachReport.userSessionId == userSession._id.toString()) { %> 
                                              <% avoidDuplicate_stain = false; %>
                                            <% } %>
                                            
                                          <% }); %>
                                        <% }); %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                              <% } else { %>
                              <% } %>
                            </div>

                            <div class="split">
                              <% if ( importStainDetail && importStainDetail.length > 0 && avoidDuplicate_stain === true) { %>
                                <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>

                                  <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                    <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                      <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                        <details class="reportingList">
                                          <summary class="reportItems"><%= Category %></summary>
                                          <ul>
                                            <% Object.entries(value).forEach(([sdfg, subCategory]) => { %>
                                              <!-- <li> subCategories:  item %>. It's details:  itemDetails.val %> -  itemDetails.report_title %> -  itemDetails.name %></li> -->
                                              <li>
                                                <form action="/room/report" method="POST" class="stretch">
                                                  <input type="hidden" name="whichRoom" value="<%= room._id %>">
                                                  <input type="hidden" name="whichReputationModel" value="stain">
                                                  <input type="hidden" name="userSession" value="<%= user._id %>">
                                                  <input type="hidden" name="whoIsReported" value="<%= guestUser._id %>">
                                                  <input type="hidden" name="mainCategory" value="<%= Category %>">
                                                  <input type="hidden" name="permanentReputationNumber" value="<%= subCategory.permanentReputationNumber %>">
                                                  <input type="hidden" name="folder" value="<%= subCategory.type %>">
