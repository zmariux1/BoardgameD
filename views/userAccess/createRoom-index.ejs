<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="img/title/titleIcon65.png">

    <link rel="stylesheet" href="css/createRoom-style.css">
    <link rel="stylesheet" href="css/elements/header.css">
    <link rel="stylesheet" href="css/elements/botNavBar.css">
    <link rel="stylesheet" href="css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

</head>
<body>
  <%- include('../layouts/header') %>



<div class="botPad">
  <div class="container">
    <div class="titleAndProgress__1">
      <h3>Select Board Games</h3>
      <div class="progress_All_div__1">
        <div class="progressLine_div__1">
          <hr class="progressLine__1"> 
        </div>
        <div class="InsideProgress__1 progress_boardgames_div__1">
          <p>Board Games</p>
        </div>
        <div class="progressLine_div__1">
          <hr class="progressLine__1"> 
        </div>
        <div class="InsideProgress__1 ">
          <p>Meeting Details</p>
        </div>
        <div class="progressLine_div__1">
          <hr class="progressLine__1"> 
        </div>
      </div>
    </div>
    <div class="titleAndProgress__2">
      <h3>Select the Invite's Details</h3>
      <div class="progress_All_div__2">
        <div class="progressLine_div__2">
          <hr class="progressLine__2"> 
        </div>
        <div class="InsideProgress__2 progress_boardgames_div__2">
          <p class="changeSectionBack">Board Games</p>
        </div>
        <div class="progressLine_div__2">
          <hr class="progressLine__2"> 
        </div>
        <div class="InsideProgress__2 progress_meetingDetails_div__2">
          <p>Meeting Details</p>
        </div>
        <div class="progressLine_div__2">
          <hr class="progressLine__2"> 
        </div>
      </div>
    </div>
    <div class="deeperSearchMsg">
      <h5 class="hiddenText activeText mobileNeverDisplay">Hint: Activate <i class="fa-solid fa-magnifying-glass-plus fa-sm"></i> to extend your search</h5>
      <h5 class="hiddenText mobileNeverDisplay">Note: The advanced search <i class="fa-solid fa-magnifying-glass-plus fa-sm"></i> takes 5 seconds for every 15 games found</h5>
    </div>
    <div class="fakeBox stretch-w ">
      <button class="customTriggerAdvanced"><i class="fa-solid fa-magnifying-glass-plus fa-lg"></i></button>
      <form action="/createRoom-index" method="post" class="form_SearchBg activeForm">
        <input type="search" name="simple_searchBg" class="input_searchBg" placeholder="Quick search"> 
        <button type="submit" class="btn_searchBg"><i class="custom_icon fa-solid fa-magnifying-glass search-icon"></i></button>
      </form>
      <form action="/createRoom-index" method="post" class="form_SearchBg advancedSearchForm">
        <input type="search" name="searchBg" class="input_searchBg" placeholder="Advanced search"> 
        <button type="submit" class="btn_searchBg"><i class="custom_icon fa-solid fa-magnifying-glass search-icon"></i></button>
      </form>
    </div>
    <div class="tab-content" >
      <section class="bgList_with_Submit__1">
        <div class="bgList_without_Submit_subSelect__1">
          <!-- Boardgames salvate  -->
          <% if (stored_results && stored_results.length > 0) { %>
            <% stored_results.forEach((game) => { %>
              <div class="existing_games">
                <form action="/createRoom-index" method="post" class="visible_game" >
                  <div class="aBoardgame__1">
                    <div class="sizeCap_div__1">
                      <a class="cancel_a_effects" href="https://boardgamegeek.com/boardgame/<%= game.objectid %>" target="_blank">
                        <img class="sizeCap__1" src="<%= game.thumbnail %>" alt="">
                      </a>
                    </div>
                    <div class="bg_names_div__1">
                      <p onclick="alreadyIn(this)">
                        <input type="hidden" name="userID" value="<%= user._id %>">
                        <input type="hidden" name="remove_game" value="remove_game">
                        <input type="hidden" class="hideMe boardgame-checkbox__1" id="theBoardgames_id" name="theBoardgames_id" value="<%= game.objectid %>">
                        <input type="hidden" class="hideMe autoCheckName" id="theBoardgames_name" name="theBoardgames_name" value="<%= game.name %>">
                        <input type="checkbox" class="condition_to_pass_checkbox hideMe" >
                        <span class="gameTitle boardgame_checked"><%= game.name %></span>
                      </p>
                    </div>
                  </div>
                </form>
                <form action="/createRoom-index" method="post" class="invisible_replacement_game">
                  <div class="aBoardgame__1">
                    <div class="sizeCap_div__1">
                      <a class="cancel_a_effects" href="https://boardgamegeek.com/boardgame/<%= game.objectid %>" target="_blank">
                        <img class="sizeCap__1" src="<%= game.thumbnail %>" alt="">
                      </a>
                    </div>
                    <div class="bg_names_div__1">
                      <p onclick="alreadyIn(this)">
                        <input type="hidden" name="userID" value="<%= user._id %>">
                        <input type="hidden" name="add_game" value="add_game">
                        <input type="hidden" class="hideMe boardgame-checkbox__1" id="theBoardgames_id" name="theBoardgames_id" value="<%= game.objectid %>">
                        <input type="hidden" class="hideMe autoCheckName" id="theBoardgames_name" name="theBoardgames_name" value="<%= game.name %>">
                        <input type="checkbox" class="condition_to_pass_checkbox hideMe" checked>
                        <span class="gameTitle "><%= game.name %></span>
                      </p>
                    </div>
                  </div>
                </form>
              </div>
              
            <% }); %>
          <% } else { %>
            <!-- <p>No board games found.</p> -->
          <% } %>

          <!-- boardgames noi si neselectate -->
          <% if (results && results.length > 0) { %>
            <% results.forEach((game) => { %>
              <% if (!stored_results || !stored_results.some(storedGame => storedGame.objectid === game.objectid)) { %>
                <div class="add_remove_game">
                  <form action="/createRoom-index" method="post" class="add_game">
                    <div class="aBoardgame__1">
                      <div class="sizeCap_div__1">
                        <a class="cancel_a_effects" href="https://boardgamegeek.com/boardgame/<%= game.objectid %>" target="_blank">
                          <img class="sizeCap__1" src="<%= game.thumbnail %>" alt="">
                        </a>
                      </div>
                      <div class="bg_names_div__1">
                        <p onclick="imported(this)">
                          <input type="hidden" name="userID" value="<%= user._id %>">
                          <input type="hidden" name="add_game"  value="add_game">
                          <input type="hidden" name="yearPublished" value="<%= game.yearPublished %>">
                          <input type="hidden" name="thumbnail" value="<%= game.thumbnail %>">
                          <input type="hidden" class="hideMe boardgame-checkbox__1" id="theBoardgames_id" name="theBoardgames_id" value="<%= game.objectid %>">
                          <input type="hidden" class="hideMe autoCheckName" id="theBoardgames_name" name="theBoardgames_name" value="<%= game.name %>">
                          <input type="checkbox" class="condition_to_pass_checkbox hideMe">
                          <span class="gameTitle"><%= game.name %></span>
                        </p>
                      </div>
                    </div>
                  </form>
                  <form action="/createRoom-index" method="post" class="remove_game">
                    <div class="aBoardgame__1">
                      <div class="sizeCap_div__1">
                        <a class="cancel_a_effects" href="https://boardgamegeek.com/boardgame/<%= game.objectid %>" target="_blank">
                          <img class="sizeCap__1" src="<%= game.thumbnail %>" alt="">
                        </a>
                      </div>
                      <div class="bg_names_div__1">
                        <p onclick="imported(this)">
                          <input type="hidden" name="userID" value="<%= user._id %>">
                          <input type="hidden" name="remove_game" value="remove_game">
                          <input type="hidden" class="hideMe boardgame-checkbox__1" id="theBoardgames_id" name="theBoardgames_id" value="<%= game.objectid %>">
                          <input type="hidden" class="hideMe autoCheckName" id="theBoardgames_name" name="theBoardgames_name" value="<%= game.name %>">
                          <input type="checkbox" class="condition_to_pass_checkbox hideMe">
                          <span class="gameTitle boardgame_checked"><%= game.name %></span>
                        </p>
                      </div>
                    </div>
                  </form>
                </div>
              <% } %>
            <% }); %>
          <% } else { %>
            <!-- <p>No board games found.</p> -->
          <% } %>

          <!-- Display pagination links -->
          <div class="pagination">
            <% if (currentPage && currentPage > 1) { %>
              <a href="/createRoom-index?page=<%= currentPage - 1 %>">&laquo; </a>
            <% } %>

            <!-- Display list of page numbers -->
            <% const startPage = Math.max(1, currentPage - 1); %>
            <% const endPage = Math.min(currentPage + 1, totalPages); %>
            
            <% if (startPage > 1) { %>
              <a href="/createRoom-index?page=1">1</a>
              <% if (startPage > 2) { %>
                <span>...</span>
              <% } %>

            <% } %>

            <% for (let i = startPage; i <= endPage; i++) { %>
              <% if (i === currentPage) { %>
                <span class="current-page"><%= i %></span>
              <% } else { %>
                <a href="/createRoom-index?page=<%= i %>"><%= i %></a>
              <% } %>
            <% } %>

            <% if (endPage < totalPages) { %>
              <% if (endPage < totalPages - 1) { %>
                <span>...</span>
              <% } %>
              <a href="/createRoom-index?page=<%= totalPages %>"><%= totalPages %></a>
            <% } %>

            <% if (currentPage < totalPages) { %>
              <a href="/createRoom-index?page=<%= currentPage + 1 %>"> &raquo;</a>
            <% } %>
          </div>

          


        </div>
        <button type="button" value="changeSection" class="changeSection submitButton__1">Next</button>
        
      </section>



