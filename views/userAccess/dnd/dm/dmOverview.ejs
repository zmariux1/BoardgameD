                                    >
                                        <input type="hidden" name="itemId" value="<%= pendingItem.id %>">
                                        <button
                                            class="pendingItem_delete"
                                            type="submit"
                                            name="action"
                                            value="removeItem"
                                            title="Remove item"
                                        >
