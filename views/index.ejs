<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>Document</title>
    <link rel="icon" href="img/title/titleIcon65.png">

    <link rel="stylesheet" href="css/mainPage-style.css">
    <link rel="stylesheet" href="css/elements/header.css">
    <link rel="stylesheet" href="css/elements/botNavBar.css">
    <link rel="stylesheet" href="css/elements/standardAll.css">
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>
  <div id="alertContainer" style="position: fixed; top: 0; left: 50%; transform: translateX(-50%); width: 300px; text-align: center;">
    <p id="inviteAlert" style="color: red;"></p>
  </div>
  <%- include('./layouts/header') %>




  <!-- Display list of page numbers -->
  <% const startPage = Math.max(1, currentPage - 1); %>
  <% const endPage = Math.min(currentPage + 2, totalPages); %>
  



  <div name="dosarRep">
    <% let groupedData_honer = []; %>
    <% let groupedData_stain = []; %>
  
    <% if (userPlus && userPlus.length > 0) { %>
      <% userPlus.forEach(data => { %>
        <% if (data.userLink.toString() == user._id.toString()) { %>
          
          <% data.allReputation.forEach(reputation => { %>
  
            <!-- match with honor  -->
            <% if (importHonorDetail && importHonorDetail.length > 0) { %>
              <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
  
                <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                  <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                    <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                      <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                          <% groupedData_honer.push(subCategory); %>
                        <% }; %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                <% }); %>
  
              <% }); %>
            <% } %>
  
            <!-- match with stain  -->
            <% if (importStainDetail && importStainDetail.length > 0) { %>
              <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
  
                <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                  <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                    <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                      <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                          <% groupedData_stain.push(subCategory); %>
                        <% }; %>
                      <% }); %>
                    <% } %>
                  <% }); %>
                <% }); %>
  
              <% }); %>
            <% } %>
  
  
          <% }); %>
        <% } %>
      <% }); %>
      
    <% } %>
  </div>

  <div id="content" class="container">
    <% if (userRooms && userRooms.length > 0) { %>
      <% userRooms.forEach(room => { %>
        <div class="roomBox">
          <div class="mainBox">
            <div class="mainBox-owner">
              
              <div class="mainBox-owner-top">
                <div class="userID">
                  <div class="avatarImg">
                    <img class="profileGuest" src="/userImages/<%= room.user.images %>">
                  </div>

                  <div name="dosarRep">
                    <% let groupedData_honer = []; %>
                    <% let groupedData_stain = []; %>
                  
                    <% if (userPlus && userPlus.length > 0) { %>
                      <% userPlus.forEach(data => { %>
                        <% if (data.userLink.toString() == room.user._id.toString()) { %>
                          
                          <% data.allReputation.forEach(reputation => { %>
                  
                            <!-- match with honor  -->
                            <% if (importHonorDetail && importHonorDetail.length > 0) { %>
                              <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
                  
                                <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                  <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                    <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                      <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                          <% groupedData_honer.push(subCategory); %>
                                        <% }; %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                  
                              <% }); %>
                            <% } %>
                  
                            <!-- match with stain  -->
                            <% if (importStainDetail && importStainDetail.length > 0) { %>
                              <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
                  
                                <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                  <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                    <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                      <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                        <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                          <% groupedData_stain.push(subCategory); %>
                                        <% }; %>
                                      <% }); %>
                                    <% } %>
                                  <% }); %>
                                <% }); %>
                  
                              <% }); %>
                            <% } %>
                  
                  
                          <% }); %>
                        <% } %>
                      <% }); %>
                      
                    <% } %>
                  </div>
                  <div class="reputationBox">
                    <div class="honors">
                      <% if (groupedData_honer && groupedData_honer.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_honer = groupedData_honer.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_honer.slice(0, 2).forEach(item => { %>
                          <div class="honor" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                    </div>
                    <div class="redFlags">
                      <% if (groupedData_stain && groupedData_stain.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_stain = groupedData_stain.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_stain.slice(0, 1).forEach(item => { %>
                          <div class="flag" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                    </div>
                  </div>
                </div>
                <div class="inviteDetails">
                  <p class="topSpaceText"><%= room.selectedDate %></p>
                  <p class="zeroSpaceText"><%= room.selectedTime %></p>
                  <p class="zeroSpaceText">Location: My home</p>
                  <p class="zeroSpaceText"><br> No. of players: <%= room.joined_guest.length %> / <%= room.numberOfInvites %></p>
                </div>
              </div>
              <div class="proposedGames">
                <ul class="SpaceRoomBoardgames">
                  <% room.theBoardgames_name.forEach(boardgame => { %>
                    <li class="SpaceRoomBoardgamesLi"><%= boardgame %></li>
                  <% }) %>
                </ul>
              </div>
            </div>
            <div class="join-div">
              <%
                let hasBennBanned = false;
                room.banned_players.forEach(banned_player => {
                    if (banned_player.toString() === user._id.toString()) {
                        hasBennBanned = true;
                    }
                });
              %>
              <form action="/index_append_joined_guest" method="post">
                <input type="hidden" name="userRoomId" value="<%= room._id %>">
                <input type="hidden" name="joined_guest" value="<%= user._id %>">
                <input type="hidden" name="selectedTime" value="<%= room.selectedTime %>">
                <input type="hidden" name="selectedDate" value="<%= room.selectedDate %>">
                <input type="hidden" name="theBoardgames_id" value="<%= room.theBoardgames_id %>">
                <input type="hidden" name="location" value="<%= room.location %>">
                <input type="hidden" name="numberOfInvites" value="<%= room.numberOfInvites %>">
                <input type="hidden" name="joined_guest_length" value="<%= room.joined_guest.length %>">
                <!-- Check if any ban has been given to the player  -->
                <% if (joinedGuestUsers && joinedGuestUsers[room._id]) { %>
                  <!-- Display user details -->
                  <% let foundMatchingUser = false; %>
                  <% joinedGuestUsers[room._id].forEach(user => { %>



                    <!-- Display other user details as needed -->
                    <% if ( !hasBennBanned && user._id.toString() == userSession._id.toString() ) { %>
                      <% foundMatchingUser = true; %>
                      <!-- Check if the user has already joined  -->

                        <button type="submit" id="buttonX" value="add an user" class="joinRoomButton"> Enter the invite</button>

                    <% } else if ( !hasBennBanned && !foundMatchingUser &&  room.joined_guest.length  < room.numberOfInvites) { %>
                      <!-- Check if the user did not join previously and if there is still space to join -->
                      
                      <button type="submit" id="buttonX" value="add an user" class="joinRoomButton"> Join the invite</button>
                    <% } else if ( hasBennBanned ) { %>
                      <!-- Check if any ban has been given to the player  -->
                      <div class="restrictedAccess">
                        <p>Restricted access</p>
                      </div>
                      
                    <% } else { %>

                    <% } %>
              
                    
                  <% }) %>
                <% } else { %>
                  <p>Server is down for the moment</p>
                <% } %>
              </form>
            </div>
            
            <div id="resizableDiv" class="mainBox-participants">
              

            <!-- Check if joinedGuestUsers contains data for the current room ID -->
            <% if (joinedGuestUsers && joinedGuestUsers[room._id]) { %>
              <!-- Display user details -->
              <% joinedGuestUsers[room._id].forEach(roomUser => { %>

                <div name="dosarRep">
                  <% let groupedData_honer_guest = []; %>
                  <% let groupedData_stain_guest = []; %>
              
                  <% if (userPlus && userPlus.length > 0) { %>
                    <% userPlus.forEach(data => { %>
                      <% if (data.userLink.toString() == roomUser._id.toString()) { %>
                        
                        <% data.allReputation.forEach(reputation => { %>
              
                          <!-- match with honor  -->
                          <% if (importHonorDetail && importHonorDetail.length > 0) { %>
                            <% Object.entries(importHonorDetail).forEach(([nothing, nothing2]) => { %>
              
                              <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                  <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                    <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                      <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                        <% groupedData_honer_guest.push(subCategory); %>
                                      <% }; %>
                                    <% }); %>
                                  <% } %>
                                <% }); %>
                              <% }); %>
              
                            <% }); %>
                          <% } %>
              
                          <!-- match with stain  -->
                          <% if (importStainDetail && importStainDetail.length > 0) { %>
                            <% Object.entries(importStainDetail).forEach(([nothing, nothing2]) => { %>
              
                              <% Object.entries(nothing2).forEach(([stillNothing, stillNothing2]) => { %>
                                <% Object.entries(stillNothing2).forEach(([Category, value]) => { %>
                                  <% if (Category !== '_id' && Category !== '__v' && Category !== 'skipId' && Category !== 'activePaths') { %>
                                    <% Object.entries(value).forEach(([sdfg, subCategory]) => { %> 
                                      <% if (subCategory.permanentReputationNumber == reputation.get_permanentReputationNumber) { %>
                                        <% groupedData_stain_guest.push(subCategory); %>
                                      <% }; %>
                                    <% }); %>
                                  <% } %>
                                <% }); %>
                              <% }); %>
              
                            <% }); %>
                          <% } %>
              
              
                        <% }); %>
                      <% } %>
                    <% }); %>
                    
                  <% } %>
                </div>



                

                <!-- Display other user details as needed -->
                <a href="/userProfile/<%= roomUser._id %>" class="userID">
                  <div class="avatarImg">
                    <img class="profileGuest" src="/userImages/<%= roomUser.images %>">
                  </div>
                  <div class="reputationBox">
                    <div class="honors">
                      <% if (groupedData_honer_guest && groupedData_honer_guest.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_honer_guest = groupedData_honer_guest.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_honer_guest.slice(0, 2).forEach(item => { %>
                          <div class="honor" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                    </div>
                    <div class="redFlags">
                      <% if (groupedData_stain_guest && groupedData_stain_guest.length > 0) { %>
                        <!-- Shuffle the badReputation array -->
                        <% const owner_shuffled_stain_guest = groupedData_stain_guest.sort(() => Math.random() - 0.5); %>
                        <% owner_shuffled_stain_guest.slice(0, 1).forEach(item => { %>
                          <div class="flag" title="<%= item.description %>">
                            <img src="/img/reputation/<%= item.type %>/<%= item.fileCateg %>/<%= item.name %>" class="repProfileIcon">
                          </div>
                        <% }) %>
                      <% } %>
                    </div>
                  </div>
                </a>
                
              <% }) %>
            <% } else { %>
              <p>No user data found for this room</p>
            <% } %>





<!-- sa-io scriu sa mi faca userID pe baza la ce am facut in the room -->







            </div>
            <button id="buttonX" class="turnPageButton"> <i class="fa-solid fa-angle-down fa-xl"></i></button>
          </div>
          <div class="sideBoxPics">
            
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No available invites</p>
    <% } %>

  </div> 

  <div id="loadingPopup" class="loading-popup">
    <div id="countdown" class="countdown"></div>
  </div>

  <!-- Display pagination links -->
  <div class="pagination insertBotMargin fix_pagination">
    <a
      class="pagination__dnd-link"
      href="/<%= userSession._id %>/dnd"
      aria-label="Deschide D&D"
      title="Deschide D&D"
    ></a>
    <% if (currentPage > 1) { %>
      <a href="/index?page=<%= currentPage - 1 %>">&laquo; </a>
    <% } %>

    <!-- Display list of page numbers -->

    
    <% if (startPage > 1) { %>
      <a href="/index?page=1">1</a>
      <% if (startPage > 2) { %>
        <span>...</span>
      <% } %>

    <% } %>

    <% for (let i = startPage; i <= endPage; i++) { %>
      <% if (i === currentPage) { %>
        <span class="current-page"><%= i %></span>
      <% } else { %>
        <a href="/index?page=<%= i %>"><%= i %></a>
      <% } %>
    <% } %>

    <% if (endPage < totalPages) { %>
      <% if (endPage < totalPages - 1) { %>
        <span>...</span>
      <% } %>
      <a href="/index?page=<%= totalPages %>"><%= totalPages %></a>
    <% } %>

    <% if (currentPage < totalPages) { %>
      <a href="/index?page=<%= currentPage + 1 %>"> &raquo;</a>
    <% } %>
  </div>

  
  <!-- Bottom bar  -->
  <div class="bottom-bar">
    <ion-icon name="person-outline" class="icon" 
    onclick="change(this); window.location.href='/userProfile/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="folder-outline" class="icon" 
    onclick="change(this); window.location.href='/preRoom-index/<%= userSession._id %>'">
    </ion-icon>
    <ion-icon name="home-outline" class="icon activeBar" 
    onclick="change(this); window.location.href='/index'">
    </ion-icon>
    <ion-icon name="add-circle-outline" class="icon longLoading" 
    onclick="change(this); window.location.href='/createRoom-index'" >
    </ion-icon>
    <!-- <ion-icon name="image-outline" class="icon" 
    onclick="change(this); window.location.href='/gallery'">
    </ion-icon> -->
    <div class="titleNav_div">
      <!-- <p class="titleNav">N a v i g a t i o n &nbsp; B a r</p> -->
    </div>
  </div>




  <script src="https://kit.fontawesome.com/19568ad9a4.js" crossorigin="anonymous"></script>
  <script src="js/mainPage-script.js"></script>
  <script></script>
  <script src="js/header.js"></script>
</body>
</html>