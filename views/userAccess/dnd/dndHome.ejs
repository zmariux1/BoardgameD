<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/css/dnd/char/myCharList.css">
    <script
        type="module"
        src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
</head>
<body>
    <div class="characters-page">
        <header class="characters-navbar">
            <div class="characters-navbar__inner">
                <a
                    href="/<%= userId %>/dnd"
                    class="characters-navbar__logo"
                    aria-label="D&D Home"
                >
                    <span class="characters-navbar__logo-symbol" aria-hidden="true">◈</span>
                </a>

                <nav class="characters-navbar__nav" aria-label="Navigare principală">
                    <a href="/index" class="characters-navbar__link characters-navbar__link--active">
                        <span class="characters-navbar__link-icon" aria-hidden="true">⌂</span>
                        <span>Exit D&D</span>
                    </a>
                    <a href="/<%= userId %>/dnd" class="characters-navbar__link characters-navbar__link--active">
                        <span class="characters-navbar__link-icon" aria-hidden="true">⌂</span>
                        <span>D&D Home</span>
                    </a>
                    <a href="/<%= userId %>/dnd/myChars" class="characters-navbar__link">
                        <span class="characters-navbar__link-icon" aria-hidden="true">◈</span>
                        <span>Characters</span>
                    </a>
                    <a href="/<%= userId %>/dnd/globalCampaigns" class="characters-navbar__link">
                        <span class="characters-navbar__link-icon" aria-hidden="true">⚑</span>
                        <span>GlobalCampaigns</span>
                    </a>
                    <a href="/<%= userId %>/dnd/myCampaigns" class="characters-navbar__link">
                        <span class="characters-navbar__link-icon" aria-hidden="true">⚔</span>
                        <span>My DM Campaigns</span>
                    </a>
                </nav>

                <a href="/editProfile" class="characters-navbar__user" aria-label="Profilul utilizatorului">
                    <div class="characters-navbar__avatar">
                        <img src="/images/user-avatar.jpg" alt="">
                    </div>
                    <span class="characters-navbar__user-arrow" aria-hidden="true">⌄</span>
                </a>

                <button
                    type="button"
                    class="characters-navbar__mobile-toggle"
                    id="charactersMobileToggle"
                    aria-label="Deschide navigarea"
                    aria-expanded="false"
                    aria-controls="charactersMobileNav"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>

            <nav class="characters-navbar__mobile" id="charactersMobileNav" aria-label="Navigare mobilă">
                <a href="/index">Exit D&D</a>
                <a href="/<%= userId %>/dnd" class="characters-navbar__mobile-link--active">D&D Home</a>
                <a href="/<%= userId %>/dnd/myChars">My Chars</a>
                <a href="/<%= userId %>/dnd/globalCampaigns">Global Campaigns</a>
                <a href="/<%= userId %>/dnd/myCampaigns">My DM Campaigns</a>
                <a href="/editProfile">Profile</a>
            </nav>
        </header>

        <main class="characters-main">
            <section class="characters-heading">
                <div class="characters-heading__title-area">
                    <h1 class="characters-heading__title">Your adventure begins here</h1>
                    <div class="characters-heading__ornament" aria-hidden="true">
                        <span class="characters-heading__ornament-line"></span>
                        <span class="characters-heading__ornament-diamond">◆</span>
                        <span class="characters-heading__ornament-line"></span>
                    </div>
                    <p class="dnd-home-intro">
                        Every world begins with a whispered rumour, every hero with a single choice, 
                        and every story with a door waiting to be opened. Step inside and let's hear the story.
                    </p>
                </div>
            </section>

            <section class="characters-grid" aria-label="Destinații D&D">
                <article class="character-card">
                    <a class="character-card__info" href="/<%= userId %>/dnd/myChars">
                        <div class="character-card__background" aria-hidden="true"></div>
                        <div class="character-card__overlay" aria-hidden="true"></div>
                        <div class="character-card__content">
                            <div class="character-card_divider_top">
                                <div class="character-card__avatar" aria-hidden="true">
                                    <!-- ◈ -->
                                    <img src="/img/dnd/mainPage/Chars2m.png">
                                </div>
                                <div class="cardIdentity">
                                    <h2 class="character-card__name">My Chars</h2>
                                    <div class="character-card__level">Check out all your Chars</div>
                                </div>
                            </div>
                            <div class="character-card__divider"></div>
                            <div class="character-card_divider_bot">
                                <div class="character-card__attribute">
                                    <span class="character-card__attribute-icon" aria-hidden="true">✦</span>
                                    <span class="character-card__attribute-text">X Chars Available</span>
                                </div>
                                <div class="character-card__attribute">
                                    <span class="character-card__attribute-icon" aria-hidden="true">⚔</span>
                                    <span class="character-card__attribute-text">You have unlimited Chars to build available</span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="character-card__actions">
                        <a href="/<%= userId %>/dnd/myChars" class="character-action character-action--view">
                            <span class="character-action__icon" aria-hidden="true">◈</span>
                            <span class="character-action__label">Open</span>
                        </a>
                    </div>
                </article>

                <article class="character-card">
                    <a class="character-card__info" href="/<%= userId %>/dnd/globalCampaigns">
                        <div class="character-card__background" aria-hidden="true"></div>
                        <div class="character-card__overlay" aria-hidden="true"></div>
                        <div class="character-card__content">
                            <div class="character-card_divider_top">
                                <div class="character-card__avatar" aria-hidden="true">
                                    <!-- ⚑ -->
                                    <img src="/img/dnd/mainPage/global2m.png">
                                </div>
                                <div class="cardIdentity">
                                    <h2 class="character-card__name">Global Campaigns</h2>
                                    <div class="character-card__level">Public Campaigns Available</div>
                                </div>
                            </div>
                            <div class="character-card__divider"></div>
                            <div class="character-card_divider_bot">
                                <div class="character-card__attribute">
                                    <span class="character-card__attribute-icon" aria-hidden="true">⌕</span>
                                    <span class="character-card__attribute-text">Discover existing campaigns</span>
                                </div>
                                <div class="character-card__attribute">
                                    <span class="character-card__attribute-icon" aria-hidden="true">✧</span>
                                    <span class="character-card__attribute-text">Choose your next story</span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="character-card__actions">
                        <a href="/<%= userId %>/dnd/globalCampaigns" class="character-action character-action--view">
                            <span class="character-action__icon" aria-hidden="true">⚑</span>
                            <span class="character-action__label">Open</span>
                        </a>
                    </div>
                </article>

                <article class="character-card">
                    <a class="character-card__info" href="/<%= userId %>/dnd/myCampaigns">
                        <div class="character-card__background" aria-hidden="true"></div>
                        <div class="character-card__overlay" aria-hidden="true"></div>
                        <div class="character-card__content">
                            <div class="character-card_divider_top">
                                <div class="character-card__avatar" aria-hidden="true">
                                    <!-- ⚔ -->
                                    <img src="/img/dnd/mainPage/DMm.png">
                                </div>
                                <div class="cardIdentity">
                                    <h2 class="character-card__name">My Campaigns</h2>
                                    <div class="character-card__level">Your Worlds</div>
                                </div>
                            </div>
                            <div class="character-card__divider"></div>
                            <div class="character-card_divider_bot">
                                <div class="character-card__attribute">
                                    <span class="character-card__attribute-icon" aria-hidden="true">⚑</span>
                                    <span class="character-card__attribute-text">Manage the created campaigns</span>
                                </div>
                                <div class="character-card__attribute">
                                    <span class="character-card__attribute-icon" aria-hidden="true">✦</span>
                                    <span class="character-card__attribute-text">Join an existing campaign</span>
                                </div>
                            </div>
                        </div>
                    </a>
                    <div class="character-card__actions">
                        <a href="/<%= userId %>/dnd/myCampaigns" class="character-action character-action--view">
                            <span class="character-action__icon" aria-hidden="true">⚔</span>
                            <span class="character-action__label">Open</span>
                        </a>
                    </div>
                </article>
            </section>
        </main>
    </div>

    <script src="/js/dnd/MyCharList_script.js"></script>
</body>
</html>
