<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login / Signup Page</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-image: -webkit-linear-gradient(-65deg, rgb(228, 133, 134) 50%, rgb(252, 186, 173) 50%);
            margin: 0;
            padding: 0;
            height: 100vh;
            position: relative;
        }

        :root {
  --bodyC: #F8F6F0;
  --headerC: linear-gradient(135deg, rgb(145, 109, 179), rgb(253, 229, 236));
  --Buttons: linear-gradient(135deg, purple, #333);
  --theOwnerC: #F5F5F5;
  --casete: #49413F;
  --participantsC: linear-gradient(165deg, black, #333);
  --inviteDetailsC: linear-gradient(135deg, #000, #333);;

}

header{
  background: var(--headerC);
  display: flex;
  justify-content: space-around;
  height: 50px;
  align-items: center;
  z-index: 109;
  position: relative;
}


.locationButton{
  border-radius: 20%;
  background: var(--theOwnerC);
}

.searchLocation{
  width: 130px;
  min-width: 130px;
  background: var(--theOwnerC);

}

.the_account_in_header{
  display: flex;
  flex-direction: row;
}
.account_connected{
  text-align: center; 
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
  gap: 5px;
}
.header_div_pic{
  width: 40px; 
  
}

.header_pic{
  width: 100%; 
}
.header_username{
  display: block;
}

.usersetting{
  display: none;
}

.logout{
  
}

.header_user_div_text{
  width: 100px;
  text-align: start;
}

.header_user_div_text:hover .header_username {
  display: none;
}
.header_user_div_text:hover .usersetting {
  display: block;
}


.account_not_connected{
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.paragraph0{
  margin: 0px;
}

.div-icon-recentGames{
  width: 140px;
  text-align: center;
}



.sidebarRecentGames {
  position: fixed;
  top: -100%; /* Start with the sidebar above the viewport */
  left: 0;
  width: 360px;
  height: 400px;
  max-height: 401px;
  background-color: grey;
  box-shadow: 0 0 2rem;
  z-index: 110;
  transition: top 0.5s ease; /* Apply transition to the top property */
  border-bottom-right-radius: 50%;
}

.showMeTrigger {
  top: 50px; /* Slide the sidebar down to appear below the header */
  width: 360px;
  height: 670px;
  max-height: 675px;
  border-radius: 0;
}

.languages_div{
  display: flex;
  flex-direction: column;
  align-items: center;
  position: absolute;
  right: 5px;
}

.lang_icon{
  width: 25px;
  transition: 0.2s ease;
}

.lang_icon:hover{
  transition: 0.2s ease;
  background: #00000023;
  border-radius: 4px;
}




        .container {
          position: absolute;
          top: 50%;
          left: 50%;
          transform: translate(-50%, -50%);
          background-color: rgb(253, 229, 236);
          border-radius: 5px;
          box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
          text-align: center;
          padding: 20px;
          width: 320px;
        }

        h1 {
            font-size: 24px;
        }

        .tabs {
            display: flex;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .tab {
            flex-grow: 1;
            cursor: pointer;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px 5px 0 0;
        }

        .tab.active {
            background-color: #007bff;
            color: #fff;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .register_div{
          margin-bottom: 13px;
          height: 162px;
          display: flex;
          flex-direction: column;
          justify-content: center;
          align-items: center;
        }

.tab-content  .email,
.tab-content  .confirmPassword {
    width: 90%;
    padding: 10px;
    margin: 0px 0;
    border: 1px solid #ccc;
    border-radius: 0px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

.tab-content  .userName,
.tab-content  .password {
    width: 90%;
    padding: 10px;
    margin: 0px 0;
    border: 1px solid #ccc;
    border-radius: 0px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    margin-bottom: 7px;
}


        button {
            background-color: #007bff;
            color: #fff;
            border: none;
            border-radius: 5px;
            padding: 10px 20px;
            cursor: pointer;
            font-size: 16px;
        }

        button:hover {
            background-color: #0056b3;
        }

        .switch {
            margin-top: 10px;
        }

        .switch a {
            text-decoration: none;
            color: #007bff;
        }

        .switch a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
  <header class="navBar">
    <div class="div-icon-recentGames">
      <button id="toggleButton"> <i class="fa-solid fa-star"></i> </button>
      
    </div>
    <div> 
      <form>
        <input type="text" name="search" class="searchLocation" placeholder=" Search your area &#x1F50D;">
      </form>
    </div>
    <div class="the_account_in_header">
      <div class="account_connected"> 
        <div class="header_div_pic">
            <img class="header_pic" src="/public/img/user/profileGuest.png" alt="">
        </div>
        <div class="header_user_div_text">
            <p class="header_username paragraph0">Marius</p>
            <a href="/account" class="usersetting paragraph0">Account</a>
            <a href="/logout" class="logout paragraph0">Logout</a>
        </div>
      </div>
    
      <div class="account_not_connected"> 
          <a href="/login" class="login paragraph0">Login</a>
          <a href="/signup" class="signup paragraph0">Signup</a>
      </div>
    </div>
  </header>


  <div class="container">
    <h1>Login</h1>
    <div class="tab-content active" id="loginContent">

      <!-- activate random sequance data recoltation  -->
      <form action="/data" method="post" class="">
        <hr>
        <label for="slot-500">slot-500</label>
        <input type="radio" name="formRangeValue" value="1" id="slot-500">
        <br> <br>

        <label for="slot-1000">slot-1000</label>
        <input type="radio" name="formRangeValue" value="2" id="slot-1000">
        <br> <br>

        <label for="slot-1500">slot-1500</label>
        <input type="radio" name="formRangeValue" value="3" id="slot-1500">
        <br> <br>

        <label for="slot-2000">slot-2000</label>
        <input type="radio" name="formRangeValue" value="4" id="slot-2000">
        <br> <br>

        <hr>
        <label for="slot-2500">slot-2500</label>
        <input type="radio" name="formRangeValue" value="5" id="slot-2500">
        <br> <br>

        <label for="slot-3000">slot-3000</label>
        <input type="radio" name="formRangeValue" value="6" id="slot-3000">
        <br> <br>

        
        <label for="slot-3500">slot-3500</label>
        <input type="radio" name="formRangeValue" value="7" id="slot-3500">
        <br> <br>

        <label for="slot-4000">slot-4000</label>
        <input type="radio" name="formRangeValue" value="8" id="slot-4000">
        <br> <br>

        <hr>
        <label for="slot-4500">slot-4500</label>
        <input type="radio" name="formRangeValue" value="9" id="slot-4500">
        <br> <br>

        <label for="slot-5000">slot-5000</label>
        <input type="radio" name="formRangeValue" value="0" id="slot-5000">
        <br> <br>


        <label for="slot-5500">slot-5500</label>
        <input type="radio" name="formRangeValue" value="11" id="slot-5500">
        <br> <br>

        <label for="slot-6000">slot-6000</label>
        <input type="radio" name="formRangeValue" value="12" id="slot-6000">
        <br> <br>

        <hr>
        <label for="slot-6500">slot-6500</label>
        <input type="radio" name="formRangeValue" value="13" id="slot-6500">
        <br> <br>

        <label for="slot-7000">slot-7000</label>
        <input type="radio" name="formRangeValue" value="14" id="slot-7000">
        <br> <br>

        <hr>
        <button type="submit">Populate</button>

      </form>
    </div>

    <div class="switch">
      
      
    </div>
  </div>


</body>
</html>
